/*
 * 中兴 ZXHN F7615MV3（中国移动定制光猫，SoC 中兴微 ZX279133）。板级事实取自本机原厂运行时设备树（/sys/firmware/fdt，2026-11-26 只读取证）。
 * 从原厂系统 kexec 进来、只在内存里跑：开串口、USB、看门狗、GPIO 与 LAN 网口（NPPT + 内建 9132 交换），板载闪存不碰。
 * 行号引用：runtime-dts = captures/20261126-runtime-facts/f7615mv3-runtime.dts；facts = captures/20261126-usb-busybox/F7615MV3-facts.txt（原厂 5.4.196 的启动日志与运行期读数，原件只留磁盘，grep 要加 -a）。
 */
/dts-v1/;

#include "zx279133.dtsi"

/ {
	model = "ZTE ZXHN F7615MV3";
	compatible = "zte,f7615mv3", "zte,zx279133";

	aliases {
		serial0 = &uart0;
		watchdog0 = &watchdog0;
		watchdog1 = &watchdog1;
	};

	chosen {
		/* earlycon 用中兴寄存器布局的 zteuart（补丁 220），不能用按标准 PL011 布局写的 pl011 */
		bootargs = "console=ttyAMA0,115200 earlycon=zteuart,mmio32,0x10d0d000";
		stdout-path = "serial0:115200n8";
	};

	/* DDR 512 MiB 从 0x80000000 起，这里只给到 0x97a00000：原厂内核运行期把 0x97a00000 以上几乎整段留给 NP、Wi-Fi、加密引擎的缓冲（原厂 memblock 保留图），kexec 交接后原厂驱动的 DMA 可能还在往那里写。 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x17a00000>;
	};

	/*
	 * NP 的三块 DMA 区照原厂内核的划分（facts:1819–1824，`zte13x ... reserve memory 98800000/7800000` 之下的分段）：idm 0x98800000 起 0x1800000、sehash 0x9a000000 起 0x1000000、bmu 0x9b200000 起 0x1c00000。
	 * 它们在上面 memory 节点之外（不进线性映射、不归页分配器），驱动以 devm_ioremap_wc 映射；kexec 交接时原厂 NP 若还有 DMA 在飞，落点就是我们接着要重新初始化的这三块，而不是本内核的内存。
	 * 大小都满足驱动的下限：BMU 要 0x101e000、SE hash 恰好 0x1000000 且 4 KiB 对齐、IDM 要 0x2e0000（zx279133.h 的 *_REQUIRED_SIZE）。原厂另有 seddr 0x9b000000 起 0x200000，本驱动不用。
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		idm_reserved: buffer@98800000 {
			reg = <0x0 0x98800000 0x0 0x1800000>;
			no-map;
		};

		se_hash_reserved: buffer@9a000000 {
			reg = <0x0 0x9a000000 0x0 0x1000000>;
			no-map;
		};

		bmu_reserved: buffer@9b200000 {
			reg = <0x0 0x9b200000 0x0 0x1c00000>;
			no-map;
		};
	};
};

/*
 * CPU 调频档位照原厂运行时设备树的 opp_table0：最高 1.3 GHz，1.1–1.3 GHz 标 turbo-mode，500 MHz 是挂起档；dtsi 多出的 1.4 GHz/881 mV 原厂没有，删掉。
 * 688 MHz 一档沿用 dtsi 的 688128000（1376.256 MHz 二分频的实际频率），原厂表写的是标称值 688000000，电压同为 850 mV。
 */
&cpu_opp_table {
	/delete-node/ opp-1400000000;

	opp-500000000 {
		opp-suspend;
	};

	opp-1100000000 {
		turbo-mode;
	};

	opp-1200000000 {
		turbo-mode;
	};

	opp-1300000000 {
		turbo-mode;
	};
};

/* 原厂控制台：PL011 @0x10d0d000，115200 8n1 */
&uart0 {
	status = "okay";
};

/* 原厂两颗看门狗都开着（复位路由 0x10e10208 的 0x10、0x20 位），kexec 交接后照样在数：两颗都启用，驱动 probe 起就由内核喂狗，用户态起来后 procd 只接管 watchdog0，watchdog1 一直由内核喂。 */
&watchdog0 {
	status = "okay";
};

&watchdog1 {
	status = "okay";
};

/* 原厂两个 xHCI 都启用；面板 USB 口在 0x15010000 下（原厂总线 3-1），0x15008000 的口在板上接到哪里未知，一并打开。 */
&usb0 {
	status = "okay";
};

&usb1 {
	status = "okay";
};

/* SPI-NAND 控制器与闪存节点都保持关闭：U 盘测试期不碰板载闪存。dtsi 里的分区表是 SR1010 的，与本机实测分区无关，删掉免得误用；以后启用时按本机 /proc/mtd 实测的分区另写。 */
&spifc {
	status = "disabled";

	flash@0 {
		status = "disabled";
		/delete-node/ partitions;
	};
};

/*
 * LAN 数据面：NPPT（PON 侧 MAC、IDM/BMU/TM 与 PPU 微码）+ 内建 9132 交换（DSA，CPU 口经 XMAC0 车道上的 LAN conduit）。
 * 拓扑与端口号照创维 SK-D840N 的板级文件（woodnaonly/zx279133-ponwrt-build kernel-overlays/arch/arm64/boot/dts/zte/zx279133-sk-d840n.dts，同 SoC、同样 3 个千兆口 + 1 个 2.5G 口），本机原厂启动日志与之一致的地方：
 *   - 原厂四个 LAN 网口 eth0=uni4、eth1..3=uni1..3（facts:2357–2360），交换机 `unicnt 4, wancnt 1, all ports 5, portmask 0x9e`（facts:2624，bit 0 不在，9132 的 0 号口不接面板）；
 *   - 限速表里 port 4 为 2.5 Gbps、port 1..3 为 1 Gbps（facts:2679–2686）：千兆口是 uni1..3，2.5G 口是 uni4（外置 Realtek 8226B，原厂 `xmac0 type rlt8226`，facts:2398）；
 *   - SK-D840N 的 U-Boot 同样只报 mac 1/2/4 的链路、mac 0 恒 down（其 docs/07 补七十），与本机 `mac 1..3 link down`、`mac 4 phy status changed`（facts:2408–2410、2702）同一套编号。
 * 面板丝印与 lanN 的对应未与原厂核对：按原厂 ethN 与面板 LAN(N+1) 的惯例推断 lan1 = 2.5G 口、lan2..4 = 千兆口（iTV、千兆口3、千兆口4 的次序待插线核对）。
 */
&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";
};

&pon_serdes {
	status = "okay";
};

&uni_serdes {
	status = "okay";
};

&xpcs0 {
	status = "okay";
};

&xpcs1 {
	status = "okay";
};

&nppt {
	/* PON 侧 MAC（XMAC1 + PON SerDes + XPCS1）跑 SGMII，取值照 SK-D840N：Uni SerDes 与 XPCS0 归 9132 交换驱动（它的 CPU 口车道），NPPT 用 PON SerDes（驱动收 SGMII/2.5GBASE-X）；本机原厂把 PON SerDes 配成 XG-PON（facts `mode_xgpon_nsyn_cfg`），这里不接 PON，未与原厂核对 */
	phy-mode = "sgmii";
	memory-region = <&bmu_reserved>, <&se_hash_reserved>, <&idm_reserved>;
	memory-region-names = "bmu", "se-hash", "idm";
	/*
	 * MAC 地址（临时规避，见 docs/TASKS.md「临时规避：LAN MAC 写死在设备树」）：原厂的 8 个 MAC 在 parameter tags 分区（mtd3，JFFS2）里的文件 paramtag 中，TAGH0201 格式、tag 0x0100..0x0107 各 6 字节，依次是 80:88:00:c0:73:22..29，LAN 侧用第一个（facts:2688 的 `set dmac [0]`）；本内核不开 SPI-NAND，读不到，先写一个本地管理地址：原厂第一个 MAC 的首字节置 U/L 位（0x80 → 0x82）。
	 * NPPT 把这个地址写进 9132 的 SPA 作 CPU 收帧的目的 MAC（zx279133-np.c 的 zx279133_program_spa_cpu_mac）；conduit 注册时复制 NPPT 的地址（zx279133-netdev.c 的 eth_hw_addr_set(ndev, eth->ndev->dev_addr)，conduit 节点只在有 nvmem-cells 时才自己读），DSA 口与 br-lan 建立时再沿用 conduit 的。
	 */
	local-mac-address = [82 88 00 c0 73 22];
	/*
	 * 9132 的内部 GE PHY 在 MDIO0 的 0x0a..0x0d（原厂运行时设备树两个 MDIO 节点的 uni-phy，runtime-dts:1291、1302；实机读到 ID 84b9:5032）。
	 * 外置 2.5G PHY（RTL8226 一族）也在 MDIO0、地址 1，与 SK-D840N（MDIO1、地址 5）不同：
	 *   - 总线：原厂 bspdriver.ko 的 mdio_setup() 按 get_10g_mdio_sel() 选 10G PHY 的 MDIO 函数，为 0 时用 zx_mdio_0_*，本机打印 `mdio_sel==========0`（facts:2295），MDIO id 0 就是 0x14f01000（facts:1983）；SK-D840N 的原厂设备树有 pon_plat/mdio_8226_id = <1>，本机原厂设备树的 pon_plat 没有这一项。
	 *   - 地址：原厂 `xmac0 type rlt8226 ,xmac_phy_id[0]  1`（facts:2398）；plat_132.ko 的 phy_rlt8226_set_enable() 以 xmac_phy_id[xmac] 作 PHY 地址，rlt8226b.ko 初始化时用的 PHY 地址（模块 .data+4）也是 1。
	 * 第一次实机（2026-11-27 03:43）按 MDIO1 地址 5 访问，全读成 0x0000；驱动（补丁 397）probe 时会把两条 MDIO 的 0..31 都扫一遍写进 dmesg，以实测为准。
	 */
	zx279133,uni-phy-bus = <&mdio0>;
	zx279133,outer-phy-bus = <&mdio0>;
	zx279133,outer-phy-addr = <1>;
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};

	/* 9132 CPU 口上的 conduit（DSA 的 CPU 侧 netdev lan-cpu0），MAC 随 NPPT */
	lan_cpu: ethernet-lan-cpu {
		compatible = "zte,zx279133-lan-conduit";
	};

	switch {
		compatible = "zte,zx279133-switch";

		/*
		 * DSA 口号 = 9132 的 PPU 口号 + 3 = 原厂交换口号（facts 的 uniN、mac N）+ 4，传输 VID = 55 + DSA 口号（tagger 与 NPPT 驱动的同一套编号）。四个内部 PHY 口没有 PHY 驱动可绑（ID 0x84b9:0x5032 无匹配），照 SK-D840N 用 fixed-link：软件看到的链路恒为 1G 全双工，实际链路由 9132 自己读 PHY 决定。
		 * lan1 的外置 PHY 不在本树声明（SK-D840N 实测：phylib 一绑上 realtek 驱动就改写它的 SerDes 选项），驱动按上面的 zx279133,outer-phy-bus 与 zx279133,outer-phy-addr 直接读写。
		 */
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* 原厂交换口 0（PPU 口 1，PHY 0x0a）：本机面板不接（portmask 0x9e 不含 bit 0），照 SK-D840N 留作内部口、并进 LAN 桥 */
			port@4 {
				reg = <4>;
				label = "lan0";
				phy-mode = "internal";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			port@5 {
				reg = <5>;
				label = "lan2";
				phy-mode = "internal";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			port@6 {
				reg = <6>;
				label = "lan3";
				phy-mode = "internal";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			port@7 {
				reg = <7>;
				label = "lan4";
				phy-mode = "internal";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			/* 2.5G 口：9132 的第五个用户口（原厂的 outerphy、uni4，PPU 口 5），2500BASE-X 到外置 PHY；速率与链路由驱动从 PHY 的 1f.0xa434 读出后覆盖这里的上限 */
			port@8 {
				reg = <8>;
				label = "lan1";
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};

			/* CPU 口：XMAC0 车道上 1G SGMII，接 conduit */
			port@9 {
				reg = <9>;
				ethernet = <&lan_cpu>;
				phy-mode = "sgmii";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};
