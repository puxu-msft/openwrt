+	{ "spa", 0x02329, 14 },
+	{ "red", 0x08065, 1 },
+	{ "red", 0x0806a, 6 },
+	{ "red", 0x08080, 4 },
+	{ "red", 0x080da, 6 },
+	{ "qmg", 0x09001, 1 },
+	{ "qmg", 0x09030, 20 },
+	{ "idm", 0xa0141, 6 },
