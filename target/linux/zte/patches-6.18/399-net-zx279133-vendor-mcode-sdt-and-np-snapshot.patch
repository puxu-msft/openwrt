+/* The shots after the first: 20 s, 45 s, 90 s and 180 s after the prepare. */
+static const unsigned int zx279133_hwcnt_at[] = { 20, 45, 90, 180 };
+
+static void zx279133_hwcnt_work(struct work_struct *work)
+{
+	struct zx279133_eth *eth = container_of(to_delayed_work(work),
+						struct zx279133_eth,
+						hwcnt_work);
+	unsigned int shot = eth->hwcnt_shot++;
+	unsigned long next;
+
+	/* The registers are not to be read with the NPPT's clocks off. */
+	if (READ_ONCE(eth->hardware_prepared)) {
+		pr_info("zx279133 hwcnt shot %u at +%us (changes since the previous shot)\n",
+			shot + 1,
+			jiffies_to_msecs(jiffies - eth->hwcnt_start) / 1000);
+		zx279133_hwcnt_print(eth, true);
+	}
+	if (eth->hwcnt_shot >= ARRAY_SIZE(zx279133_hwcnt_at))
+		return;
+	next = eth->hwcnt_start +
+	       secs_to_jiffies(zx279133_hwcnt_at[eth->hwcnt_shot]);
+	schedule_delayed_work(&eth->hwcnt_work,
+			      time_after(next, jiffies) ? next - jiffies : 0);
+}
