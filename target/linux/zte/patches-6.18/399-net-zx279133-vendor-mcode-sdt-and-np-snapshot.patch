-#define ZX279133_QID_ERAM_SDT_ID	0x19
-#define ZX279133_GLBCFG_ERAM_SDT_ID	0x22
-#define ZX279133_OUTPORT_ERAM_SDT_ID	0x27
-/*
- * The flood group table: one entry per group, one destination port id per
