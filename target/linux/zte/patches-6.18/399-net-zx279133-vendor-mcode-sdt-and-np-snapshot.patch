+static unsigned int zx279133_hwcnt_words(void)
+{
+	unsigned int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(zx279133_hwcnt_wins); i++)
+		n += zx279133_hwcnt_wins[i].count;
