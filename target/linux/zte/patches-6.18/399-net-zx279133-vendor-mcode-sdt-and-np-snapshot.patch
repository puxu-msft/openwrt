-	int ret;
-
-	for (b = 0; b < ARRAY_SIZE(bank); b++) {
-		ret = zx279133_eram_table_set_bits(eth,
-					ZX279133_SWITCH_PROTO_SDT_ID,
-					proto | ((port + bank[b]) << 7), 2,
-					action);
-		if (ret)
-			return ret;
-	}
-
-	return 0;
-}
