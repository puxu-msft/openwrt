+/*
+ * One line per window, listing the words that are non-zero (delta false) or
+ * that moved since the previous shot (delta true), as word=value(+change).
+ */
+static void zx279133_hwcnt_print(struct zx279133_eth *eth, bool delta)
+{
+	u32 *prev = delta ? eth->hwcnt_prev : NULL;
+	unsigned int i, k, idx = 0;
+	char line[256];
+
+	for (i = 0; i < ARRAY_SIZE(zx279133_hwcnt_wins); i++) {
+		size_t len = 0;
+		bool any = false;
+
+		for (k = 0; k < zx279133_hwcnt_wins[i].count; k++, idx++) {
+			u32 word = zx279133_hwcnt_wins[i].word + k;
+			u32 v = readl(eth->base + 4 * word);
+			u32 old = prev ? prev[idx] : 0;
+
+			if (prev)
+				prev[idx] = v;
+			if (v == old)
+				continue;
+			if (len > sizeof(line) - 40) {
+				pr_info("zx279133 hwcnt %s:%s\n",
+					zx279133_hwcnt_wins[i].name, line);
+				len = 0;
+			}
+			len += scnprintf(line + len, sizeof(line) - len,
+					 " %05x=%08x(%+lld)", word, v,
+					 (s64)v - (s64)old);
+			any = true;
+		}
+		if (any)
+			pr_info("zx279133 hwcnt %s:%s\n",
+				zx279133_hwcnt_wins[i].name, line);
+	}
+}
