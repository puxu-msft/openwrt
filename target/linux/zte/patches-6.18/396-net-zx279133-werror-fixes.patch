From: xp <a.xp@live.com>
Subject: [PATCH] net: ethernet: zte: zx279133: 修掉 -Werror 拦下的几处

OpenWrt 的内核配置开着 CONFIG_WERROR，390、395 原样编译有下面几处错误（woodnaonly 的构建不开 -Werror，只是告警）：

- zx279133-main.c 的三张寄存器表（zx279133_red_vendor_fixup() 的 RED 表、zx279133_tm_vendor_fixup() 的 QMG/SMCT 表、zx279133_diag_dump() 的诊断表）把偏移存在 u16 里：RED 在 NPPT 的 0x20004–0x20368、QMG 在 0x24014–0x24060，存进去只剩低 16 位，本意是把 RED 与 QMG 改回原厂板子的值，实际写到了 NPPT 0x0004–0x0368（nppt_greg）与 0x4014–0x4060（SIPC），RED 与 QMG 本身没改到（SMCT 在 0xc000 一带，不受影响）；诊断转储读的也是错的地址。woodnaonly 的 docs/66 记过“驱动写了原厂的值、板子读回却是别的”，就是这个截断。改成 u32，写到本意的 RED 与 QMG 寄存器。
- zx279133-main.c 的 err_clk_disable 标签没有 goto 用到，删掉标签（下面的语句照旧顺序执行）。
- zx279133-tm.c 以 %#x 打印 phys_addr_t，改 %pa。
- zx279133-np.c 的调试控制台写入函数在栈上放 4 KiB 的命令缓冲，超过内核的栈帧上限 2048：缓冲改由 memdup_user_nul() 放到堆上，命令解析挪进 zx279133_9132_cmd()，长度上限仍是 4095；另一处 GENMASK 的结果按 %u 打印，加 u32 转换。
- zx279133-switch.c 有两个没有调用者的静态函数（USXGMII 档、XMAC 配置），标 __maybe_unused；一处 GENMASK 结果按 %u 打印，加 u32 转换。

--- a/drivers/net/ethernet/zte/zx279133-main.c
+++ b/drivers/net/ethernet/zte/zx279133-main.c
@@ -304,7 +304,7 @@
 static void zx279133_red_vendor_fixup(struct zx279133_eth *eth)
 {
 	static const struct {
-		u16 offset;
+		u32 offset;
 		u32 value;
 	} regs[] = {
 		{ ZX279133_RED_CFG,			ZX279133_RED_VENDOR_CFG },
@@ -442,7 +442,7 @@
 static void zx279133_tm_vendor_fixup(struct zx279133_eth *eth)
 {
 	static const struct {
-		u16 offset;
+		u32 offset;
 		u32 value;
 	} regs[] = {
 		{ ZX279133_QMG_WATERMARK,	ZX279133_QMG_VENDOR_WATERMARK },
@@ -488,7 +488,7 @@
 static void zx279133_diag_dump(struct zx279133_eth *eth)
 {
 	static const struct {
-		u16 offset;
+		u32 offset;
 		const char *name;
 	} regs[] = {
 		{ ZX279133_RED_CFG,			"RED_CFG" },
@@ -750,7 +750,6 @@
 	zx279133_np_restore(eth);
 err_tm_restore:
 	zx279133_tm_restore(eth);
-err_clk_disable:
 	clk_bulk_disable_unprepare(ARRAY_SIZE(eth->clocks), eth->clocks);
 err_cci_restore:
 	zx279133_idm_cci_restore(eth);
--- a/drivers/net/ethernet/zte/zx279133-np.c
+++ b/drivers/net/ethernet/zte/zx279133-np.c
@@ -1313,24 +1313,14 @@
 	return !(off & 3);
 }
 
-static ssize_t zx279133_9132_write(struct file *file, const char __user *ubuf,
-				   size_t count, loff_t *ppos)
+/* 命令行已由 zx279133_9132_write() 拷进堆上以 NUL 结尾的 buf；原先 4 KiB 的栈上缓冲超过内核的栈帧上限（-Wframe-larger-than=2048） */
+static ssize_t zx279133_9132_cmd(struct zx279133_eth *eth, char *buf,
+				 size_t count)
 {
-	struct seq_file *m = file->private_data;
-	struct zx279133_eth *eth = m ? m->private : NULL;
-	char buf[4096];
 	char *p, *tok;
 	u32 mem, addr, val = 0;
 	int ret;
 
-	if (!eth)
-		return -ENODEV;
-	if (count >= sizeof(buf))
-		return -EINVAL;
-	if (copy_from_user(buf, ubuf, count))
-		return -EFAULT;
-	buf[count] = '\0';
-
 	p = buf;
 	tok = zx279133_9132_next_token(&p);
 	if (!tok)
@@ -2343,8 +2333,8 @@
 			pr_info("ppu pf port %2u = 0x%08x  vld=%u start_pc=%5u flow=%2u attr4=%u\n",
 				p, word,
 				(word & ZX279133_SPA_PORT_WORD_VLD) ? 1u : 0u,
-				(word & ZX279133_SPA_PORT_WORD_PC) >> 1, flow,
-				(word & ZX279133_SPA_PORT_WORD_ATTR4) >> 21);
+				(u32)((word & ZX279133_SPA_PORT_WORD_PC) >> 1), flow,
+				(u32)((word & ZX279133_SPA_PORT_WORD_ATTR4) >> 21));
 		}
 		return count;
 	}
@@ -2987,6 +2977,26 @@
 	return -EINVAL;
 }
 
+static ssize_t zx279133_9132_write(struct file *file, const char __user *ubuf,
+				   size_t count, loff_t *ppos)
+{
+	struct seq_file *m = file->private_data;
+	struct zx279133_eth *eth = m ? m->private : NULL;
+	char *buf;
+	ssize_t ret;
+
+	if (!eth)
+		return -ENODEV;
+	if (count >= 4096)
+		return -EINVAL;
+	buf = memdup_user_nul(ubuf, count);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+	ret = zx279133_9132_cmd(eth, buf, count);
+	kfree(buf);
+	return ret;
+}
+
 static int zx279133_9132_open(struct inode *inode, struct file *file)
 {
 	return single_open(file, zx279133_9132_show, inode->i_private);
--- a/drivers/net/ethernet/zte/zx279133-switch.c
+++ b/drivers/net/ethernet/zte/zx279133-switch.c
@@ -1240,7 +1240,7 @@
  * drivers/net/ethernet/zte/zx279133-rtl8372n.c - the same XPCS0 block on
  * the same lane, programmed there for the RTL8372N's 10G CPU port.
  */
-static int zx279133_switch_xpcs_usxgmii(struct zx279133_switch *priv)
+static int __maybe_unused zx279133_switch_xpcs_usxgmii(struct zx279133_switch *priv)
 {
 	int val;
 	int ret;
@@ -1662,7 +1662,7 @@
 	dev_info(priv->dev,
 		 "the 2.5G jack's MAC (XMAC0) runs at %s; the loader's TX_CTRL speed field was %u\n",
 		 speed == ZX279133_XMAC_SPEED_2P5G ? "2.5G" : "1G",
-		 (priv->saved_xmac_tx & ZX279133_XMAC_SPEED_MASK) >> 29);
+		 (u32)((priv->saved_xmac_tx & ZX279133_XMAC_SPEED_MASK) >> 29));
 
 	return speed;
 }
@@ -1831,8 +1831,8 @@
  * its control words reading zero, and a MAC that is not configured
  * neither sends nor receives.
  */
-static void zx279133_switch_xmac_configure(struct zx279133_switch *priv,
-					    bool do_reset)
+static void __maybe_unused zx279133_switch_xmac_configure(struct zx279133_switch *priv,
+							   bool do_reset)
 {
 	u32 xmac = ZX279133_XMAC0_BASE;
 	u32 value;
--- a/drivers/net/ethernet/zte/zx279133-tm.c
+++ b/drivers/net/ethernet/zte/zx279133-tm.c
@@ -792,8 +792,8 @@
 
 	if (eth->se_hash_size < ZX279133_SE_HASH_REQUIRED_SIZE)
 		return dev_err_probe(eth->dev, -EINVAL,
-				     "the SE hash reserved memory is too small: %#x bytes\n",
-				     eth->se_hash_size);
+				     "the SE hash reserved memory is too small: %pa bytes\n",
+				     &eth->se_hash_size);
 
 	for (i = 0; i < ARRAY_SIZE(eth->se_hash_smmu1_saved); i++)
 		eth->se_hash_smmu1_saved[i] = readl(eth->pps_base +
