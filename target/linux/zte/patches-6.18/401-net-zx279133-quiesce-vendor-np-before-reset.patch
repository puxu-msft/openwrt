From: xp <a.xp@live.com>
Subject: [PATCH] net: ethernet: zte: zx279133: 复位 NPPT 前照原厂先停数据面，原厂 SPA 字只读不写回，外置 PHY 自协商等待逐秒打印

中兴 F7615MV3 第五到第七轮实机（2026-11-27，构建树 4975e378c3c，ramoops 的控制台记录在 captures/20261127-usbroot/）：三轮都在交接后挂死，挂在哪一步随交接时原厂 NP 的状态变（第五轮放开收包之后、第六轮 NPPT 全局初始化超时与 ISU 忙、第七轮外置 PHY 自协商的 8 s 等待里），与 vendor_snap、lane_an 两个开关无关；第五轮读出的三张 ERAM 表整表是同一个字型、第六轮全是 0，399 的写回把这份无意义的字型写进了 MF 扩展表、端口类型表与协议动作表。

- 原厂现场只读：去掉 ERAM 表的读与写回（NPPT/SE 初始化之前的 SMMU0 读拿不到表内容），SPA 内存 0..16 的字 0..19 只读出、打印，不再写回；zx279133.vendor_snap=0 关掉这次读。
- 复位 NPPT 之前先停原厂留下的数据面（原厂 np.ko 没有停 NP 的路径，kexec 时 PPU、IDM 的 DMA 与收包都还在跑）：照原厂 tm_initial() 的第一步 spic_set_rx_en(0) 清 SIPC 收包使能（NPPT+0x4000 bit 0），等 10 ms（原厂 woe_demo_tx_idm_ser() 轮询环 FIFO 排空，CPU 环的对应字未核，以定时代替），再照 woe_demo_tx_idm_ser() 的 crm_idm_rst_en()/crm_idm_rst_disable() 把 CRM 字 NPPT+0x2c0010 的 bits 30:25 清零 10 ms 再置回；每步一行日志，开头打出 SIPC_CFG、0x2c0004、0x80 与 IDM 复位字；tm_initial() 里清 SMAC 配置两项的那一步对应哪一位未核，没做。NPPT 全局初始化超时的报错同时打出 0x80 的初始化完成字与 0x2c0004，成功时也打一行。
- 外置 2.5G PHY 自协商的 8 s 等待（msleep(200) × 40，可睡眠、开着中断，不占自旋锁）每满 1 s 打一行“still waiting for auto-negotiation”，其后 SerDes 链路的 2 s 等待在 1 s 时打一行；死在等待里时控制台记录能看出是第几秒。

--- a/drivers/net/ethernet/zte/zx279133-np.c
+++ b/drivers/net/ethernet/zte/zx279133-np.c
@@ -34,12 +34,12 @@
 MODULE_PARM_DESC(rx_hash_ipv6, "Enable IPv6 tuple hashing with the calibrated RX hash programs");
 /*
  * 二分用的开关（内核命令行 zx279133.vendor_snap=0、zx279133.hwcnt=0），缺省都开：
- * vendor_snap 管第一次准备硬件时在 NPPT 复位前读原厂 NP 现场、之后每次准备时写回；
+ * vendor_snap 管第一次准备硬件时在 NPPT 复位前只读打印原厂的 SPA 字；
  * hwcnt 管准备完成时与之后 20/45/90/180 s 的各级计数打印（调试控制台的 cnt 不受它管）。
  */
 static bool vendor_snap = true;
 module_param(vendor_snap, bool, 0444);
-MODULE_PARM_DESC(vendor_snap, "Read the vendor's NP state before the first NPPT reset and write it back after this driver's set-up");
+MODULE_PARM_DESC(vendor_snap, "Read and print the vendor's SPA words before the first NPPT reset (read only)");
 static bool hwcnt = true;
 module_param(hwcnt, bool, 0444);
 MODULE_PARM_DESC(hwcnt, "Print the datapath counters after the prepare and 20/45/90/180 s later");
@@ -3770,7 +3770,7 @@
  * wrong place.  type 1 is ERAM, 3 is hash, 4 is statistics and 5 is an ERAM
  * table with a parser SDT.  ERAM tables take blocks from the pool strictly in
  * this order, so every table's base follows from the list
- * (zx279133_sdt_layout()).  p3 selects the width of one entry out of {1, 32,
+ *.  p3 selects the width of one entry out of {1, 32,
  * 64, 128, 2, 4, 8, 16} bits.
  */
 static const u32 zx279133_core_sdt_info[][4] = {
@@ -4027,34 +4027,6 @@
 			     "SE PLCR init done status %#x\n", status);
 }
 
-/*
- * The ERAM bases the list gives, worked out without touching the hardware:
- * the vendor's allocator hands out blocks from 0x3000 in list order (see
- * zx279133_se_sdt_create() for why 0x3000).
- */
-static void zx279133_sdt_layout(void)
-{
-	u32 eram_base = 0x3000;
-	unsigned int i;
-
-	for (i = 0; i < ARRAY_SIZE(zx279133_core_sdt_info); i++) {
-		u32 sdt_no = zx279133_core_sdt_info[i][0];
-		u32 type = zx279133_core_sdt_info[i][1];
-		u32 a = zx279133_core_sdt_info[i][2];
-		u32 b = zx279133_core_sdt_info[i][3];
-		u32 bit_len;
-
-		if (type != 1 && type != 5)
-			continue;
-		bit_len = zx279133_se_sdt_bit_len[a & 7];
-		if (sdt_no < ZX279133_SDT_ID_MAX) {
-			zx279133_eram[sdt_no].base = eram_base;
-			zx279133_eram[sdt_no].bit_len = bit_len;
