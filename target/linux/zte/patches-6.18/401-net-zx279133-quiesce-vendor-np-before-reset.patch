From: xp <a.xp@live.com>
Subject: [PATCH] net: ethernet: zte: zx279133: 复位 NPPT 前照原厂先停数据面

中兴 F7615MV3 第五到第七轮实机（2026-11-27，构建树 4975e378c3c，ramoops 的控制台记录在 zte-f7615mv3 的 captures/20261127-usbroot/）：三轮都在 kexec 交接后挂死，挂在哪一步随交接时原厂 NP 的状态变（第五轮放开收包之后、第六轮 NPPT 全局初始化超时与 ISU 忙、第七轮外置 PHY 自协商的 8 s 等待里）。原厂 np.ko 没有停 NP 的路径（模块退出只调 tm_remove() 与注销调试节点），kexec 时 PPU、IDM 的 DMA 与收包都还在跑。

- 复位 NPPT 之前先停原厂留下的数据面：照原厂 tm_initial() 的第一步 spic_set_rx_en(0) 清 SIPC 收包使能（NPPT+0x4000 bit 0），等 10 ms（原厂 woe_demo_tx_idm_ser() 在这一步轮询环 FIFO 排空，CPU 收发环对应的字未核，以定时代替），再照 woe_demo_tx_idm_ser() 的 crm_idm_rst_en()/crm_idm_rst_disable() 把 CRM 字 NPPT+0x2c0010 的 bits 30:25 清零 10 ms 再置回。tm_initial() 里清 SMAC 配置两项的那一步对应哪一位未核，没做。
- NPPT 全局初始化超时的报错同时打出 0x80 的初始化完成字（与期望值）和 0x2c0004 的软复位字。

第八至十三轮实机的控制台记录（zte-f7615mv3 的 captures/20261127-usbroot/ 下 ramoops-004、-005、-008、-009 的 console.txt 与 bootlog-025、-029）里，停数据面之后 NPPT 全局初始化每轮都完成；第十四轮网口收发通。

试验里让 TX 超时只打印、不关硬件的 tx_recover 开关没有带进来：TX 超时恢复照原行为走 zx279133_tx_recovery_work() → zx279133_datapath_suspend() → zx279133_shared_idm_release(…, tx_quiesced=false)，打印 “TX did not quiesce; shutting down hardware before release”。第十轮实机（发包当时还不通，zte-f7615mv3 的 captures/20261127-usbroot/ramoops-008/console.txt 末行 23.27 s）这条路径挂死过整机，根因未定。按现状挂死后会被看门狗复位回原厂系统、可以远程再交接；改成只打印不关硬件则发包永久停住、看门狗照常喂、只能断电，更难恢复，所以不加规避，根因待查（登记在 zte-f7615mv3 的 docs/TASKS.md）。

--- a/drivers/net/ethernet/zte/zx279133-tm.c
+++ b/drivers/net/ethernet/zte/zx279133-tm.c
@@ -7,9 +7,32 @@
 
 #include "zx279133.h"
 
+/*
+ * kexec 交接时原厂的 NP 还在跑：原厂 np.ko 的模块退出只调 tm_remove() 与注销调试节点，没有停 NP 的路径，PPU、IDM 的 DMA 与收包都留着；不停就复位时，交接那一刻原厂 NP 的状态决定新内核挂在哪一步（F7615MV3 第五到第七轮实机分别挂在放开收包之后、NPPT 全局初始化超时与 ISU 忙、外置 PHY 自协商的等待里）。所以复位 NPPT 之前先照原厂的做法把数据面停下：
+ * 1. 照原厂 tm_initial() 的第一步 spic_set_rx_en(0)：SIPC 的收包使能清掉（NPPT+0x4000 bit 0，np.ko 寄存器表 sipc 第 0 项），不再有帧从 MAC 进 NP；
+ * 2. 等 10 ms 让已进 NP 的帧走完：原厂 woe_demo_tx_idm_ser() 在这一步轮询环 FIFO 的剩余直到排空，那组寄存器是 WOE 频段的，CPU 收发环对应的字未与原厂核对，这里以定时代替；
+ * 3. 照 woe_demo_tx_idm_ser() 的 crm_idm_rst_en()/crm_idm_rst_disable()：CRM 字 NPPT+0x2c0010 的 bits 30:25（每个频段两位，低有效；np.ko 寄存器表 crm 第 0 项）清零让 IDM 进复位，10 ms 后置回。
+ * tm_initial() 在第一步之后还经 smac_get_cfg()/smac_set_cfg() 清每个 SMAC 配置里的两项，对应哪一位未与原厂核对，这里没做。
+ */
+#define ZX279133_CRM_IDM_RST		0x2c0010
+#define ZX279133_CRM_IDM_RST_N		GENMASK(30, 25)
+#define ZX279133_SIPC_RX_EN		BIT(0)
+
+static void zx279133_np_quiesce(struct zx279133_eth *eth)
+{
+	u32 crm = readl(eth->base + ZX279133_CRM_IDM_RST);
+
+	writel(readl(eth->base + ZX279133_SIPC_CFG) & ~ZX279133_SIPC_RX_EN,
+	       eth->base + ZX279133_SIPC_CFG);
+	usleep_range(10000, 11000);
+	writel(crm & ~ZX279133_CRM_IDM_RST_N, eth->base + ZX279133_CRM_IDM_RST);
+	usleep_range(10000, 11000);
+	writel(crm | ZX279133_CRM_IDM_RST_N, eth->base + ZX279133_CRM_IDM_RST);
+}
+
 static int zx279133_np_reset_prepare(struct zx279133_eth *eth)
 {
-	u32 value;
+	u32 value, done;
 	int ret;
 
 	/*
@@ -36,6 +59,7 @@
 		return 0;
 	}
 
+	zx279133_np_quiesce(eth);
 	value = readl(eth->base + ZX279133_SYS_SOFT_RESET);
 	value &= ~ZX279133_SYS_SDET_RESET_N;
 	writel(value, eth->base + ZX279133_SYS_SOFT_RESET);
@@ -55,8 +79,8 @@
 	writel(ZX279133_SIPC_RX_GAP_VALUE, eth->base + ZX279133_SIPC_RX_GAP);
 
 	ret = readl_poll_timeout_atomic(eth->base + ZX279133_GLOBAL_INIT_DONE,
-					value,
-					(value & ZX279133_GLOBAL_INIT_DONE_MASK) ==
+					done,
+					(done & ZX279133_GLOBAL_INIT_DONE_MASK) ==
 					ZX279133_GLOBAL_INIT_DONE_MASK,
 					100, 40000);
 	usleep_range(200, 250);
@@ -65,8 +89,8 @@
 	       eth->base + ZX279133_SYS_SOFT_RESET);
 	if (ret)
 		return dev_err_probe(eth->dev, ret,
-				     "NPPT global initialization timed out: %#x\n",
-				     value);
+				     "NPPT global initialization timed out: init done %#x (want %#x), soft reset %#x\n",
+				     done, ZX279133_GLOBAL_INIT_DONE_MASK, value);
 
 	return 0;
 }
