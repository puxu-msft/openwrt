--- a/drivers/net/ethernet/zte/zx279133-tm.c
+++ b/drivers/net/ethernet/zte/zx279133-tm.c
@@ -7,9 +7,45 @@
 
 #include "zx279133.h"
 
+/*
+ * kexec 交接时原厂的 NP 还在跑：原厂 np.ko 的模块退出只调 tm_remove() 与注销调试节点，没有停 NP 的路径，PPU、IDM 的 DMA
+ * 与收包都留着。复位 NPPT 之前先照原厂的做法把数据面停下，每步一行日志（时间戳看是哪一步之后没了声音）：
+ * 1. 照原厂 tm_initial() 的第一步 spic_set_rx_en(0)：SIPC 的收包使能清掉（NPPT+0x4000 bit 0，np.ko 寄存器表 sipc 第 0 项），
+ *    不再有帧从 MAC 进 NP；
+ * 2. 等 10 ms 让已进 NP 的帧走完：原厂 woe_demo_tx_idm_ser() 在这一步轮询环 FIFO 的剩余直到排空，那组寄存器是 WOE 频段的，
+ *    CPU 收发环对应的字未与原厂核对，这里以定时代替；
+ * 3. 照 woe_demo_tx_idm_ser() 的 crm_idm_rst_en()/crm_idm_rst_disable()：CRM 字 NPPT+0x2c0010 的 bits 30:25（每个频段两位，
+ *    低有效；np.ko 寄存器表 crm 第 0 项）清零让 IDM 进复位，10 ms 后置回。
+ * tm_initial() 在第一步之后还经 smac_get_cfg()/smac_set_cfg() 清每个 SMAC 配置里的两项，对应哪一位未与原厂核对，这里没做。
+ */
+#define ZX279133_CRM_IDM_RST		0x2c0010
+#define ZX279133_CRM_IDM_RST_N		GENMASK(30, 25)
+#define ZX279133_SIPC_RX_EN		BIT(0)
+
+static void zx279133_np_quiesce(struct zx279133_eth *eth)
+{
+	u32 sipc = readl(eth->base + ZX279133_SIPC_CFG);
+	u32 crm = readl(eth->base + ZX279133_CRM_IDM_RST);
+
+	dev_info(eth->dev,
+		 "quiesce: SIPC_CFG %#x, soft reset %#x, init done %#x, IDM reset word %#x\n",
+		 sipc, readl(eth->base + ZX279133_SYS_SOFT_RESET),
+		 readl(eth->base + ZX279133_GLOBAL_INIT_DONE), crm);
+	writel(sipc & ~ZX279133_SIPC_RX_EN, eth->base + ZX279133_SIPC_CFG);
+	dev_info(eth->dev, "quiesce: SIPC receive off\n");
+	usleep_range(10000, 11000);
+	writel(crm & ~ZX279133_CRM_IDM_RST_N, eth->base + ZX279133_CRM_IDM_RST);
+	dev_info(eth->dev, "quiesce: IDM held in reset (%#x)\n",
+		 readl(eth->base + ZX279133_CRM_IDM_RST));
+	usleep_range(10000, 11000);
+	writel(crm | ZX279133_CRM_IDM_RST_N, eth->base + ZX279133_CRM_IDM_RST);
+	dev_info(eth->dev, "quiesce: IDM released (%#x)\n",
+		 readl(eth->base + ZX279133_CRM_IDM_RST));
+}
+
 static int zx279133_np_reset_prepare(struct zx279133_eth *eth)
 {
-	u32 value;
+	u32 value, done;
