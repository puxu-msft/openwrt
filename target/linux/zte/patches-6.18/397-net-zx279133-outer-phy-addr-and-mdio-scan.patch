+/*
+ * 一次性诊断：把 ZX279133 两个 MDIO 控制器上 0..31 的每个地址都读一遍，一个地址一行写进 dmesg——
+ * Clause 22 的 reg 2/3（PHY ID），Clause 45 devad 1（PMA/PMD）与 devad 7（AN）的 reg 2/3，各标成
+ * “0000”“ffff”“ID”或读错的错误码。只读，用来把“地址不对”“总线不对”“PHY 不应答/数据线被拉低”分开：
+ * 没有器件时一条上拉正常的 MDIO 读到 0xffff，整条总线都读成 0x0000 说明数据线没接到控制器（引脚复用）或被拉低。
+ */
+static const char *zx279133_switch_mdio_kind(int hi, int lo, char *buf, size_t len)
+{
+	if (hi < 0 || lo < 0)
+		snprintf(buf, len, "err %d", hi < 0 ? hi : lo);
+	else if (!hi && !lo)
+		snprintf(buf, len, "0000");
+	else if (hi == 0xffff && lo == 0xffff)
+		snprintf(buf, len, "ffff");
+	else
+		snprintf(buf, len, "ID %04x:%04x", hi, lo);
+	return buf;
+}
+
+static void zx279133_switch_mdio_scan_bus(struct zx279133_switch *priv,
+					  struct device_node *np)
+{
+	struct mii_bus *bus = of_mdio_find_bus(np);
+	char c22[24], d1[24], d7[24];
+	int addr;
+
+	if (!bus) {
+		dev_info(priv->dev, "mdio scan %pOF: bus not registered\n", np);
+		return;
+	}
+	for (addr = 0; addr < PHY_MAX_ADDR; addr++) {
+		zx279133_switch_mdio_kind(mdiobus_read(bus, addr, MII_PHYSID1),
+					  mdiobus_read(bus, addr, MII_PHYSID2),
+					  c22, sizeof(c22));
+		zx279133_switch_mdio_kind(mdiobus_c45_read(bus, addr, MDIO_MMD_PMAPMD, MDIO_DEVID1),
+					  mdiobus_c45_read(bus, addr, MDIO_MMD_PMAPMD, MDIO_DEVID2),
+					  d1, sizeof(d1));
+		zx279133_switch_mdio_kind(mdiobus_c45_read(bus, addr, MDIO_MMD_AN, MDIO_DEVID1),
+					  mdiobus_c45_read(bus, addr, MDIO_MMD_AN, MDIO_DEVID2),
+					  d7, sizeof(d7));
+		dev_info(priv->dev, "mdio scan %s addr %02x: c22 %s; c45 d1 %s; c45 d7 %s\n",
+			 bus->id, addr, c22, d1, d7);
+	}
+	put_device(&bus->dev);
+}
+
+static void zx279133_switch_mdio_scan(struct zx279133_switch *priv)
+{
+	struct device_node *np;
+
+	for_each_compatible_node(np, NULL, "zte,zx279133-mdio")
+		if (of_device_is_available(np))
+			zx279133_switch_mdio_scan_bus(priv, np);
+}
+
+/*
+ * 访问外置 PHY 之前照原厂解除低功耗：原厂 rlt8226b.ko 的 init_module 在复位脉冲（bspdriver 的
+ * bsp_xgphy_reset(1)、约 50 ms、再 bsp_xgphy_reset(0)、约 100 ms）与初始化之后，把 PMA/PMD control 1
+ * （devad 1 reg 0）的 bit 11 置 1 让 PHY 进低功耗；开口时 plat_132.ko 的 phy_rlt8226_set_enable(xmac, 1)
+ * 读回同一个寄存器、清 bit 11 再写回，关口（原厂 ifconfig eth0 down）时置回去。复位线走原厂的板级表、
+ * 不在设备树里，原厂初始化后一直是解除态，这里不碰。读到的 BMCR（Clause 22 reg 0）与 PMA control 1 写进 dmesg。
+ */
+static void zx279133_switch_outerphy_power_up(struct zx279133_switch *priv)
+{
+	struct mii_bus *bus = zx279133_switch_outer_mdio(priv);
+	int bmcr, pma, after;
+
+	if (!bus) {
+		dev_warn(priv->dev, "the 2.5G jack's PHY: its MDIO bus is not registered\n");
+		return;
+	}
+	bmcr = mdiobus_read(bus, priv->outer_addr, MII_BMCR);
+	pma = mdiobus_c45_read(bus, priv->outer_addr, MDIO_MMD_PMAPMD, MDIO_CTRL1);
+	after = pma;
+	if (pma >= 0 && (pma & ZX279133_SWITCH_OUTERPHY_PMA_LOWPOWER) && pma != 0xffff) {
+		mdiobus_c45_write(bus, priv->outer_addr, MDIO_MMD_PMAPMD, MDIO_CTRL1,
+				  pma & ~ZX279133_SWITCH_OUTERPHY_PMA_LOWPOWER);
+		after = mdiobus_c45_read(bus, priv->outer_addr, MDIO_MMD_PMAPMD, MDIO_CTRL1);
+	}
+	dev_info(priv->dev,
+		 "the 2.5G jack's PHY at %s addr %02x: BMCR (c22 reg 0) = %#06x, PMA control 1 (c45 1.0) = %#06x -> %#06x%s\n",
+		 bus->id, priv->outer_addr, bmcr, pma, after,
+		 after != pma ? " (low-power cleared, as the vendor's phy_rlt8226_set_enable does)" : "");
+}
+
 static int zx279133_switch_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -3957,6 +4052,13 @@
 	priv->dev = dev;
