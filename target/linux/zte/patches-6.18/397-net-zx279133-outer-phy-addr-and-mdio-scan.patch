 	mutex_init(&priv->lane_lock);
+	priv->outer_addr = ZX279133_SWITCH_OUTERPHY_ADDR;
+	if (!of_property_read_u32(parent_np, "zx279133,outer-phy-addr", &status)) {
+		if (status >= PHY_MAX_ADDR)
+			return dev_err_probe(dev, -EINVAL,
+					     "zx279133,outer-phy-addr %u is not an MDIO address\n", status);
+		priv->outer_addr = status;
+	}
 	INIT_DELAYED_WORK(&priv->lane_work, zx279133_switch_lane_watch);
 	/*
 	 * The watcher reads the lane's PCS, so it has to be stopped before
@@ -4061,6 +4163,9 @@
 		return dev_err_probe(dev, -ENETDOWN,
 				     "shared datapath is unavailable for LAN configuration\n");
 
+	zx279133_switch_mdio_scan(priv);
+	zx279133_switch_outerphy_power_up(priv);
+
 	/*
 	 * Follow the RTL8226 system side. 1e:7580 low 6 bits are 0x16 for
 	 * 2500BASE-X and 0x02 for SGMII. Do not force the 1G option class
