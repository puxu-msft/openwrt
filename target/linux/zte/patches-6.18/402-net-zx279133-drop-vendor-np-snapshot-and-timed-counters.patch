-/*
- * The vendor's NP state, read before this driver changes any of it.
- *
- * The board runs OpenWrt by kexec from its own vendor system, and at that
- * moment the vendor's np.ko and switch.ko have programmed the NP for this
- * board: the SPA memories (the per-port words the PPU starts every frame
- * from) and the SE's ERAM tables.  Those are this board's own values, and
- * for most of them nothing else says what they should be.  So the first
- * prepare reads them before zx279133_tm_prepare() resets the NPPT, prints
- * them, and zx279133_vendor_snap_replay() writes them back once this
- * driver's own set-up is done.
- *
- * Read are SPA memories 0..16 (PON0, the four 1G MACs, XMAC0, XMAC1, RGMII1,
- * the loop, XMAC_B, PON_PTL, PON1, the CPU trap, WIFI0) at addresses 0..19,
- * the whole of np.ko's spa_port_attr_table, and the three ERAM tables this
- * driver writes: the MF extension table (SDT 0x32, one entry per SPA
- * memory), the port type table (SDT 0x06) and the protocol action table
- * (SDT 0x04, 16 blocks per port).  The ERAM bases come from
- * zx279133_core_sdt_info[], which is the vendor's list; if the vendor's
- * tables are not where the list puts them, the printed blocks say so.
- *
- * A cold boot has no vendor state: no SPA memory then carries a valid
- * start-PC entry, and nothing is written back.
- */
-#define ZX279133_SNAP_MEMS	17
-#define ZX279133_SNAP_ADDRS	20
-#define ZX279133_SNAP_PRINT_MAX	64
-
-static const struct {
-	u32 sdt;
-	u32 blocks;
-	const char *name;
-} zx279133_snap_tables[] = {
-	{ ZX279133_MF_ERAM_SDT_ID, 64, "MF extension" },
-	{ ZX279133_PORT_TYPE_ERAM_SDT_ID, 64, "port type" },
-	{ ZX279133_PRO_ERAM_SDT_ID, 64 * ZX279133_PRO_BLOCKS_PER_PORT,
-	  "protocol action" },
-};
-
-struct zx279133_vendor_snap {
-	bool spa_valid;
-	u32 spa[ZX279133_SNAP_MEMS][ZX279133_SNAP_ADDRS];
-	u32 *eram[ARRAY_SIZE(zx279133_snap_tables)];
-};
-
-void zx279133_vendor_snap_take(struct zx279133_eth *eth)
-{
-	struct zx279133_vendor_snap *snap;
-	unsigned int t, m, a, named = 0;
-	bool spa_ok = true;
-
-	if (eth->vendor_snap_tried)
-		return;
-	eth->vendor_snap_tried = true;
-	/* An NPPT held in reset has no state, and its SPA does not answer. */
-	if (!(readl(eth->base + ZX279133_SYS_SOFT_RESET) &
-	      ZX279133_SYS_SDET_RESET_N)) {
-		dev_info(eth->dev,
-			 "the NPPT is in reset before the first prepare: no vendor NP state to read\n");
-		return;
-	}
-	snap = devm_kzalloc(eth->dev, sizeof(*snap), GFP_KERNEL);
-	if (!snap)
-		return;
-	eth->vendor_snap = snap;
-
-	for (m = 0; m < ZX279133_SNAP_MEMS && spa_ok; m++)
-		for (a = 0; a < ZX279133_SNAP_ADDRS; a++)
-			if (zx279133_spa_indirect_read(eth, m, a,
-						       &snap->spa[m][a])) {
-				spa_ok = false;
-				break;
-			}
-	for (m = 0; m < ZX279133_SNAP_MEMS; m++)
-		if (snap->spa[m][0] & BIT(0))
-			named++;
-	snap->spa_valid = spa_ok && named;
-	dev_info(eth->dev,
-		 "vendor NP state before the NPPT reset: SPA reads %s, %u of %u memories carry a start-PC entry%s\n",
-		 spa_ok ? "complete" : "FAILED", named, ZX279133_SNAP_MEMS,
-		 snap->spa_valid ? "" : " - nothing will be written back");
-	for (m = 0; m < ZX279133_SNAP_MEMS; m++)
-		dev_info(eth->dev,
-			 "vendor SPA mem %2u: %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
-			 m, snap->spa[m][0], snap->spa[m][1], snap->spa[m][2],
-			 snap->spa[m][3], snap->spa[m][4], snap->spa[m][5],
-			 snap->spa[m][6], snap->spa[m][7], snap->spa[m][8],
-			 snap->spa[m][9], snap->spa[m][10], snap->spa[m][11],
-			 snap->spa[m][12], snap->spa[m][13], snap->spa[m][14],
-			 snap->spa[m][15], snap->spa[m][16], snap->spa[m][17],
-			 snap->spa[m][18], snap->spa[m][19]);
-
-	zx279133_sdt_layout();
-	for (t = 0; t < ARRAY_SIZE(zx279133_snap_tables); t++) {
-		u32 sdt = zx279133_snap_tables[t].sdt;
-		u32 blocks = zx279133_snap_tables[t].blocks;
-		u32 base = zx279133_eram_base_of(sdt);
-		unsigned int b, nonzero = 0, printed = 0;
-		u32 *buf;
-
-		buf = devm_kcalloc(eth->dev, blocks, 4 * sizeof(u32),
-				   GFP_KERNEL);
-		if (!buf || !base)
-			continue;
-		for (b = 0; b < blocks; b++) {
-			u32 *w = buf + 4 * b;
-
-			if (zx279133_smmu0_read(eth, (base + b) << 7, w,
-						ZX279133_SMMU0_WORDS,
-						ZX279133_SMMU0_CMD_READ)) {
-				dev_warn(eth->dev,
-					 "vendor ERAM table %#x (%s): block %u read failed, not kept\n",
-					 sdt, zx279133_snap_tables[t].name,
-					 base + b);
-				devm_kfree(eth->dev, buf);
-				buf = NULL;
-				break;
-			}
-			if (!(w[0] | w[1] | w[2] | w[3]))
-				continue;
-			nonzero++;
-			if (printed++ < ZX279133_SNAP_PRINT_MAX)
-				dev_info(eth->dev,
-					 "vendor ERAM %#04x[%4u] (block %u): %08x %08x %08x %08x\n",
-					 sdt, b, base + b, w[0], w[1], w[2],
-					 w[3]);
-		}
-		if (!buf)
-			continue;
-		snap->eram[t] = buf;
-		dev_info(eth->dev,
-			 "vendor ERAM table %#x (%s) at block %u: %u of %u blocks non-zero\n",
-			 sdt, zx279133_snap_tables[t].name, base, nonzero,
-			 blocks);
-	}
-}
-
-static void zx279133_vendor_snap_replay(struct zx279133_eth *eth)
-{
-	struct zx279133_vendor_snap *snap = eth->vendor_snap;
-	unsigned int t, m, a, b, failed = 0, named = 0, agree = 0;
-
-	if (!snap || !snap->spa_valid) {
-		dev_warn(eth->dev,
-			 "no vendor NP state was read before the NPPT reset: the SPA words and ERAM tables keep this driver's values, which are not checked against the vendor's\n");
-		return;
-	}
-
-	/*
-	 * State left by anything else - a bootloader, another microcode -
-	 * starts the ports at PCs this microcode does not have.  The vendor's
-	 * own state starts them where the port-flow table says.
-	 */
-	for (m = 0; m < ZX279133_SNAP_MEMS; m++) {
-		u32 entry = eth->mcode_port_entry[m];
-
-		if (!entry)
-			continue;
-		named++;
-		if ((snap->spa[m][0] & ZX279133_SPA_ENTRY_MASK) == entry)
-			agree++;
-	}
-	if (!named || agree * 2 < named) {
-		dev_warn(eth->dev,
-			 "the NP state read before the reset does not start the ports where this microcode does (%u of %u entries agree): not written back\n",
-			 agree, named);
-		return;
-	}
-
-	for (m = 0; m < ZX279133_SNAP_MEMS; m++) {
-		u32 entry = eth->mcode_port_entry[m];
-
-		for (a = 0; a < ZX279133_SNAP_ADDRS; a++) {
-			u32 v = snap->spa[m][a];
-
-			/* Word 0's entry fields belong to the microcode. */
-			if (a == 0 && entry &&
-			    (v & ZX279133_SPA_ENTRY_MASK) != entry) {
-				dev_warn(eth->dev,
-					 "SPA memory %u: the vendor ran word 0 = %08x, the microcode's port-flow entry %06x is kept\n",
-					 m, v, entry);
-				v = (v & ~ZX279133_SPA_ENTRY_MASK) | entry;
-			}
-			if (zx279133_spa_indirect_write(eth, m, a, v))
-				failed++;
-		}
-	}
-
-	for (t = 0; t < ARRAY_SIZE(zx279133_snap_tables); t++) {
-		u32 base = zx279133_eram_base_of(zx279133_snap_tables[t].sdt);
-
-		if (!snap->eram[t] || !base)
-			continue;
-		for (b = 0; b < zx279133_snap_tables[t].blocks; b++)
-			if (zx279133_smmu0_write(eth, (base + b) << 7,
-						 snap->eram[t] + 4 * b,
-						 ZX279133_SMMU0_WORDS,
-						 ZX279133_SMMU0_CMD_WRITE))
-				failed++;
-	}
-
-	dev_info(eth->dev,
-		 "vendor NP state written back: SPA memories 0..%u addresses 0..%u, ERAM tables %#x/%#x/%#x (%u writes failed)\n",
-		 ZX279133_SNAP_MEMS - 1, ZX279133_SNAP_ADDRS - 1,
-		 zx279133_snap_tables[0].sdt, zx279133_snap_tables[1].sdt,
-		 zx279133_snap_tables[2].sdt, failed);
-}
-
