+static int zx279133_get_link_ksettings(struct net_device *ndev,
+				       struct ethtool_link_ksettings *cmd)
+{
+	struct zx279133_eth *eth = netdev_priv(ndev);
+
+	return phylink_ethtool_ksettings_get(eth->phylink, cmd);
