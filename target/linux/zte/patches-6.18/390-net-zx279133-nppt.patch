+	ret = regmap_read(eth->idm_cci, 0, &eth->idm_cci_saved[0]);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(eth->idm_cci, 4, &eth->idm_cci_saved[1]);
+	if (ret)
