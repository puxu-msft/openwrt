+		dev_info(eth->dev, "DIAG lan mac %pM\n", eth->lan_ndev->dev_addr);
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		dev_info(eth->dev, "DIAG nppt 0x%05x %-22s = 0x%08x\n",
