+/* The port an NPPT-side frame is told to leave by, and the port an incoming
+ * frame has to name to be counted on that side. Kept writable so one boot can
+ * sweep the candidates the vendor's two numbering spaces disagree about; see
+ * zx279133.h.
+ */
+u16 zx279133_tx_port = 4;
+module_param(zx279133_tx_port, ushort, 0644);
+MODULE_PARM_DESC(zx279133_tx_port, "IDM TX output port for frames sent on the NPPT device, and the port an RX frame must name to be counted there");
+
+static void zx279133_tx_recovery_work(struct work_struct *work);
+static int zx279133_datapath_restore_failed_locked(struct zx279133_eth *eth);
+
+void zx279133_tx_recovery_init(struct zx279133_eth *eth)
+{
+	INIT_DELAYED_WORK(&eth->tx_recovery_work, zx279133_tx_recovery_work);
+	mutex_init(&eth->lan_control_lock);
+	mutex_init(&eth->lan_mmio_lock);
+	eth->lan_mmio_enabled = false;
+	eth->tx_stopping = true;
+}
+
+void zx279133_tx_recovery_cancel(void *data)
+{
+	struct zx279133_eth *eth = data;
+
+	spin_lock_bh(&eth->tx_lock);
+	eth->tx_recovery_disabled = true;
+	eth->tx_recovery_queues = 0;
+	spin_unlock_bh(&eth->tx_lock);
+	/* Synchronous cancellation is reserved for devm cleanup and shutdown,
+	 * outside datapath_lock. ndo_stop must not cancel this work under RTNL.
+	 */
+	cancel_delayed_work_sync(&eth->tx_recovery_work);
+}
+
+static void zx279133_tx_recovery_queue_locked(struct zx279133_eth *eth,
+					     unsigned long queues)
+{
+	unsigned int i;
+
+	if (!queues)
+		return;
+	if (!eth->tx_recovery_queues) {
+		eth->tx_recovery_requests++;
+		eth->tx_recovery_epoch = eth->tx_epoch;
+	}
+	for (i = 0; i < ZX279133_CPU_TX_QUEUES; i++)
+		if ((queues & BIT(i)) && !(eth->tx_recovery_queues & BIT(i)))
+			eth->tx_recovery_done[i] = eth->tx[i].done;
+	eth->tx_recovery_queues |= queues;
+	mod_delayed_work(system_wq, &eth->tx_recovery_work, 0);
+}
+
+/* Caller holds tx_lock. A fault quarantines both logical TX devices. */
+void zx279133_tx_recovery_request_locked(struct zx279133_eth *eth,
+					 unsigned int queue,
+					 bool invalid_completion)
+{
+	bool stopping = READ_ONCE(eth->tx_stopping);
+	unsigned int i;
+
+	if (queue >= ZX279133_CPU_TX_QUEUES)
+		return;
+	if (invalid_completion) {
+		if (!(eth->tx_fault_queues & BIT(queue)))
+			eth->tx_invalid_completions++;
+		eth->tx_fault_queues |= BIT(queue);
+		WRITE_ONCE(eth->tx_stopping, true);
+		netif_tx_stop_all_queues(eth->ndev);
+		if (eth->lan_ndev)
+			netif_tx_stop_all_queues(eth->lan_ndev);
+	}
+	/* An invalid completion observed by drain belongs to that teardown. */
+	if (stopping || eth->tx_recovery_disabled || eth->tx_recovery_active ||
+	    !eth->tx_prepared || !READ_ONCE(eth->hardware_prepared) ||
+	    READ_ONCE(eth->datapath_failed))
+		return;
+	/* A restart is rearmed only by genuine, successfully reclaimed TX. */
+	if (eth->tx_recovery_attempted)
+		for (i = 0; i < ZX279133_CPU_TX_QUEUES; i++)
+			if (eth->tx[i].completed != eth->tx_recovery_baseline[i]) {
+				eth->tx_recovery_attempted = false;
+				break;
+			}
+	zx279133_tx_recovery_queue_locked(eth, BIT(queue));
+}
+
+/* No LAN control transaction may acquire datapath_lock. */
+static void zx279133_lan_mmio_set(struct zx279133_eth *eth, bool enabled)
+{
+	mutex_lock(&eth->lan_control_lock);
+	mutex_lock(&eth->lan_mmio_lock);
+	eth->lan_mmio_enabled = enabled;
+	mutex_unlock(&eth->lan_mmio_lock);
+	mutex_unlock(&eth->lan_control_lock);
+}
+
+static void zx279133_wan_phylink_start(struct zx279133_eth *eth)
+{
+	if (!eth->wan_phylink_started) {
+		phylink_start(eth->phylink);
+		eth->wan_phylink_started = true;
+	}
+}
+
+static void zx279133_wan_phylink_stop(struct zx279133_eth *eth)
+{
+	if (eth->wan_phylink_started) {
+		phylink_stop(eth->phylink);
+		eth->wan_phylink_started = false;
+	}
+}
+
+/* Caller holds tx_lock; the fault bit also covers the other logical device. */
+static bool zx279133_tx_available_locked(struct zx279133_eth *eth)
+{
+	return eth->tx_prepared && READ_ONCE(eth->hardware_prepared) &&
+		!READ_ONCE(eth->tx_stopping) && !eth->tx_fault_queues &&
+		!eth->tx_recovery_disabled && !READ_ONCE(eth->datapath_failed);
+}
+
+static int zx279133_shared_idm_prepare(struct zx279133_eth *eth)
+{
+	unsigned int i;
+	int ret;
+
+	ret = zx279133_idm_tx_prepare(eth);
+	if (ret)
+		return ret;
+
+	ret = zx279133_idm_rx_prepare(eth);
+	if (ret) {
+		zx279133_idm_tx_release(eth, true);
+		return ret;
+	}
+
+	page_pool_enable_direct_recycling(eth->rx_page_pool, &eth->napi);
+	page_pool_enable_direct_recycling(eth->lan_rx_page_pool, &eth->lan_napi);
+	napi_enable(&eth->lan_napi);
+	napi_enable(&eth->napi);
+	WRITE_ONCE(eth->napi_enabled, true);
+	spin_lock_bh(&eth->tx_lock);
+	eth->tx_epoch++;
+	eth->tx_recovery_queues = 0;
+	eth->tx_fault_queues = 0;
+	for (i = 0; i < ZX279133_CPU_TX_QUEUES; i++)
+		eth->tx_recovery_baseline[i] = eth->tx[i].completed;
+	WRITE_ONCE(eth->tx_stopping, false);
+	spin_unlock_bh(&eth->tx_lock);
+
+	return 0;
+}
+
+static void zx279133_shared_idm_abort(struct zx279133_eth *eth)
+{
+	spin_lock_bh(&eth->tx_lock);
+	WRITE_ONCE(eth->tx_stopping, true);
+	spin_unlock_bh(&eth->tx_lock);
+	napi_disable(&eth->lan_napi);
+	napi_disable(&eth->napi);
+	WRITE_ONCE(eth->napi_enabled, false);
+	page_pool_disable_direct_recycling(eth->rx_page_pool);
+	page_pool_disable_direct_recycling(eth->lan_rx_page_pool);
+	zx279133_idm_rx_release(eth);
+	zx279133_idm_tx_release(eth, true);
+}
+
+static void zx279133_shared_rx_start(struct zx279133_eth *eth)
+{
+	spin_lock_irq(&eth->irq_lock);
+	WRITE_ONCE(eth->rx_running, true);
+	spin_unlock_irq(&eth->irq_lock);
+	enable_irq(eth->irqs[1]);
+	eth->rx_irq_enabled = true;
+	enable_irq(eth->irqs[4]);
+	eth->idm_local_irq_enabled = true;
+	spin_lock_irq(&eth->irq_lock);
+	/*
+	 * The sources this driver has a handler for, and only those: the
+	 * routing word also delivers sources 16..26 to the same interrupt
+	 * line, and nothing in this driver acknowledges them.  An acknowledged
+	 * source that nobody handles keeps the level-triggered line asserted
+	 * and the handler re-enters forever, which starves the NET_RX softirq
+	 * and stops both NAPIs from ever polling a descriptor.  See the note
+	 * on ZX279133_IDM_UNHANDLED_MASK.
+	 */
+	zx279133_idm_set_masked(eth, ZX279133_IDM_UNHANDLED_MASK, true);
+	zx279133_idm_set_masked(eth, ZX279133_IDM_NAPI_MASK, false);
+	spin_unlock_irq(&eth->irq_lock);
+}
+
+static void zx279133_shared_rx_stop(struct zx279133_eth *eth)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&eth->irq_lock, flags);
+	WRITE_ONCE(eth->rx_running, false);
+	zx279133_idm_set_masked(eth, ZX279133_IDM_NAPI_MASK, true);
+	spin_unlock_irqrestore(&eth->irq_lock, flags);
+	cancel_delayed_work_sync(&eth->rx_refill_work);
+	if (eth->idm_local_irq_enabled) {
+		disable_irq(eth->irqs[4]);
+		eth->idm_local_irq_enabled = false;
+	}
+	if (eth->rx_irq_enabled) {
+		disable_irq(eth->irqs[1]);
+		eth->rx_irq_enabled = false;
+	}
+	if (eth->napi_enabled) {
+		napi_disable(&eth->lan_napi);
+		napi_disable(&eth->napi);
+		WRITE_ONCE(eth->napi_enabled, false);
+		page_pool_disable_direct_recycling(eth->rx_page_pool);
+		page_pool_disable_direct_recycling(eth->lan_rx_page_pool);
+	}
+}
+
+static bool zx279133_shared_tx_pause(struct zx279133_eth *eth)
+{
+	/* Publish the quiesce state before stopping either logical queue so TX
+	 * completion reclaim cannot wake one between the two disable calls.
+	 */
+	spin_lock_bh(&eth->tx_lock);
+	WRITE_ONCE(eth->tx_stopping, true);
+	spin_unlock_bh(&eth->tx_lock);
+	/* XDP and XSK producers test tx_stopping before taking tx_lock from
+	 * softirq context; wait for any that passed the test to finish.
+	 */
+	synchronize_net();
+	if (netif_running(eth->ndev))
+		netif_tx_disable(eth->ndev);
+	if (eth->lan_ndev && netif_running(eth->lan_ndev))
+		netif_tx_disable(eth->lan_ndev);
+	cancel_delayed_work_sync(&eth->tx_reclaim_work);
+
+	return zx279133_idm_tx_drain(eth);
+}
+
+static void zx279133_shared_tx_resume(struct zx279133_eth *eth)
+{
+	bool rearm;
+
+	spin_lock_bh(&eth->tx_lock);
+	if (eth->tx_fault_queues || eth->tx_recovery_disabled ||
+	    READ_ONCE(eth->datapath_failed) || !eth->tx_prepared ||
+	    !READ_ONCE(eth->hardware_prepared)) {
+		/* A partial logical stop may discover a fault while draining.
+		 * Its teardown is complete now; the remaining user needs recovery.
+		 */
+		if (eth->tx_fault_queues && !eth->tx_recovery_disabled &&
+		    !eth->tx_recovery_active && !eth->datapath_failed &&
+		    eth->tx_prepared && eth->hardware_prepared)
+			zx279133_tx_recovery_queue_locked(eth, eth->tx_fault_queues);
+		spin_unlock_bh(&eth->tx_lock);
+		return;
+	}
+	WRITE_ONCE(eth->tx_stopping, false);
+	rearm = zx279133_idm_tx_pending(eth);
+	if (rearm)
+		mod_delayed_work(system_wq, &eth->tx_reclaim_work,
+				 msecs_to_jiffies(ZX279133_TX_RECLAIM_DELAY_MS));
+	if ((eth->datapath_users & ZX279133_DATAPATH_USER_WAN) &&
+	    netif_running(eth->ndev))
+		netif_tx_wake_all_queues(eth->ndev);
+	if ((eth->datapath_users & ZX279133_DATAPATH_USER_LAN) &&
+	    eth->lan_datapath_ready && eth->lan_ndev &&
+	    netif_running(eth->lan_ndev))
+		netif_tx_wake_all_queues(eth->lan_ndev);
+	spin_unlock_bh(&eth->tx_lock);
+}
+
+static void zx279133_shared_idm_release(struct zx279133_eth *eth,
+					struct net_device *ndev,
+					bool tx_quiesced)
+{
+	if (!ndev)
+		ndev = eth->ndev;
+	zx279133_lan_mmio_set(eth, false);
+	if (!tx_quiesced) {
+		netdev_warn(ndev,
+			    "TX did not quiesce; shutting down hardware before release\n");
+		zx279133_xmac_set_enabled(eth, false);
+		zx279133_route_set(eth, false);
+		/* Stop future IDM fetches from the DMA-coherent descriptor ring
+		 * while its clocks are still available. Pending payload mappings are
+		 * released only after the remaining NPPT pipeline is shut down.
+		 */
+		zx279133_idm_tx_deactivate(eth);
+		zx279133_hardware_unprepare(eth);
+	}
+	zx279133_idm_tx_release(eth, tx_quiesced);
+	if (tx_quiesced)
+		zx279133_hardware_unprepare(eth);
+	zx279133_idm_rx_release(eth);
+}
+
+/* Caller holds datapath_lock; never attach a quarantined ring. */
+static void zx279133_datapath_attach(struct zx279133_eth *eth)
+{
+	spin_lock_bh(&eth->tx_lock);
+	if (zx279133_tx_available_locked(eth)) {
+		netif_device_attach(eth->ndev);
+		if (eth->lan_ndev) {
+			netif_device_attach(eth->lan_ndev);
+			if (eth->lan_datapath_ready && netif_running(eth->lan_ndev))
+				netif_carrier_on(eth->lan_ndev);
+		}
+	}
+	spin_unlock_bh(&eth->tx_lock);
+}
+
+static int zx279133_open(struct net_device *ndev)
+{
+	struct zx279133_eth *eth = netdev_priv(ndev);
+	bool first_user;
+	int ret;
+
+	mutex_lock(&eth->datapath_lock);
+	if (eth->datapath_users & ZX279133_DATAPATH_USER_WAN) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	first_user = !eth->datapath_users;
+	if (!first_user) {
+		ret = zx279133_datapath_restore_failed_locked(eth);
+		if (ret)
+			goto out_unlock;
+	}
+
+	if (first_user) {
+		ret = zx279133_hardware_prepare(eth);
+		if (ret)
+			goto out_unlock;
+
+		/* The XPCS platform runtime reference belongs to the shared
+		 * hardware lifetime. hardware_unprepare() clears PCS bypass and
+		 * must run before the last reference is dropped.
+		 */
+		ret = pm_runtime_resume_and_get(eth->xpcs_mdiodev->bus->parent);
+		if (ret < 0)
+			goto err_hardware_unprepare;
+		eth->xpcs_runtime_held = true;
+
+		ret = zx279133_shared_idm_prepare(eth);
+		if (ret)
+			goto err_hardware_unprepare;
+	}
+
+	ret = phylink_of_phy_connect(eth->phylink, ndev->dev.parent->of_node, 0);
+	if (ret)
+		goto err_idm_abort;
+
+	zx279133_wan_phylink_start(eth);
+	if (first_user)
+		zx279133_shared_rx_start(eth);
+	eth->datapath_users |= ZX279133_DATAPATH_USER_WAN;
+	WRITE_ONCE(eth->datapath_failed, false);
+	spin_lock_bh(&eth->tx_lock);
+	eth->tx_recovery_attempted = false;
+	spin_unlock_bh(&eth->tx_lock);
+	zx279133_lan_mmio_set(eth, true);
+	zx279133_datapath_attach(eth);
+	spin_lock_bh(&eth->tx_lock);
+	if (zx279133_tx_available_locked(eth))
+		netif_tx_start_all_queues(ndev);
+	spin_unlock_bh(&eth->tx_lock);
+	mutex_unlock(&eth->datapath_lock);
+
+	return 0;
+
+err_idm_abort:
+	if (first_user)
+		zx279133_shared_idm_abort(eth);
+err_hardware_unprepare:
+	if (first_user) {
+		zx279133_hardware_unprepare(eth);
+		if (eth->xpcs_runtime_held) {
+			pm_runtime_put(eth->xpcs_mdiodev->bus->parent);
+			eth->xpcs_runtime_held = false;
+		}
+	}
+out_unlock:
+	mutex_unlock(&eth->datapath_lock);
+	return ret;
+}
+
+static void zx279133_xmac_close(struct zx279133_eth *eth, u32 base, u32 ctrl)
+{
+	void __iomem *reg = eth->base + base + ctrl;
+
+	writel(readl(reg) & ~ZX279133_XMAC_ENABLE, reg);
+}
+
+/*
+ * Leave the NPPT quiet for whatever runs next. Nothing else stops it on
+ * reboot or kexec: the LAN switch keeps its share of the datapath until it
+ * is removed, so frames still arriving would be written by DMA into memory
+ * that a kexec'ed kernel already uses. Close both MACs so that nothing more
+ * comes in, then stop the interrupts and the IDM descriptor fetches, and
+ * leave the rest as it is: undoing the whole setup here with
+ * zx279133_hardware_unprepare() was followed by a reset of the board about
+ * a second later, every time.
+ */
+void zx279133_shutdown(struct zx279133_eth *eth)
+{
+	mutex_lock(&eth->datapath_lock);
+	zx279133_lan_mmio_set(eth, false);
+	zx279133_wan_phylink_stop(eth);
+	if (eth->hardware_prepared) {
+		mutex_lock(&eth->xmac_lock);
+		zx279133_xmac_close(eth, ZX279133_XMAC0_BASE,
+				    ZX279133_XMAC_RX_CTRL);
+		zx279133_xmac_close(eth, zx279133_xmac_base(),
+				    ZX279133_XMAC_RX_CTRL);
+		mutex_unlock(&eth->xmac_lock);
+		zx279133_shared_rx_stop(eth);
+		zx279133_shared_tx_pause(eth);
+		mutex_lock(&eth->xmac_lock);
+		zx279133_xmac_close(eth, ZX279133_XMAC0_BASE,
+				    ZX279133_XMAC_TX_CTRL);
+		zx279133_xmac_close(eth, zx279133_xmac_base(),
+				    ZX279133_XMAC_TX_CTRL);
+		mutex_unlock(&eth->xmac_lock);
+		zx279133_route_set(eth, false);
+		zx279133_idm_tx_deactivate(eth);
+	}
+	mutex_unlock(&eth->datapath_lock);
+}
+
+static int zx279133_stop(struct net_device *ndev)
+{
+	struct zx279133_eth *eth = netdev_priv(ndev);
+	bool last_user;
+	bool tx_quiesced;
+
+	mutex_lock(&eth->datapath_lock);
+	if (!(eth->datapath_users & ZX279133_DATAPATH_USER_WAN))
+		goto out_unlock;
+	last_user = eth->datapath_users == ZX279133_DATAPATH_USER_WAN;
+	if (eth->datapath_failed || !eth->hardware_prepared) {
+		zx279133_wan_phylink_stop(eth);
+		phylink_disconnect_phy(eth->phylink);
+		eth->datapath_users &= ~ZX279133_DATAPATH_USER_WAN;
+		goto put_runtime;
+	}
+	if (last_user)
+		zx279133_shared_rx_stop(eth);
+	tx_quiesced = zx279133_shared_tx_pause(eth);
+	zx279133_wan_phylink_stop(eth);
+	phylink_disconnect_phy(eth->phylink);
+	eth->datapath_users &= ~ZX279133_DATAPATH_USER_WAN;
+	if (last_user) {
+		zx279133_shared_idm_release(eth, ndev, tx_quiesced);
+	} else {
+		if (!tx_quiesced)
+			netdev_warn(ndev,
+				    "shared TX did not quiesce while LAN remains active\n");
+		zx279133_shared_tx_resume(eth);
+	}
+put_runtime:
+	if (last_user && eth->xpcs_runtime_held) {
+		pm_runtime_put(eth->xpcs_mdiodev->bus->parent);
+		eth->xpcs_runtime_held = false;
+	}
+out_unlock:
+	mutex_unlock(&eth->datapath_lock);
+
+	return 0;
+}
+
+static enum zx279133_tx_csum_fallback
+zx279133_tx_csum_reason(struct sk_buff *skb)
+{
+	const struct iphdr *iph;
+	unsigned int network = skb_network_offset(skb);
+	unsigned int transport = skb_transport_offset(skb);
+
+	if (!zx279133_tx_hw_csum)
+		return ZX279133_TX_CSUM_DISABLED;
+	if (skb->len < ETH_ZLEN)
+		return ZX279133_TX_CSUM_SHORT;
+	if (skb->protocol != htons(ETH_P_IP))
+		return ZX279133_TX_CSUM_PROTOCOL;
+	if (skb->encapsulation)
+		return ZX279133_TX_CSUM_ENCAP;
+	if (network > 63 || transport > 63)
+		return ZX279133_TX_CSUM_RANGE;
+	if (transport < network + sizeof(struct iphdr))
+		return ZX279133_TX_CSUM_TRANSPORT;
+	if (skb_checksum_start_offset(skb) != transport)
+		return ZX279133_TX_CSUM_START;
+	if (skb->csum_offset != offsetof(struct tcphdr, check))
+		return ZX279133_TX_CSUM_OFFSET;
+	if (skb_csum_is_sctp(skb))
+		return ZX279133_TX_CSUM_SCTP;
+	if (!pskb_may_pull(skb, transport + sizeof(struct tcphdr)))
+		return ZX279133_TX_CSUM_PULL;
+	iph = ip_hdr(skb);
+	/* DSA may have padded a short frame before it reaches the conduit.
+	 * IDM must not include that Ethernet padding in its TCP checksum.
+	 */
+	if (iph->version != 4)
+		return ZX279133_TX_CSUM_VERSION;
+	if (iph->ihl < 5)
+		return ZX279133_TX_CSUM_IHL;
+	if (ip_is_fragment(iph))
+		return ZX279133_TX_CSUM_FRAGMENT;
+	if (skb->len - network != ntohs(iph->tot_len))
+		return ZX279133_TX_CSUM_LENGTH;
+	if (transport != network + iph->ihl * 4)
+		return ZX279133_TX_CSUM_TRANSPORT;
+	if (iph->protocol != IPPROTO_TCP)
+		return ZX279133_TX_CSUM_NOT_TCP;
+	return ZX279133_TX_CSUM_OK;
+}
+
+static int zx279133_lan_strip_transport_vlan(struct sk_buff *skb, u8 *out_port);
+
+static netdev_tx_t zx279133_start_xmit_common(struct sk_buff *skb,
+					      struct net_device *hw_ndev,
+					      struct net_device *ndev,
+					      u8 lan_out_port)
+{
+	struct zx279133_eth *eth = netdev_priv(hw_ndev);
+	unsigned int queue = skb_get_queue_mapping(skb);
+	struct zx279133_tx_ring *tx = &eth->tx[queue];
+	struct netdev_queue *txq = netdev_get_tx_queue(ndev, queue);
+	struct zx279133_idm_desc *desc;
+	struct zx279133_tx_slot *slot;
+	dma_addr_t dma;
+	u16 producer;
+	u8 tx_port;
+	bool arm_reclaim;
+	bool hw_csum = false;
+	bool sw_csum = false;
+	enum zx279133_tx_csum_fallback csum_reason = ZX279133_TX_CSUM_OK;
+
+	spin_lock_bh(&eth->tx_lock);
+	if (unlikely(!zx279133_tx_available_locked(eth))) {
+		netif_stop_subqueue(ndev, queue);
+		spin_unlock_bh(&eth->tx_lock);
+		return NETDEV_TX_BUSY;
+	}
+	if (unlikely(tx->pending >= ZX279133_IDM_TX_DEPTH - 1))
+		zx279133_idm_tx_reclaim_queue_locked(eth, queue);
+	if (unlikely(!zx279133_tx_available_locked(eth) ||
+		     tx->pending >= ZX279133_IDM_TX_DEPTH - 1)) {
+		netif_stop_subqueue(ndev, queue);
+		txq_trans_update(ndev, txq);
+		if (zx279133_tx_available_locked(eth))
+			zx279133_idm_tx_flush_queue_locked(eth, queue);
+		spin_unlock_bh(&eth->tx_lock);
+		return NETDEV_TX_BUSY;
+	}
+	spin_unlock_bh(&eth->tx_lock);
+
+	/* A NETDEV_TX_BUSY return must leave the transport tag intact: the
+	 * tag names the destination jack on a retry. Only mutate after the
+	 * initial ring-capacity check; later ring races consume/drop the skb.
+	 */
+	if (ndev != hw_ndev) {
+		int popped = zx279133_lan_strip_transport_vlan(skb, &lan_out_port);
+
+		if (popped < 0) {
+			atomic64_inc(&eth->tx_vlan_pop_errors);
+			goto drop;
+		}
+		if (popped)
+			atomic64_inc(&eth->tx_vlan_popped);
+	}
+	if (skb_linearize(skb))
+		goto drop;
+	if (skb->ip_summed == CHECKSUM_PARTIAL) {
+		csum_reason = zx279133_tx_csum_reason(skb);
+		hw_csum = csum_reason == ZX279133_TX_CSUM_OK;
+		if (!hw_csum) {
+			if (skb_checksum_help(skb)) {
+				atomic64_inc(&eth->tx_csum_help_errors);
+				goto drop;
+			}
+			sw_csum = true;
+		}
+	}
+	if (skb_put_padto(skb, ETH_ZLEN)) {
+		spin_lock_bh(&eth->tx_lock);
+		if (zx279133_tx_available_locked(eth))
+			zx279133_idm_tx_flush_queue_locked(eth, queue);
+		spin_unlock_bh(&eth->tx_lock);
+		zx279133_stats_tx_dropped(eth, ndev);
+		return NETDEV_TX_OK;
+	}
+	/* The tag the DSA tagger left on a LAN frame names the jack that frame
+	 * is for.  eth->lan_tx_port is only what a frame with no tag gets, and
+	 * what the debugfs "txp" knob turns.
+	 */
+	if (ndev == hw_ndev)
+		tx_port = zx279133_tx_port;
+	else
+		tx_port = lan_out_port ? lan_out_port : eth->lan_tx_port;
+
+	dma = dma_map_single(eth->dev, skb->data, skb->len, DMA_TO_DEVICE);
+	if (dma_mapping_error(eth->dev, dma))
+		goto drop;
+
+	spin_lock_bh(&eth->tx_lock);
+	if (zx279133_tx_available_locked(eth) &&
+	    unlikely(tx->pending >= ZX279133_IDM_TX_DEPTH - 1))
+		zx279133_idm_tx_reclaim_queue_locked(eth, queue);
+	if (unlikely(!zx279133_tx_available_locked(eth) ||
+		     tx->pending >= ZX279133_IDM_TX_DEPTH - 1)) {
+		netif_stop_subqueue(ndev, queue);
+		txq_trans_update(ndev, txq);
+		if (zx279133_tx_available_locked(eth))
+			zx279133_idm_tx_flush_queue_locked(eth, queue);
+		spin_unlock_bh(&eth->tx_lock);
+		dma_unmap_single(eth->dev, dma, skb->len, DMA_TO_DEVICE);
+		zx279133_stats_tx_dropped(eth, ndev);
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+
+	producer = tx->producer;
+	desc = eth->tx_descs + (ZX279133_IDM_CPU_TX_FIRST + queue) *
+		ZX279133_IDM_TX_DEPTH + producer;
+	slot = &tx->slots[producer];
+	memset(desc, 0, sizeof(*desc));
+	desc->address = cpu_to_le32(lower_32_bits(dma));
+	{
+		u32 length_flags = (skb->len << 1) |
+				   (zx279133_tx_selector & 0xff) << 24 |
+				   (zx279133_tx_word4_bit23 ? BIT(23) : 0);
+		u32 metadata0 = ZX279133_IDM_TX_CONTROL |
+				(tx_port & 0xff) << 16;
+
+		if (hw_csum) {
+			length_flags |= BIT(15);
+			metadata0 |= (skb_network_offset(skb) * 2) & 0x7f;
+			metadata0 |= ((skb_transport_offset(skb) * 2) & 0x7f) << 8;
+		}
+		desc->length_flags = cpu_to_le32(length_flags);
+		desc->metadata[0] = cpu_to_le32(metadata0);
+	}
+	desc->metadata[4] = cpu_to_le32(ndev != hw_ndev ? eth->lan_tx_word4 :
+					   zx279133_tx_pon_control);
+	slot->skb = skb;
+	slot->ndev = ndev;
+	slot->dma = dma;
+	slot->len = skb->len;
+	slot->dma_mapped = true;
+	if (hw_csum)
+		eth->tx_hw_csum_packets++;
+	else if (sw_csum) {
+		eth->tx_sw_csum_packets++;
+		eth->tx_csum_fallback[csum_reason]++;
+	}
+	arm_reclaim = !tx->pending;
+	tx->producer = (tx->producer + 1) &
+				   (ZX279133_IDM_TX_DEPTH - 1);
+	tx->pending++;
+	tx->notify_pending++;
+	if (tx->pending >= ZX279133_IDM_TX_DEPTH - 1) {
+		netif_stop_subqueue(ndev, queue);
+		txq_trans_update(ndev, txq);
+	}
+	if (__netdev_tx_sent_queue(txq, skb->len, netdev_xmit_more()))
+		zx279133_idm_tx_flush_queue_locked(eth, queue);
+	spin_unlock_bh(&eth->tx_lock);
+
+	if (arm_reclaim)
+		mod_delayed_work(system_wq, &eth->tx_reclaim_work,
+				 msecs_to_jiffies(ZX279133_TX_RECLAIM_DELAY_MS));
+
+	return NETDEV_TX_OK;
+
+drop:
+	spin_lock_bh(&eth->tx_lock);
+	if (zx279133_tx_available_locked(eth))
+		zx279133_idm_tx_flush_queue_locked(eth, queue);
+	spin_unlock_bh(&eth->tx_lock);
+	zx279133_stats_tx_dropped(eth, ndev);
+	dev_kfree_skb_any(skb);
+	return NETDEV_TX_OK;
+}
+
+static netdev_tx_t zx279133_start_xmit(struct sk_buff *skb,
+				       struct net_device *ndev)
+{
+	/* Not a LAN frame, so no jack is named and the LAN output port does
+	 * not apply to it.
+	 */
+	return zx279133_start_xmit_common(skb, ndev, ndev, 0);
+}
+
+int zx279133_xdp_enqueue(struct zx279133_eth *eth, struct xdp_frame *xdpf)
+{
+	struct zx279133_tx_ring *tx = &eth->tx[0];
+	struct zx279133_idm_desc *desc;
+	struct zx279133_tx_slot *slot;
+	dma_addr_t dma;
+	u16 producer;
+	bool arm_reclaim;
+	bool dma_mapped;
+
+	if (unlikely(xdp_frame_has_frags(xdpf) || xdpf->len < ETH_HLEN ||
+		     xdpf->len > ZX279133_IDM_RX_FRAME_LIMIT))
+		return -EOPNOTSUPP;
+	if (unlikely(!READ_ONCE(eth->tx_prepared) ||
+		     READ_ONCE(eth->tx_stopping)))
+		return -ENETDOWN;
+
+	if (xdpf->mem_type == MEM_TYPE_PAGE_POOL &&
+	    (netmem_get_pp(virt_to_netmem(xdpf->data)) == eth->rx_page_pool ||
+	     netmem_get_pp(virt_to_netmem(xdpf->data)) == eth->lan_rx_page_pool)) {
+		struct page *page = virt_to_page(xdpf->data);
+		dma_addr_t page_dma = page_pool_get_dma_addr(page);
+		unsigned int offset = offset_in_page(xdpf->data);
+
+		dma_sync_single_range_for_device(eth->dev, page_dma, offset,
+						 xdpf->len, DMA_BIDIRECTIONAL);
+		dma = page_dma + offset;
+		dma_mapped = false;
+	} else {
+		dma = dma_map_single(eth->dev, xdpf->data, xdpf->len,
+				     DMA_TO_DEVICE);
+		if (dma_mapping_error(eth->dev, dma))
+			return -ENOMEM;
+		dma_mapped = true;
+	}
+
+	spin_lock_bh(&eth->tx_lock);
+	if (zx279133_tx_available_locked(eth) &&
+	    unlikely(tx->pending >= ZX279133_IDM_TX_DEPTH - 1))
+		zx279133_idm_tx_reclaim_queue_locked(eth, 0);
+	if (unlikely(!zx279133_tx_available_locked(eth) ||
+		     tx->pending >= ZX279133_IDM_TX_DEPTH - 1)) {
+		int ret = zx279133_tx_available_locked(eth) ? -ENOSPC : -ENETDOWN;
+
+		spin_unlock_bh(&eth->tx_lock);
+		if (dma_mapped)
+			dma_unmap_single(eth->dev, dma, xdpf->len,
+					 DMA_TO_DEVICE);
+		return ret;
+	}
+
+	producer = tx->producer;
+	desc = eth->tx_descs + ZX279133_IDM_CPU_TX_FIRST *
+		ZX279133_IDM_TX_DEPTH + producer;
+	slot = &tx->slots[producer];
+	memset(desc, 0, sizeof(*desc));
+	desc->address = cpu_to_le32(lower_32_bits(dma));
+	desc->length_flags = cpu_to_le32((xdpf->len << 1) |
+					 (zx279133_tx_selector & 0xff) << 24 |
+					 (zx279133_tx_word4_bit23 ? BIT(23) : 0));
+	desc->metadata[0] = cpu_to_le32(ZX279133_IDM_TX_CONTROL |
+					       (zx279133_tx_port & 0xff) << 16);
+	desc->metadata[4] = cpu_to_le32(zx279133_tx_pon_control);
+	slot->xdpf = xdpf;
+	slot->ndev = eth->ndev;
+	slot->dma = dma;
+	slot->len = xdpf->len;
+	slot->dma_mapped = dma_mapped;
+	arm_reclaim = !tx->pending;
+	tx->producer = (tx->producer + 1) &
+				   (ZX279133_IDM_TX_DEPTH - 1);
+	tx->pending++;
+	tx->notify_pending++;
+	spin_unlock_bh(&eth->tx_lock);
+
+	if (arm_reclaim)
+		mod_delayed_work(system_wq, &eth->tx_reclaim_work,
+				 msecs_to_jiffies(ZX279133_TX_RECLAIM_DELAY_MS));
+
+	return 0;
+}
+
+int zx279133_xsk_rx_enqueue(struct zx279133_eth *eth, struct xdp_buff *xdp)
+{
+	struct zx279133_tx_ring *tx = &eth->tx[0];
+	struct zx279133_idm_desc *desc;
+	struct zx279133_tx_slot *slot;
+	void *dma_data = xdp->data_hard_start + XDP_PACKET_HEADROOM;
+	dma_addr_t dma;
+	long dma_offset;
+	u32 len;
+	u16 producer;
+	bool arm_reclaim;
+
+	len = xdp->data_end - xdp->data;
+	if (unlikely(xdp_buff_has_frags(xdp) || len < ETH_HLEN ||
+		     len > ZX279133_IDM_RX_FRAME_LIMIT))
+		return -EOPNOTSUPP;
+	if (unlikely(!READ_ONCE(eth->tx_prepared) ||
+		     READ_ONCE(eth->tx_stopping)))
+		return -ENETDOWN;
+
+	dma_offset = xdp->data - dma_data;
+	dma = xsk_buff_xdp_get_dma(xdp) + dma_offset;
+	if (unlikely(upper_32_bits(dma)))
+		return -ERANGE;
+	xsk_buff_raw_dma_sync_for_device(eth->xsk_pool, dma, len);
+
+	spin_lock_bh(&eth->tx_lock);
+	if (zx279133_tx_available_locked(eth) &&
+	    unlikely(tx->pending >= ZX279133_IDM_TX_DEPTH - 1))
+		zx279133_idm_tx_reclaim_queue_locked(eth, 0);
+	if (unlikely(!zx279133_tx_available_locked(eth) ||
+		     tx->pending >= ZX279133_IDM_TX_DEPTH - 1)) {
+		int ret = zx279133_tx_available_locked(eth) ? -ENOSPC : -ENETDOWN;
+
+		spin_unlock_bh(&eth->tx_lock);
+		return ret;
+	}
+
+	producer = tx->producer;
+	desc = eth->tx_descs + ZX279133_IDM_CPU_TX_FIRST *
+		ZX279133_IDM_TX_DEPTH + producer;
+	slot = &tx->slots[producer];
+	memset(desc, 0, sizeof(*desc));
+	desc->address = cpu_to_le32(lower_32_bits(dma));
+	desc->length_flags = cpu_to_le32((len << 1) |
+					 (zx279133_tx_selector & 0xff) << 24 |
+					 (zx279133_tx_word4_bit23 ? BIT(23) : 0));
+	desc->metadata[0] = cpu_to_le32(ZX279133_IDM_TX_CONTROL |
+					       (zx279133_tx_port & 0xff) << 16);
+	desc->metadata[4] = cpu_to_le32(zx279133_tx_pon_control);
+	slot->xsk_rx = xdp;
+	slot->ndev = eth->ndev;
+	slot->dma = dma;
+	slot->len = len;
+	arm_reclaim = !tx->pending;
+	tx->producer = (tx->producer + 1) &
+				   (ZX279133_IDM_TX_DEPTH - 1);
+	tx->pending++;
+	tx->notify_pending++;
+	spin_unlock_bh(&eth->tx_lock);
+
+	if (arm_reclaim)
+		mod_delayed_work(system_wq, &eth->tx_reclaim_work,
+				 msecs_to_jiffies(ZX279133_TX_RECLAIM_DELAY_MS));
+
+	return 0;
+}
+
+void zx279133_xsk_tx(struct zx279133_eth *eth)
+{
+	struct zx279133_tx_ring *tx = &eth->tx[0];
+	struct xsk_buff_pool *pool = READ_ONCE(eth->xsk_pool);
+	unsigned int dropped = 0;
+	bool ring_full = false;
+	bool queued = false;
+
+	if (!pool || !READ_ONCE(eth->tx_prepared) ||
+	    READ_ONCE(eth->tx_stopping))
+		return;
+
+	spin_lock_bh(&eth->tx_lock);
+	if (!zx279133_tx_available_locked(eth)) {
+		spin_unlock_bh(&eth->tx_lock);
+		return;
+	}
+	zx279133_idm_tx_reclaim_queue_locked(eth, 0);
+	if (!zx279133_tx_available_locked(eth)) {
+		spin_unlock_bh(&eth->tx_lock);
+		return;
+	}
+	while (tx->pending < ZX279133_IDM_TX_DEPTH - 1) {
+		struct zx279133_idm_desc *desc;
+		struct zx279133_tx_slot *slot;
+		struct xdp_desc xdp_desc;
+		dma_addr_t dma;
+		u16 producer;
+
+		if (!xsk_tx_peek_desc(pool, &xdp_desc))
+			break;
+		if (unlikely(!xsk_is_eop_desc(&xdp_desc) ||
+			     xdp_desc.len < ETH_HLEN ||
+			     xdp_desc.len > ZX279133_IDM_RX_FRAME_LIMIT)) {
+			xsk_tx_release(pool);
+			dropped++;
+			continue;
+		}
+
+		dma = xsk_buff_raw_get_dma(pool, xdp_desc.addr);
+		if (unlikely(upper_32_bits(dma))) {
+			xsk_tx_release(pool);
+			dropped++;
+			continue;
+		}
+		xsk_buff_raw_dma_sync_for_device(pool, dma, xdp_desc.len);
+
+		producer = tx->producer;
+		desc = eth->tx_descs + ZX279133_IDM_CPU_TX_FIRST *
+			ZX279133_IDM_TX_DEPTH + producer;
+		slot = &tx->slots[producer];
+		memset(desc, 0, sizeof(*desc));
+		desc->address = cpu_to_le32(lower_32_bits(dma));
+		desc->length_flags =
+			cpu_to_le32((xdp_desc.len << 1) |
+				    (zx279133_tx_selector & 0xff) << 24 |
+				    (zx279133_tx_word4_bit23 ? BIT(23) : 0));
+		desc->metadata[0] =
+			cpu_to_le32(ZX279133_IDM_TX_CONTROL |
+				    (zx279133_tx_port & 0xff) << 16);
+		desc->metadata[4] = cpu_to_le32(zx279133_tx_pon_control);
+		slot->ndev = eth->ndev;
+		slot->dma = dma;
+		slot->len = xdp_desc.len;
+		slot->xsk_tx = true;
+		tx->producer = (tx->producer + 1) &
+					   (ZX279133_IDM_TX_DEPTH - 1);
+		tx->pending++;
+		tx->notify_pending++;
+		xsk_tx_release(pool);
+		queued = true;
+	}
+	ring_full = tx->pending >= ZX279133_IDM_TX_DEPTH - 1;
+	if (queued)
+		zx279133_idm_tx_flush_queue_locked(eth, 0);
+	spin_unlock_bh(&eth->tx_lock);
+
+	if (dropped) {
+		xsk_tx_completed(pool, dropped);
+		while (dropped--)
+			zx279133_stats_tx_dropped(eth, eth->ndev);
+	}
+	if (xsk_uses_need_wakeup(pool)) {
+		if (ring_full)
+			xsk_clear_tx_need_wakeup(pool);
+		else
+			xsk_set_tx_need_wakeup(pool);
+	}
+	if (queued)
+		mod_delayed_work(system_wq, &eth->tx_reclaim_work,
+				 msecs_to_jiffies(ZX279133_TX_RECLAIM_DELAY_MS));
+}
+
+void zx279133_xdp_flush(struct zx279133_eth *eth)
+{
+	spin_lock_bh(&eth->tx_lock);
+	if (zx279133_tx_available_locked(eth))
+		zx279133_idm_tx_flush_locked(eth);
+	spin_unlock_bh(&eth->tx_lock);
+}
+
+static int zx279133_xdp_xmit(struct net_device *ndev, int n,
+			     struct xdp_frame **frames, u32 flags)
+{
+	struct zx279133_eth *eth = netdev_priv(ndev);
+	int nxmit = 0;
+	int ret = 0;
+
+	if (unlikely(flags & ~XDP_XMIT_FLAGS_MASK))
+		return -EINVAL;
+	if (unlikely(!netif_running(ndev)))
+		return -ENETDOWN;
+
+	while (nxmit < n) {
+		ret = zx279133_xdp_enqueue(eth, frames[nxmit]);
+		if (ret)
+			break;
+		nxmit++;
+	}
+	if (flags & XDP_XMIT_FLUSH)
+		zx279133_xdp_flush(eth);
+
+	return nxmit ?: ret;
+}
+
+/* Caller holds datapath_lock across suspend, configuration and resume. */
+static void zx279133_datapath_suspend(struct zx279133_eth *eth)
+{
+	bool tx_quiesced;
+
+	zx279133_lan_mmio_set(eth, false);
+	netif_device_detach(eth->ndev);
+	if (eth->lan_ndev) {
+		netif_device_detach(eth->lan_ndev);
+		netif_carrier_off(eth->lan_ndev);
+	}
+	if (!eth->hardware_prepared) {
+		WRITE_ONCE(eth->datapath_failed, true);
+		return;
+	}
+	zx279133_shared_rx_stop(eth);
+	tx_quiesced = zx279133_shared_tx_pause(eth);
+	zx279133_wan_phylink_stop(eth);
+	zx279133_shared_idm_release(eth, eth->ndev, tx_quiesced);
+	WRITE_ONCE(eth->datapath_failed, true);
+}
+
+static int zx279133_datapath_resume(struct zx279133_eth *eth, bool require_hash)
+{
+	int ret;
+
+	ret = zx279133_hardware_prepare(eth);
+	if (!ret && require_hash && !eth->rx_hash_active)
+		ret = -EOPNOTSUPP;
+	if (!ret)
+		ret = zx279133_shared_idm_prepare(eth);
+	if (ret) {
+		if (READ_ONCE(eth->hardware_prepared))
+			zx279133_hardware_unprepare(eth);
+		WRITE_ONCE(eth->datapath_failed, true);
+		spin_lock_bh(&eth->tx_lock);
+		WRITE_ONCE(eth->tx_stopping, true);
+		spin_unlock_bh(&eth->tx_lock);
+		return ret;
+	}
+	WRITE_ONCE(eth->datapath_failed, false);
+	if (eth->datapath_users & ZX279133_DATAPATH_USER_WAN)
+		zx279133_wan_phylink_start(eth);
+	zx279133_shared_rx_start(eth);
+	zx279133_lan_mmio_set(eth, true);
+	zx279133_shared_tx_resume(eth);
+	zx279133_datapath_attach(eth);
+	return 0;
+}
+
+static int zx279133_datapath_restore_failed_locked(struct zx279133_eth *eth)
+{
+	int ret;
+
+	if (!eth->datapath_failed || !eth->datapath_users)
+		return 0;
+	ret = zx279133_datapath_resume(eth, false);
+	if (!ret) {
+		spin_lock_bh(&eth->tx_lock);
+		eth->tx_recovery_attempted = false;
+		spin_unlock_bh(&eth->tx_lock);
+	}
+	return ret;
+}
+
+static void zx279133_tx_recovery_work(struct work_struct *work)
+{
+	struct zx279133_eth *eth =
+		container_of(to_delayed_work(work), struct zx279133_eth,
+			     tx_recovery_work);
+	unsigned long queues;
+	bool restart, needed = false;
+	unsigned int i;
+	int ret;
+
+	/* ndo_stop and unregister may hold RTNL while cancelling other work.
+	 * Never wait for RTNL here, including during device teardown.
+	 */
+	if (!rtnl_trylock()) {
+		spin_lock_bh(&eth->tx_lock);
+		if (!eth->tx_recovery_disabled && eth->tx_recovery_queues)
+			mod_delayed_work(system_wq, &eth->tx_recovery_work,
+					 msecs_to_jiffies(100));
+		spin_unlock_bh(&eth->tx_lock);
+		return;
+	}
+	mutex_lock(&eth->datapath_lock);
+	spin_lock_bh(&eth->tx_lock);
+	queues = eth->tx_recovery_queues;
+	if (eth->tx_recovery_disabled || !queues ||
+	    eth->tx_recovery_epoch != eth->tx_epoch ||
+	    !eth->datapath_users || !eth->hardware_prepared ||
+	    !eth->tx_prepared || eth->datapath_failed) {
+		eth->tx_recovery_queues = 0;
+		goto out_tx_unlock;
+	}
+	eth->tx_recovery_active = true;
+	for (i = 0; i < ZX279133_CPU_TX_QUEUES; i++) {
+		if (!(queues & BIT(i)))
+			continue;
+		if (!(eth->tx_fault_queues & BIT(i))) {
+			zx279133_idm_tx_flush_queue_locked(eth, i);
+			zx279133_idm_tx_reclaim_queue_locked(eth, i);
+		}
+		if ((eth->tx_fault_queues & BIT(i)) ||
+		    (eth->tx[i].pending &&
+		     eth->tx[i].done == eth->tx_recovery_done[i]))
+			needed = true;
+	}
+	eth->tx_recovery_queues = 0;
+	if (!needed) {
+		eth->tx_recovery_active = false;
+		spin_unlock_bh(&eth->tx_lock);
+		/* A failed LAN quiesce may have requested recovery while paused.
+		 * Progress can make a restart unnecessary, but WAN still needs TX.
+		 */
+		zx279133_shared_tx_resume(eth);
+		goto out_unlock;
+	}
+	if (eth->tx_recovery_attempted)
+		for (i = 0; i < ZX279133_CPU_TX_QUEUES; i++)
+			if (eth->tx[i].completed != eth->tx_recovery_baseline[i]) {
+				eth->tx_recovery_attempted = false;
+				break;
+			}
+	restart = !eth->tx_recovery_attempted;
+	eth->tx_recovery_attempted = true;
+	spin_unlock_bh(&eth->tx_lock);
+
+	zx279133_datapath_suspend(eth);
+	/* Without a valid completion since the previous restart, stop safely
+	 * instead of turning repeated watchdog notifications into a reset loop.
+	 */
+	ret = restart ? zx279133_datapath_resume(eth, false) : -EIO;
+	spin_lock_bh(&eth->tx_lock);
+	if (ret)
+		eth->tx_recovery_failures++;
+	else
+		eth->tx_recovery_restarts++;
+	eth->tx_recovery_active = false;
+	/* A new fault may have arrived after resume enabled NAPI again. */
+	if (!ret && eth->tx_fault_queues && !eth->tx_recovery_disabled)
+		zx279133_tx_recovery_queue_locked(eth, eth->tx_fault_queues);
+	spin_unlock_bh(&eth->tx_lock);
+	if (ret)
+		netdev_err(eth->ndev,
+			   "shared TX recovery failed (%d); datapath detached until down/up\n",
+			   ret);
+	else
+		netdev_warn(eth->ndev, "shared TX datapath restarted\n");
+	goto out_unlock;
+
+out_tx_unlock:
+	spin_unlock_bh(&eth->tx_lock);
+out_unlock:
+	mutex_unlock(&eth->datapath_lock);
+	rtnl_unlock();
+}
+
+static int zx279133_xsk_pool_cycle(struct zx279133_eth *eth,
+				   struct xsk_buff_pool *pool)
+{
+	struct xsk_buff_pool *old_pool = READ_ONCE(eth->xsk_pool);
+	bool idle = false;
+	int restore;
+	int ret;
+
+	if (pool == old_pool)
+		return 0;
+	if (pool && xsk_pool_get_rx_frame_size(pool) < ZX279133_IDM_RX_DMA_SIZE) {
+		netdev_err(eth->ndev,
+			   "AF_XDP RX needs %u DMA bytes after headroom; use 4096-byte chunks\n",
+			   (unsigned int)ZX279133_IDM_RX_DMA_SIZE);
+		return -EINVAL;
+	}
+	if (pool) {
+		xsk_pool_set_rxq_info(pool, &eth->xsk_rxq);
+		ret = xsk_pool_dma_map(pool, eth->dev, DMA_ATTR_SKIP_CPU_SYNC);
+		if (ret)
+			return ret;
+	}
+
+	mutex_lock(&eth->datapath_lock);
+	if (!eth->datapath_users) {
+		WRITE_ONCE(eth->xsk_pool, pool);
+		idle = true;
+		mutex_unlock(&eth->datapath_lock);
+		goto out_unmap_old;
+	}
+
+	zx279133_datapath_suspend(eth);
+	WRITE_ONCE(eth->xsk_pool, pool);
+	ret = zx279133_datapath_resume(eth, false);
+	if (!ret) {
+		mutex_unlock(&eth->datapath_lock);
+		goto out_unmap_old;
+	}
+
+	WRITE_ONCE(eth->xsk_pool, old_pool);
+	restore = zx279133_datapath_resume(eth, false);
+	if (restore) {
+		netdev_err(eth->ndev,
+			   "failed to restore datapath after XSK pool setup: %d\n",
+			   restore);
+	}
+	mutex_unlock(&eth->datapath_lock);
+	if (pool)
+		xsk_pool_dma_unmap(pool, DMA_ATTR_SKIP_CPU_SYNC);
+	return ret;
+
+out_unmap_old:
+	if (old_pool)
+		xsk_pool_dma_unmap(old_pool, DMA_ATTR_SKIP_CPU_SYNC);
+	if (pool && xsk_uses_need_wakeup(pool)) {
+		if (idle)
+			xsk_set_rx_need_wakeup(pool);
+		xsk_set_tx_need_wakeup(pool);
+	}
+	return 0;
+}
+
+static int zx279133_xdp(struct net_device *ndev, struct netdev_bpf *bpf)
+{
+	struct zx279133_eth *eth = netdev_priv(ndev);
+	struct bpf_prog *old_prog;
+
+	switch (bpf->command) {
+	case XDP_SETUP_PROG:
+		break;
+	case XDP_SETUP_XSK_POOL:
+		if (bpf->xsk.queue_id)
+			return -EINVAL;
+		return zx279133_xsk_pool_cycle(eth, bpf->xsk.pool);
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	old_prog = rcu_replace_pointer(eth->xdp_prog, bpf->prog,
+				       lockdep_rtnl_is_held());
+	if (old_prog)
+		bpf_prog_put(old_prog);
+
+	return 0;
+}
+
+static int zx279133_xsk_wakeup(struct net_device *ndev, u32 queue_id,
+			       u32 flags)
+{
+	struct zx279133_eth *eth = netdev_priv(ndev);
+
+	if (queue_id || !READ_ONCE(eth->xsk_pool))
+		return -EINVAL;
+	if (!READ_ONCE(eth->rx_running) || !READ_ONCE(eth->napi_enabled))
+		return -ENETDOWN;
+	if (!napi_if_scheduled_mark_missed(&eth->napi))
+		napi_schedule(&eth->napi);
+
+	return 0;
+}
+
+static void zx279133_tx_timeout_common(struct zx279133_eth *eth,
+				       struct net_device *ndev,
+				       unsigned int txqueue)
+{
+	struct zx279133_tx_ring *tx;
+	u16 done_before = 0, done_after = 0;
+	u16 pending_before = 0, pending_after = 0;
+	u16 producer = 0, consumer = 0, notify = 0;
+	unsigned int reclaimed = 0;
+	u32 int_mask = 0;
+	bool prepared, stopping;
+
+	if (txqueue >= ZX279133_CPU_TX_QUEUES)
+		return;
+	tx = &eth->tx[txqueue];
+
+	spin_lock_bh(&eth->tx_lock);
+	if (!tx->pending) {
+		spin_unlock_bh(&eth->tx_lock);
+		return;
+	}
+	eth->tx_timeouts++;
+	prepared = READ_ONCE(eth->hardware_prepared);
+	stopping = READ_ONCE(eth->tx_stopping);
+	if (prepared && !stopping) {
+		void __iomem *idm = eth->base + ZX279133_IDM_BASE;
+
+		done_before = readl(idm +
+				    zx279133_idm_tx_done_reg(ZX279133_IDM_CPU_TX_FIRST + txqueue)) &
+			      0xffff;
+		pending_before = tx->pending;
+		producer = tx->producer;
+		consumer = tx->consumer;
+		notify = tx->notify_pending;
+		int_mask = readl(idm + ZX279133_IDM_INT_MASK);
+		zx279133_idm_tx_flush_queue_locked(eth, txqueue);
+		reclaimed = zx279133_idm_tx_reclaim_queue_locked(eth, txqueue);
+		done_after = tx->done;
+		pending_after = tx->pending;
+		if (reclaimed)
+			eth->tx_timeout_recoveries++;
+		else if (pending_after) {
+			eth->tx_timeout_stalls++;
+			zx279133_tx_recovery_request_locked(eth, txqueue, false);
+		}
+	}
+	spin_unlock_bh(&eth->tx_lock);
+
+	zx279133_stats_tx_error(eth, ndev);
+	/* Both logical devices share each physical ring. Keep either watchdog
+	 * from immediately retriggering after the common recovery attempt.
+	 */
+	txq_trans_update(eth->ndev, netdev_get_tx_queue(eth->ndev, txqueue));
+	if (eth->lan_ndev)
+		txq_trans_update(eth->lan_ndev,
+				 netdev_get_tx_queue(eth->lan_ndev, txqueue));
+
+	if (!prepared || stopping) {
+		netdev_warn(ndev,
+			    "TX timeout while datapath unavailable (prepared=%u stopping=%u)\n",
+			    prepared, stopping);
+		return;
+	}
+
+	if (reclaimed || !pending_after) {
+		netdev_warn(ndev,
+			    "TX timeout recovered: reclaimed=%u pending=%u->%u done=%#x->%#x prod=%u cons=%u notify=%u mask=%#x\n",
+			    reclaimed, pending_before, pending_after,
+			    done_before, done_after, producer, consumer, notify,
+			    int_mask);
+		return;
+	}
+
+	netdev_err(ndev,
+		   "TX timeout stalled: pending=%u done=%#x prod=%u cons=%u notify=%u mask=%#x\n",
+		   pending_after, done_after, producer, consumer, notify,
+		   int_mask);
+}
+
+static void zx279133_tx_timeout(struct net_device *ndev,
+				unsigned int txqueue)
+{
+	zx279133_tx_timeout_common(netdev_priv(ndev), ndev, txqueue);
+}
