+++ b/drivers/net/ethernet/zte/zx279133-omci.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Raw baseline XG-PON OMCI submission through the dedicated IDM queue 0.
+ * The optical MAC activation, OMCC provisioning and integrity key lifecycle
+ * are separate prerequisites, not inferred from an Ethernet carrier bit.
+ */
+#include <linux/iopoll.h>
+#include "zx279133.h"
+#include "zx279133-omci-wire.h"
+
+void zx279133_omci_reclaim(struct zx279133_eth *eth)
+{
+	u16 done;
+
+	if (!eth->omci_pending)
+		return;
+	done = readl(eth->base + ZX279133_IDM_BASE +
+		     zx279133_idm_tx_done_reg(0)) & 0xffff;
+	if (done == eth->omci_done)
+		return;
+	/* There is at most one outstanding management descriptor. */
+	dma_rmb();
+	eth->omci_pending = false;
+	eth->omci_completed++;
+	eth->omci_done = done;
+}
+
+int zx279133_omci_prepare(struct zx279133_eth *eth)
+{
+	zx279133_omci_reclaim(eth);
+	if (eth->omci_pending)
+		return -EBUSY;
+	eth->omci_done = readl(eth->base + ZX279133_IDM_BASE +
+			      zx279133_idm_tx_done_reg(0)) & 0xffff;
+	eth->omci_producer = eth->omci_done & (ZX279133_IDM_TX_DEPTH - 1);
+	return 0;
+}
+
+int zx279133_omci_send(struct zx279133_eth *eth, u16 gem,
+			const u8 *frame, size_t length)
+{
+	struct zx279133_idm_desc *descriptor;
+	u32 done;
+	int result;
+
+	if (length != 48 || gem >= 0xfffe)
+		return -EINVAL;
+	mutex_lock(&eth->datapath_lock);
+	if (!eth->tx_prepared || eth->tx_stopping) {
+		result = -ENETDOWN;
+		goto out;
+	}
+	zx279133_omci_reclaim(eth);
+	if (eth->omci_pending) {
+		result = -EBUSY;
+		goto out;
+	}
+	if (!eth->omci_buffer) {
+		eth->omci_buffer = dmam_alloc_coherent(eth->dev, 48,
+						      &eth->omci_dma, GFP_KERNEL);
+		if (!eth->omci_buffer) {
+			result = -ENOMEM;
+			goto out;
+		}
+		if (upper_32_bits(eth->omci_dma)) {
+			result = -ERANGE;
+			goto out;
+		}
+	}
+	if (upper_32_bits(eth->omci_dma)) {
+		result = -ERANGE;
+		goto out;
+	}
+	memcpy(eth->omci_buffer, frame, 48);
+	/* The reserved first ring is already covered by tx_descs' coherent DMA
+	 * allocation. Do not pad to ETH_ZLEN or use LAN/PON data metadata.
+	 */
+	descriptor = eth->tx_descs + eth->omci_producer;
+	memset(descriptor, 0, sizeof(*descriptor));
+	descriptor->address = cpu_to_le32(lower_32_bits(eth->omci_dma));
+	descriptor->length_flags = cpu_to_le32(zx279133_omci_length_word(48));
+	descriptor->metadata[0] = cpu_to_le32(zx279133_omci_control_word());
+	descriptor->metadata[4] = cpu_to_le32(zx279133_omci_gem_word(gem));
+	eth->omci_pending = true;
+	eth->omci_producer = (eth->omci_producer + 1) & (ZX279133_IDM_TX_DEPTH - 1);
+	wmb();
+	writel(1 << ZX279133_IDM_TX_DOORBELL_COUNT_SHIFT,
+	       eth->base + ZX279133_IDM_BASE + zx279133_idm_tx_doorbell_reg(0));
+	eth->omci_submitted++;
+	result = readl_poll_timeout(eth->base + ZX279133_IDM_BASE +
+				    zx279133_idm_tx_done_reg(0), done,
+				    (u16)done != eth->omci_done, 100, 20000);
+	/* On timeout keep both the descriptor and coherent payload alive. A
+	 * later call/drain reclaims it only after the hardware counter advances.
+	 */
+	if (!result)
+		zx279133_omci_reclaim(eth);
+out:
+	eth->omci_error = result;
+	mutex_unlock(&eth->datapath_lock);
+	/* 0 means IDM consumed the descriptor, NOT that an OLT accepted it. */
+	return result;
+}
--- /dev/null
+++ b/drivers/net/ethernet/zte/zx279133-pon.c
@@ -0,0 +1,408 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * XG-PON activation glue for the ZX279133 WAN netdev.
+ *
+ * The 49-word xgpon_nsyn image is not programmed. The vendor modules on
+ * hand have mode_xgpon_nsyn_cfg, not mode_xgpon_nsyn_cfg_133, so that
+ * image is not the one this board is allowed to write. The same rule
+ * keeps the 0x17000000 PON MAC window untouched: a register is written
+ * only when a Hal_WritePonGreg / Hal_WriteXmacReg trace names it, and
+ * there is no such trace checked in here.
+ *
+ * What this file does is the part that can be true with no fibre:
+ * the activation state starts at O1, eth0's carrier follows O5, the
+ * red LOS input moves the state, and userspace can name one data GEM.
+ */
+
+#include <linux/etherdevice.h>
+#include <linux/if_arp.h>
+#include <linux/leds.h>
+#include <net/genetlink.h>
+#include <net/netlink.h>
+
+#include "zx279133.h"
+#include "zxpon.h"
+
+static const struct nla_policy zxpon_policy[ZXPON_A_MAX] = {
+	[ZXPON_A_STATE] = { .type = NLA_NUL_STRING },
+	[ZXPON_A_SN] = NLA_POLICY_EXACT_LEN(ZXPON_SN_LEN),
+	[ZXPON_A_REGID] = NLA_POLICY_EXACT_LEN(ZXPON_REGID_LEN),
+	[ZXPON_A_ALLOC] = { .type = NLA_U16 },
+	[ZXPON_A_GEM] = { .type = NLA_U16 },
+	[ZXPON_A_OMCC] = { .type = NLA_U8 },
+	[ZXPON_A_KEY] = NLA_POLICY_EXACT_LEN(ZXPON_KEY_LEN),
+	[ZXPON_A_OMCI_FRAME] = NLA_POLICY_EXACT_LEN(ZXPON_OMCI_LEN),
+};
+
+static struct zxpon zx_state;
+static DEFINE_MUTEX(zx_pon_lock);
+static struct net_device *zx_wan;
+static struct net_device *zx_omci;
+static struct led_trigger *zx_green;
+
+/*
+ * The family is filled in further down, next to the ops table that has to
+ * exist before it can be named - and the reply path below needs the family
+ * before that.  A tentative definition is the C way of saying "it comes
+ * later": the tentative one here, the real one next to zxpon_ops.
+ */
+static struct genl_family zxpon_family;
+static struct delayed_work zx_tick;
+static int zx_alive;
+static int zx_family_ok;
+static int zx_nb_ok;
+
+static void zxpon_apply_carrier(void)
+{
+	int o5;
+
+	mutex_lock(&zx_pon_lock);
+	o5 = zxpon_state(&zx_state) == ZXPON_O5;
+	mutex_unlock(&zx_pon_lock);
+	if (zx_wan) {
+		if (o5)
+			netif_carrier_on(zx_wan);
+		else if (netif_carrier_ok(zx_wan))
+			netif_carrier_off(zx_wan);
+	}
+	led_trigger_event(zx_green, o5 ? LED_FULL : LED_OFF);
+}
+
+static void zxpon_tick_work(struct work_struct *work)
+{
+	mutex_lock(&zx_pon_lock);
+	if (zx_alive)
+		zxpon_tick(&zx_state, 100);
+	mutex_unlock(&zx_pon_lock);
+	zxpon_apply_carrier();
+	if (zx_alive)
+		schedule_delayed_work(&zx_tick, msecs_to_jiffies(100));
+}
+
+static int zxpon_net_event(struct notifier_block *nb, unsigned long event, void *ptr)
+{
+	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+
+	if (!zx_wan || dev != zx_wan)
+		return NOTIFY_DONE;
+	if (event == NETDEV_CHANGE || event == NETDEV_UP)
+		zxpon_apply_carrier();
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block zxpon_net_nb = {
+	.notifier_call = zxpon_net_event,
+};
+
+static ssize_t pon_state_show(struct device *dev, struct device_attribute *attr,
+			      char *buf)
+{
+	const char *name;
+
+	mutex_lock(&zx_pon_lock);
+	name = zxpon_state_name(&zx_state);
+	mutex_unlock(&zx_pon_lock);
+	return sysfs_emit(buf, "%s\n", name);
+}
+static DEVICE_ATTR_RO(pon_state);
+
+static bool zxpon_omci_channel(u16 *gem)
+{
+	bool ready;
+
+	mutex_lock(&zx_pon_lock);
+	ready = zxpon_state(&zx_state) == ZXPON_O5 &&
+		zxpon_omcc_gem(&zx_state, gem);
+	mutex_unlock(&zx_pon_lock);
+	return ready;
+}
+
+static ssize_t omci_transport_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct zx279133_eth *eth = netdev_priv(to_net_dev(dev));
+	u16 gem;
+	bool ready = zxpon_omci_channel(&gem);
+	ssize_t length;
+
+	mutex_lock(&eth->datapath_lock);
+	ready = ready && eth->tx_prepared && !eth->tx_stopping;
+	length = sysfs_emit(buf, "implemented=1 ready=%u rx_ready=0 mic_ready=0 submitted=%llu completed=%llu error=%d\n",
+		ready, eth->omci_submitted, eth->omci_completed,
+		ready ? eth->omci_error : -ENOLINK);
+	mutex_unlock(&eth->datapath_lock);
+	return length;
+}
+static DEVICE_ATTR_RO(omci_transport);
+
+static int zxpon_get_state(struct sk_buff *skb, struct genl_info *info)
+{
+	struct sk_buff *msg;
+	void *hdr;
+	const char *name;
+
+	msg = genlmsg_new(NLMSG_GOODSIZE, GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+	hdr = genlmsg_put_reply(msg, info, &zxpon_family, 0, info->genlhdr->cmd);
+	if (!hdr) {
+		nlmsg_free(msg);
+		return -ENOMEM;
+	}
+	mutex_lock(&zx_pon_lock);
+	name = zxpon_state_name(&zx_state);
+	mutex_unlock(&zx_pon_lock);
+	if (nla_put_string(msg, ZXPON_A_STATE, name)) {
+		genlmsg_cancel(msg, hdr);
+		nlmsg_free(msg);
+		return -EMSGSIZE;
+	}
+	genlmsg_end(msg, hdr);
+	return genlmsg_reply(msg, info);
+}
+
+/*
+ * The netlink handler, not the setter: zxpon.c already owns
+ * zxpon_set_identity(zxpon *, sn, regid), and a handler with the same name
+ * made the two one function - the call below then read as "too many
+ * arguments to function 'zxpon_set_identity'" and the definition as a
+ * conflicting type.  The nl_ prefix says which of the two this is.
+ */
+static int zxpon_nl_set_identity(struct sk_buff *skb, struct genl_info *info)
+{
+	const uint8_t *sn, *regid;
+
+	if (!info->attrs[ZXPON_A_SN] || !info->attrs[ZXPON_A_REGID])
+		return -EINVAL;
+	sn = nla_data(info->attrs[ZXPON_A_SN]);
+	regid = nla_data(info->attrs[ZXPON_A_REGID]);
+	mutex_lock(&zx_pon_lock);
+	zxpon_set_identity(&zx_state, sn, regid);
+	mutex_unlock(&zx_pon_lock);
+	zxpon_apply_carrier();
+	return 0;
+}
+
+static int zxpon_add_tcont_cmd(struct sk_buff *skb, struct genl_info *info)
+{
+	/* No ZX279133 T-CONT table backend yet: do not ACK a software-only write. */
+	return -EOPNOTSUPP;
+}
+
+static int zxpon_map_cmd(struct sk_buff *skb, struct genl_info *info)
+{
+	return -EOPNOTSUPP;
+}
+
+static int zxpon_set_key_cmd(struct sk_buff *skb, struct genl_info *info)
+{
+	return -EOPNOTSUPP;
+}
+
+static int zxpon_omci_tx_cmd(struct sk_buff *skb, struct genl_info *info)
+{
+	const u8 *frame;
+	u16 gem;
+
+	if (!info->attrs[ZXPON_A_OMCI_FRAME])
+		return -EINVAL;
+	frame = nla_data(info->attrs[ZXPON_A_OMCI_FRAME]);
+	/* Baseline response/notification with an already supplied MIC. Extended
+	 * frames and physical-mode/key changes are not part of this transport.
+	 */
+	if (frame[3] != 0x0a || (frame[2] & 0xc0) ||
+	    frame[40] || frame[41] || frame[42] || frame[43] != 0x28)
+		return -EBADMSG;
+	if (!zx_wan || !zxpon_omci_channel(&gem))
+		return -ENOLINK;
+	return zx279133_omci_send(netdev_priv(zx_wan), gem, frame, ZXPON_OMCI_LEN);
+}
+
+static const struct genl_ops zxpon_ops[] = {
+	{
+		.cmd = ZXPON_CMD_OMCI_TX,
+		.flags = GENL_ADMIN_PERM,
+		.policy = zxpon_policy,
+		.doit = zxpon_omci_tx_cmd,
+	},
+	{
+		.cmd = ZXPON_CMD_GET_STATE,
+		.policy = zxpon_policy,
+		.doit = zxpon_get_state,
+	},
+	{
+		.cmd = ZXPON_CMD_SET_IDENTITY,
+		.flags = GENL_ADMIN_PERM,
+		.policy = zxpon_policy,
+		.doit = zxpon_nl_set_identity,
+	},
+	{
+		.cmd = ZXPON_CMD_ADD_TCONT,
+		.flags = GENL_ADMIN_PERM,
+		.policy = zxpon_policy,
+		.doit = zxpon_add_tcont_cmd,
+	},
+	{
+		.cmd = ZXPON_CMD_ADD_GEM,
+		.flags = GENL_ADMIN_PERM,
+		.policy = zxpon_policy,
+		.doit = zxpon_map_cmd,
+	},
+	{
+		.cmd = ZXPON_CMD_MAP_GEM,
+		.flags = GENL_ADMIN_PERM,
+		.policy = zxpon_policy,
+		.doit = zxpon_map_cmd,
+	},
+	{
+		.cmd = ZXPON_CMD_SET_KEY,
+		.flags = GENL_ADMIN_PERM,
+		.policy = zxpon_policy,
+		.doit = zxpon_set_key_cmd,
+	},
+};
+
+static struct genl_family zxpon_family = {
+	.name = "zxpon",
+	.version = 1,
+	.maxattr = ZXPON_A_MAX - 1,
+	.ops = zxpon_ops,
+	.n_ops = ARRAY_SIZE(zxpon_ops),
+	.resv_start_op = ZXPON_CMD_MAX,
+	.module = THIS_MODULE,
+};
+
+/* This netdev is the raw RX endpoint. TX uses the privileged zxpon OMCI_TX
+ * command, whose ACK follows IDM completion instead of packet-socket enqueue.
+ */
+static netdev_tx_t zxpon_omci_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	dev_kfree_skb(skb);
+	dev->stats.tx_dropped++;
+	dev->stats.tx_errors++;
+	return NETDEV_TX_OK;
+}
+
+static int zxpon_omci_open(struct net_device *dev)
+{
+	/* No Ethernet carrier is invented for the management endpoint. */
+	netif_carrier_off(dev);
+	netif_start_queue(dev);
+	return 0;
+}
+
+static int zxpon_omci_stop(struct net_device *dev)
+{
+	netif_stop_queue(dev);
+	netif_carrier_off(dev);
+	return 0;
+}
+
+static const struct net_device_ops zxpon_omci_ops = {
+	.ndo_open = zxpon_omci_open,
+	.ndo_stop = zxpon_omci_stop,
+	.ndo_start_xmit = zxpon_omci_xmit,
+};
+
+static void zxpon_omci_setup(struct net_device *dev)
+{
+	dev->netdev_ops = &zxpon_omci_ops;
+	dev->mtu = ZXPON_OMCI_LEN;
+	dev->min_mtu = ZXPON_OMCI_LEN;
+	dev->max_mtu = ZXPON_OMCI_LEN;
+	dev->hard_header_len = 0;
+	dev->addr_len = 0;
+	dev->type = ARPHRD_NONE;
+	dev->flags = IFF_POINTOPOINT | IFF_NOARP;
+	dev->priv_flags |= IFF_NO_QUEUE;
+	dev->needs_free_netdev = true;
+}
+
+void zx279133_pon_note_rxsd(int light)
+{
+	if (!zx_alive)
+		return;
+	mutex_lock(&zx_pon_lock);
+	zxpon_set_los(&zx_state, light ? 0 : 1);
+	mutex_unlock(&zx_pon_lock);
+	zxpon_apply_carrier();
+}
+
+void zx279133_pon_carrier_kick(struct net_device *ndev)
+{
+	if (!zx_alive)
+		return;
+	if (ndev)
+		zx_wan = ndev;
+	zxpon_apply_carrier();
+}
+
+void zx279133_pon_attach(struct net_device *ndev)
+{
+	int rc;
+
+	if (zx_alive)
+		return;
+	led_trigger_register_simple("zx279133-pon", &zx_green);
+	if (!zx_green)
+		dev_warn(&ndev->dev, "PON LED trigger unavailable\n");
+	zxpon_init(&zx_state);
+	zx_wan = ndev;
+	if (device_create_file(&ndev->dev, &dev_attr_pon_state))
+		dev_warn(&ndev->dev, "pon_state sysfs not created\n");
+	if (device_create_file(&ndev->dev, &dev_attr_omci_transport))
+		dev_warn(&ndev->dev, "omci_transport sysfs not created\n");
+	zx_omci = alloc_netdev(0, "omci", NET_NAME_UNKNOWN, zxpon_omci_setup);
+	if (zx_omci) {
+		zx_omci->dev.parent = ndev->dev.parent;
+		rc = register_netdev(zx_omci);
+		if (rc) {
+			free_netdev(zx_omci);
+			zx_omci = NULL;
+			dev_warn(&ndev->dev, "omci netdev failed: %d\n", rc);
+		}
+	}
+	if (!zx_family_ok) {
+		rc = genl_register_family(&zxpon_family);
+		if (!rc)
+			zx_family_ok = 1;
+		else
+			dev_warn(&ndev->dev, "zxpon genl failed: %d\n", rc);
+	}
+	rc = register_netdevice_notifier(&zxpon_net_nb);
+	if (rc)
+		dev_warn(&ndev->dev, "pon notifier failed: %d\n", rc);
+	else
+		zx_nb_ok = 1;
+	zx_alive = 1;
+	INIT_DELAYED_WORK(&zx_tick, zxpon_tick_work);
+	schedule_delayed_work(&zx_tick, msecs_to_jiffies(100));
+	zxpon_apply_carrier();
+}
+
+void zx279133_pon_stop(void)
+{
+	if (!zx_alive)
+		return;
+	zx_alive = 0;
+	cancel_delayed_work_sync(&zx_tick);
+	if (zx_nb_ok) {
+		unregister_netdevice_notifier(&zxpon_net_nb);
+		zx_nb_ok = 0;
+	}
+	if (zx_wan) {
+		device_remove_file(&zx_wan->dev, &dev_attr_pon_state);
+		device_remove_file(&zx_wan->dev, &dev_attr_omci_transport);
+	}
+	if (zx_omci) {
+		unregister_netdev(zx_omci);
+		zx_omci = NULL;
+	}
+	if (zx_family_ok) {
+		genl_unregister_family(&zxpon_family);
+		zx_family_ok = 0;
+	}
+	led_trigger_unregister_simple(zx_green);
+	zx_green = NULL;
+	zx_wan = NULL;
+}
--- /dev/null
+++ b/drivers/net/ethernet/zte/zx279133-ptp.c
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+
+#include "zx279133.h"
+
+static u64 zx279133_ptp_read_time(struct zx279133_eth *eth)
+{
+	u32 sec0, sec1, nsec;
+
+	sec1 = readl_relaxed(eth->base + ZX279133_PTP_TOD_SEC);
+	do {
+		sec0 = sec1;
+		nsec = readl_relaxed(eth->base + ZX279133_PTP_TOD_NS);
+		sec1 = readl_relaxed(eth->base + ZX279133_PTP_TOD_SEC);
+	} while (sec0 != sec1);
+
+	return (u64)sec1 * NSEC_PER_SEC + nsec;
+}
+
+static void zx279133_ptp_issue_update(struct zx279133_eth *eth,
+				      u32 sec, u32 nsec)
+{
+	u32 value;
+
+	writel(sec, eth->base + ZX279133_PTP_UPDATE_SEC);
+	writel(nsec, eth->base + ZX279133_PTP_UPDATE_NS);
+
+	value = readl(eth->base + ZX279133_PTP_UPDATE);
+	value &= ~(ZX279133_PTP_UPDATE_SIGN |
+		   ZX279133_PTP_UPDATE_PULSE |
+		   ZX279133_PTP_UPDATE_STATUS);
+	writel(value | ZX279133_PTP_UPDATE_STATUS,
+	       eth->base + ZX279133_PTP_UPDATE);
+	writel(value | ZX279133_PTP_UPDATE_STATUS |
+	       ZX279133_PTP_UPDATE_PULSE,
+	       eth->base + ZX279133_PTP_UPDATE);
+	/* The update pulse crosses into the serial PPS/TOD clock domain. */
+	usleep_range(100000, 110000);
+	writel(value | ZX279133_PTP_UPDATE_STATUS,
+	       eth->base + ZX279133_PTP_UPDATE);
+}
+
+static int zx279133_ptp_gettimex64(struct ptp_clock_info *info,
+				   struct timespec64 *ts,
+				   struct ptp_system_timestamp *sts)
+{
+	struct zx279133_eth *eth = container_of(info, struct zx279133_eth,
+					       ptp_info);
+	unsigned long flags;
+	u64 ns;
+
+	spin_lock_irqsave(&eth->ptp_lock, flags);
+	if (!eth->ptp_agc_prepared) {
+		spin_unlock_irqrestore(&eth->ptp_lock, flags);
+		return -ENETDOWN;
+	}
+	ptp_read_system_prets(sts);
+	ns = zx279133_ptp_read_time(eth);
+	ptp_read_system_postts(sts);
+	spin_unlock_irqrestore(&eth->ptp_lock, flags);
+
+	*ts = ns_to_timespec64(ns);
+	return 0;
+}
+
+static int zx279133_ptp_settime64(struct ptp_clock_info *info,
+				  const struct timespec64 *ts)
+{
+	struct zx279133_eth *eth = container_of(info, struct zx279133_eth,
+					       ptp_info);
+
+	if (ts->tv_sec < 0 || ts->tv_sec > U32_MAX)
+		return -ERANGE;
+
+	mutex_lock(&eth->ptp_cmd_lock);
+	if (!eth->ptp_agc_prepared) {
+		mutex_unlock(&eth->ptp_cmd_lock);
+		return -ENETDOWN;
+	}
+	/* Hardware loads the staged value on its next serial TOD frame. */
+	zx279133_ptp_issue_update(eth, ts->tv_sec, ts->tv_nsec);
+	mutex_unlock(&eth->ptp_cmd_lock);
+
+	return 0;
+}
+
+static int zx279133_ptp_adjtime(struct ptp_clock_info *info, s64 delta)
+{
+	struct zx279133_eth *eth = container_of(info, struct zx279133_eth,
+					       ptp_info);
+	unsigned long flags;
+	u64 sec;
+	u32 nsec;
+	s64 ns;
+
+	mutex_lock(&eth->ptp_cmd_lock);
+	spin_lock_irqsave(&eth->ptp_lock, flags);
+	if (!eth->ptp_agc_prepared) {
+		spin_unlock_irqrestore(&eth->ptp_lock, flags);
+		mutex_unlock(&eth->ptp_cmd_lock);
+		return -ENETDOWN;
+	}
+	ns = zx279133_ptp_read_time(eth);
+	spin_unlock_irqrestore(&eth->ptp_lock, flags);
+
+	ns += delta;
+	sec = ns < 0 ? 0 : div_u64_rem(ns, NSEC_PER_SEC, &nsec);
+	if (ns < 0 || sec > U32_MAX) {
+		mutex_unlock(&eth->ptp_cmd_lock);
+		return -ERANGE;
+	}
+	/* The TOD has no offset register; stage the adjusted absolute time. */
+	zx279133_ptp_issue_update(eth, sec, nsec);
+	mutex_unlock(&eth->ptp_cmd_lock);
+
+	return 0;
+}
+
+static int zx279133_ptp_adjfine(struct ptp_clock_info *info, long scaled_ppm)
+{
+	/* The TOD oscillator cannot be trimmed; accept only a zero offset. */
+	return scaled_ppm ? -EOPNOTSUPP : 0;
+}
+
+static const struct ptp_clock_info zx279133_ptp_info = {
+	.owner		= THIS_MODULE,
+	.name		= "zx279133-tod",
+	/* The recovered compare register does not trim the TOD oscillator. */
+	.max_adj	= 0,
+	.adjfine	= zx279133_ptp_adjfine,
+	.adjtime	= zx279133_ptp_adjtime,
+	.gettimex64	= zx279133_ptp_gettimex64,
+	.settime64	= zx279133_ptp_settime64,
+};
+
+void zx279133_ptp_start(struct zx279133_eth *eth)
+{
+	unsigned long flags;
+	u32 value;
+
+	mutex_lock(&eth->ptp_cmd_lock);
+	spin_lock_irqsave(&eth->ptp_lock, flags);
+	if (!eth->ptp_agc_prepared) {
+		eth->ptp_agc_saved = readl(eth->base + ZX279133_PTP_AGC_CFG);
+		writel(eth->ptp_agc_saved | ZX279133_PTP_AGC_WORK_CLOCKS,
+		       eth->base + ZX279133_PTP_AGC_CFG);
+		eth->ptp_agc_prepared = true;
+	}
+
+	value = readl(eth->base + ZX279133_PTP_COMPARE);
+	value &= ZX279133_PTP_COMPARE_MODE;
+	value |= FIELD_PREP(ZX279133_PTP_COMPARE_TIME,
+			    ZX279133_PTP_NOMINAL_COMPARE);
+	writel(value, eth->base + ZX279133_PTP_COMPARE);
+
+	value = readl(eth->base + ZX279133_PTP_CTRL);
+	writel(value | ZX279133_PTP_UPDATE_ENABLE,
+	       eth->base + ZX279133_PTP_CTRL);
+	spin_unlock_irqrestore(&eth->ptp_lock, flags);
+	mutex_unlock(&eth->ptp_cmd_lock);
+}
+
+void zx279133_ptp_stop(struct zx279133_eth *eth)
+{
+	unsigned long flags;
+
+	mutex_lock(&eth->ptp_cmd_lock);
+	spin_lock_irqsave(&eth->ptp_lock, flags);
+	if (eth->ptp_agc_prepared) {
+		writel(eth->ptp_agc_saved,
+		       eth->base + ZX279133_PTP_AGC_CFG);
+		eth->ptp_agc_prepared = false;
+	}
+	spin_unlock_irqrestore(&eth->ptp_lock, flags);
+	mutex_unlock(&eth->ptp_cmd_lock);
+}
+
+static void zx279133_ptp_unregister(void *data)
+{
+	struct zx279133_eth *eth = data;
+
+	ptp_clock_unregister(eth->ptp_clock);
+}
+
+int zx279133_ptp_init(struct zx279133_eth *eth)
+{
+	int ret;
+
+	eth->ptp_info = zx279133_ptp_info;
+	eth->ptp_clock = ptp_clock_register(&eth->ptp_info, eth->dev);
+	if (IS_ERR(eth->ptp_clock))
+		return PTR_ERR(eth->ptp_clock);
+
+	ret = devm_add_action_or_reset(eth->dev, zx279133_ptp_unregister, eth);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+int zx279133_get_ts_info(struct net_device *ndev,
+			 struct kernel_ethtool_ts_info *info)
+{
+	struct zx279133_eth *eth = netdev_priv(ndev);
+
+	ethtool_op_get_ts_info(ndev, info);
+	info->phc_index = ptp_clock_index(eth->ptp_clock);
+	/* XMAC advertises an external source that is not wired on SR1010. */
+
+	return 0;
+}
