From: xp <a.xp@live.com>
Subject: [PATCH] net: ethernet: zte: zx279133: 给原厂现场读写、计数打印与 SGMII 自协商处理各加一个内核命令行开关

中兴 F7615MV3 第四轮实机（2026-11-27 05:34，构建树 dc9adba8b20）：kexec 交接后新内核没写出起机记录，约 56 s 后设备自己复位回原厂系统，推算新内核在交接后 15–25 s 内挂住或 panic。0111 新加的几样都可能是原因，加开关供逐个关掉二分，缺省维持现在的行为：

- zx279133.vendor_snap=0：不在 NPPT 复位前读原厂 NP 现场，也不写回（399）；
- zx279133.hwcnt=0：不在准备完成时与之后定时打印各级计数（399；调试控制台的 cnt 照旧）；
- zx279133_switch.lane_an=0：链路起来后不按原厂处理 SGMII 自协商结果、不打车道诊断，也不映射 Uni SerDes 的诊断窗口（398）。

另在读原厂现场之前打一行 reading the vendor NP state，读的途中挂住时控制台记录停在这里；第一次准备硬件时打一行三项中前两项的取值。

--- a/drivers/net/ethernet/zte/zx279133-np.c
+++ b/drivers/net/ethernet/zte/zx279133-np.c
@@ -32,6 +32,17 @@
 static bool rx_hash_ipv6 = true;
 module_param(rx_hash_ipv6, bool, 0444);
 MODULE_PARM_DESC(rx_hash_ipv6, "Enable IPv6 tuple hashing with the calibrated RX hash programs");
+/*
+ * 二分用的开关（内核命令行 zx279133.vendor_snap=0、zx279133.hwcnt=0），缺省都开：
+ * vendor_snap 管第一次准备硬件时在 NPPT 复位前读原厂 NP 现场、之后每次准备时写回；
+ * hwcnt 管准备完成时与之后 20/45/90/180 s 的各级计数打印（调试控制台的 cnt 不受它管）。
+ */
+static bool vendor_snap = true;
+module_param(vendor_snap, bool, 0444);
+MODULE_PARM_DESC(vendor_snap, "Read the vendor's NP state before the first NPPT reset and write it back after this driver's set-up");
+static bool hwcnt = true;
+module_param(hwcnt, bool, 0444);
+MODULE_PARM_DESC(hwcnt, "Print the datapath counters after the prepare and 20/45/90/180 s later");
 
 void zx279133_route_set(struct zx279133_eth *eth, bool enabled)
 {
@@ -4908,6 +4919,10 @@
 	if (eth->vendor_snap_tried)
 		return;
 	eth->vendor_snap_tried = true;
+	dev_info(eth->dev, "datapath diagnostics: vendor_snap=%d hwcnt=%d\n",
+		 vendor_snap, hwcnt);
+	if (!vendor_snap)
+		return;
 	/* An NPPT held in reset has no state, and its SPA does not answer. */
 	if (!(readl(eth->base + ZX279133_SYS_SOFT_RESET) &
 	      ZX279133_SYS_SDET_RESET_N)) {
@@ -4920,6 +4935,9 @@
 		return;
 	eth->vendor_snap = snap;
 
+	/* 读之前先打一行：读的途中挂住时，控制台记录（pstore）停在这里 */
+	dev_info(eth->dev, "reading the vendor NP state (SPA memories 0..%u)\n",
+		 ZX279133_SNAP_MEMS - 1);
 	for (m = 0; m < ZX279133_SNAP_MEMS && spa_ok; m++)
 		for (a = 0; a < ZX279133_SNAP_ADDRS; a++)
 			if (zx279133_spa_indirect_read(eth, m, a,
@@ -4996,6 +5014,8 @@
 	struct zx279133_vendor_snap *snap = eth->vendor_snap;
 	unsigned int t, m, a, b, failed = 0, named = 0, agree = 0;
 
+	if (!vendor_snap)
+		return;
 	if (!snap || !snap->spa_valid) {
 		dev_warn(eth->dev,
 			 "no vendor NP state was read before the NPPT reset: the SPA words and ERAM tables keep this driver's values, which are not checked against the vendor's\n");
@@ -5201,6 +5221,8 @@
 
 static void zx279133_hwcnt_start(struct zx279133_eth *eth)
 {
+	if (!hwcnt)
+		return;
 	if (!eth->hwcnt_prev) {
 		eth->hwcnt_prev = devm_kcalloc(eth->dev, zx279133_hwcnt_words(),
 					       sizeof(u32), GFP_KERNEL);
--- a/drivers/net/ethernet/zte/zx279133-switch.c
+++ b/drivers/net/ethernet/zte/zx279133-switch.c
@@ -952,6 +952,15 @@
 static struct mii_bus *zx279133_switch_outer_mdio(struct zx279133_switch *priv);
 
 /*
+ * 二分用的开关（内核命令行 zx279133_switch.lane_an=0），缺省开：管链路起来后按原厂处理
+ * SGMII 自协商结果（读、清 VR_MII_AN_INTR_STS、设 XMAC 速率）与车道诊断（含 Uni SerDes
+ * 头 0x100 字节的只读映射）。
+ */
+static bool lane_an = true;
+module_param(lane_an, bool, 0444);
+MODULE_PARM_DESC(lane_an, "Follow the SGMII auto-negotiation result the way the vendor does and print the lane diagnostics");
+
+/*
  * 原厂 SGMII 自动模式下的链路处理，照 plat_132.ko 的 xmac_speed_process_in_sgmii_auto_mode() 与
  * xpcs_get_speed_duplex_in_auto_en_sgmii_mode()：读 XPCS0 的 VR_MII_AN_INTR_STS，CL37 自协商完成（bit 0）
  * 就清掉 bit 0；对端链路（bit 4）在时按 bits 3:2 的速率换算 XMAC 的速率码（xpcs_switch_vr_mii_an_intr_sts_speed()
@@ -1130,8 +1139,10 @@
 	 * nothing at all.
 	 */
 	zx279133_switch_outerphy_link(priv);
-	zx279133_switch_sgmii_speed_process(priv);
-	zx279133_switch_lane_diag_watch(priv);
+	if (lane_an) {
+		zx279133_switch_sgmii_speed_process(priv);
+		zx279133_switch_lane_diag_watch(priv);
+	}
 
 	/*
 	 * The far end's SerDes class is the one thing on this lane that the
@@ -4259,7 +4270,7 @@
 			of_parse_phandle(parent_np, "phys", idx);
 		struct resource res;
 
-		if (snp && !of_address_to_resource(snp, 0, &res))
+		if (lane_an && snp && !of_address_to_resource(snp, 0, &res))
 			priv->uni_diag = devm_ioremap(dev, res.start, ZX279133_UNI_DIAG_SIZE);
 		of_node_put(snp);
 	}
