			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
		];
	};
};

&gmac0 {
	status = "okay";
	nvmem-cells = <&macaddr_bl 1>;
	nvmem-cell-names = "mac-address";
	/*
	 * [11-08 硬编码] 原厂 eth0 实测 MAC = 基址本身 b4:ba:12:5c:41:a0
	 * （stock bootlog: "eth0: FE MAC Ethernet address: B4:BA:12:5C:41:A0"），
	 * 故此处不用 macaddr_bl 1（基址+1=…a1）。理由同 slot0 注释：
	 * 属性优先于 nvmem，绕开 NAND 不可见导致的 probe defer。
	 */
	mac-address = [b4 ba 12 5c 41 a0];
};

&switch {
	status = "okay";
};

/* 四口同构（GSW 内置 PHY）；ROMFILE 的 ONU 画像报 GEPortNum=1 + FEPortNum=3，OMCI 报 4 桥端口。端口标签保持 lan1-4，lan4 由 board.d/02_network 配成 WAN（DHCP 客户端，用户定），lan1-3 进 LAN 桥。 */
&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

/*
 * LAN1-4 面板灯：EN7528 的 GSW PHY LED1 通过 GPIO31/33/35/37 的
 * LAN0..3_LED1 复用功能引出。tcboot 启动时已经把 0x1fa2015c 的
 * bit5/7/9/11 置位（实测该寄存器 = 0x2aa0），并把 0x1fa201b0/1b4
 * 的映射写成 0x43210；这里用 pinctrl 状态把同一组 mux 再声明一次，
 * 让 mtk-ge-soc 的 "gbe-led" 路径在 probe 时显式选中它。
 */
&pinctrl {
	gswp1_led1_pins: gswp1-led1-pins {
		mux {
			function = "phy1_led1";
			groups = "gpio31";
		};
	};

	gswp2_led1_pins: gswp2-led1-pins {
		mux {
			function = "phy2_led1";
			groups = "gpio33";
		};
	};

	gswp3_led1_pins: gswp3-led1-pins {
		mux {
			function = "phy3_led1";
			groups = "gpio35";
		};
	};

	gswp4_led1_pins: gswp4-led1-pins {
		mux {
			function = "phy4_led1";
			groups = "gpio37";
		};
	};
};

&gsw_phy1 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp1_led1_pins>;
};

&gsw_phy2 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp2_led1_pins>;
};

&gsw_phy3 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led1_pins>;
};

&gsw_phy4 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp4_led1_pins>;
};

&gsw_phy1_led1 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <1>;
	linux,default-trigger = "netdev";
	active-low;
	status = "okay";
};

&gsw_phy2_led1 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <2>;
	linux,default-trigger = "netdev";
	active-low;
	status = "okay";
};

&gsw_phy3_led1 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <3>;
	linux,default-trigger = "netdev";
	active-low;
	status = "okay";
};

&gsw_phy4_led1 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <4>;
	linux,default-trigger = "netdev";
	active-low;
	status = "okay";
};

&nand {
	status = "okay";
	econet,bmt;
	econet,bbt-table-size = <250>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * [11-08 重划 v5] 全 128KB 块对齐、无重叠视图。
		 *
		 * 设计前提（用户 11-08 定稿）：
		 *   - squashfs 只读根 + UBIFS overlay；支持 ext4/vfat/exfat，**不支持 btrfs**
		 *     （btrfs 面向有 FTL 的块设备；裸 NAND 上无磨损均衡/坏块管理，COW 写放大
		 *      直接烧 NAND，且 btrfs.ko 一个就 1.6MB）
		 *   - **不死 u-boot 链路**：内置 bootbase(mtd0) → 不死 u-boot(mtd2) →
		 *     kernel(mtd3) → rootfs(mtd4)，从而实现 uart-free 管理。
		 *     bootbase 固定从 0x80000 读 HDR2，故 4MB uboot 槽必须落在 0x80000。
		 *     现阶段该槽放一个最简链式跳转 stub（tools/cross/uboot_stub.c）：
		 *     bootbase 解压它 → 它把 0x480000 的内核搬到 RAM 0x80020000 → 跳过去。
		 *   - **不保留原厂 A/B backup 与 java**（无 Android 了）。原厂 11 个分区已
		 *     全量 dump 到 devices/gs2107/firmware/，设备端 SHA256 **8/8 字节级一致**；
		 *     需要时从 host 备份经串口 console + flash 裸原语重刷即可。
		 *   - bootloader / romfile / reservearea 三个分区**永不写入**：
		 *       · bootloader(mtd0)  = tcboot stage1+2，唯一启动入口
		 *       · romfile(mtd1)     = bootbase 读它（A/B 开关不在这里，见 docs/09）
		 *       · reservearea(mtd7) = A/B flag 在 +0x200000（芯片偏移 0xDFC0000）
		 *
		 * 空间账：0x80000 起共 0xDD40000（221.25MB）= uboot 4M + kernel 8M + rootfs 32M + uboot_env 256K + overlay 177M，严丝合缝到 reservearea 前一刻。
		 */
		partition@0 {			/* mtd0 256K */
			label = "bootloader";
			reg = <0x00000000 0x00040000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				/* [实测] MAC b4:ba:12:5c:41:a0 就在 0x3fe48，与 JioFiber 同偏移 */
				macaddr_bl: macaddr@3fe48 {
					compatible = "mac-base";
					reg = <0x3fe48 0x6>;
					#nvmem-cell-cells = <1>;
				};
			};
		};

		partition@40000 {			/* mtd1 256K */
			label = "romfile";
			reg = <0x00040000 0x00040000>;
			read-only;
		};

		/*
		 * uboot：不死 u-boot 槽。bootbase 固定从 0x80000 读 HDR2 并解压到
		 * 0x80002000，故本槽必须从 0x80000 起。4MB。
		 * 现居者 = 链式跳转 stub（见上方设计前提）。
		 */
		partition@80000 {			/* mtd2 4M */
			label = "uboot";
			reg = <0x00080000 0x00400000>;
		};

		/*
		 * kernel：8MB。LZMA 流约 3.83MB，余 4.17MB 给后续加驱动。
		 * 由 uboot 槽里的 stub 搬移并跳入，不由 bootbase 直接读。
		 */
		partition@480000 {			/* mtd3 8M */
			label = "kernel";
			reg = <0x0480000 0x00800000>;
			econet,enable-remap;
		};

		/*
		 * rootfs：squashfs 只读根。32MB（当前占用 4.55MB，余 27.45MB）。
		 * bootargs / CONFIG_CMDLINE：root=/dev/mtdblock4 rootfstype=squashfs
		 * （mtd4 = 本表第 5 个分区；改表必须同步改 cmdline）。
		 */
		partition@c80000 {			/* mtd4 32M */
			label = "rootfs";
			reg = <0x0c80000 0x02000000>;
			linux,rootfs;
		};

		/* uboot_env: two 128KB redundant U-Boot env copies; rootfs_data: shared UBIFS overlay. */
		partition@2c80000 {		/* mtd5 256K */
			label = "uboot_env";
			reg = <0x02c80000 0x00040000>;
		};

		partition@2cc0000 {		/* mtd6 177M */
			label = "rootfs_data";
			reg = <0x02cc0000 0x0b100000>;
			/*
			 * overlay：UBIFS 卷。`linux,ubi` 让内核 ubi_notify_add()
			 * 在注册这个 MTD 分区时自动 ubiattach，否则要用户在
			 * preinit 里手工 ubiattach + ubimkvol，而 fstools 的
			 * mount_root 找不到卷就静默退化成 tmpfs overlay
			 * （配置重启即丢）。卷本身在首次安装时用 ubiformat +
			 * ubimkvol 建好，之后由内核每次启动自动 attach。
			 */
			compatible = "linux,ubi";

			volumes {
				ubi-volume-rootfs-data {
					volname = "rootfs_data";
				};
			};
		};

		/*
		 * reservearea：A/B flag 在 +0x200000（芯片偏移 0xDFC0000，单字节 ASCII
		 * '0'=主 / '1'=slave）。bootbase 每轮启动都会写它——永不写入。
		 */
		partition@ddc0000 {		/* mtd7 2.25M */
			label = "reservearea";
			reg = <0x0ddc0000 0x00240000>;
			read-only;
		};
	};
};
