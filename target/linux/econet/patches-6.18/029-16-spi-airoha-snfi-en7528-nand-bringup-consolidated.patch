Subject: [PATCH] spi: airoha-snfi: EN7528 SPI NAND bring-up fixes (consolidated)

层：芯片家族层（EcoNet SNFI 控制器的 manual FIFO 与 DMA 读写）。本树 en7528 与 en751627 子目标的 DT 都以 airoha,en7581-snand 用本驱动（en751221 子目标用 spi-en7523，不受影响）；只在 EN7528（GS2107，BWET08U）上验证过，EN751627 未验证。

按本机原厂 3.18 内核的 spi_nand 体系对齐 exec_op 的 manual 序列。依据是原厂 GPL 源码（devices/openwrt/gs2107/reference/xc220-gpl 下的 spi_controller.c、spi_nand_flash.c、newspiflash.h）与本机原厂内核 firmware/derived/vmlinux-3.18.21.bin 的反汇编，两者在这些原语上一致；对照与证据见 devices/openwrt/gs2107/docs/14-NAND-READ-PATH-FIX.md。

1. 每个 op 片选拉低、拉高各一次，命令字节用单线发送（原厂 SPI_CONTROLLER_Chip_Select_Low/High 各提交一个 op，vmlinux 0x802d7790、0x802d77b4）。拉低片选之后任何一步出错，都先拉高片选再返回。
2. 后面紧跟读数据时，1 线地址或哑元段的最后一个字节用 op 0x11（原厂 OS2ID：单线发、随后转入双线收）。get_feature 的用法与原厂相同；读 ID（命令 + 地址）原厂用普通单线发送，这里用 0x11，读回 bcb2bcb2bc。
3. 读字节前等 DFIFO 状态寄存器（0x3c）整体读回 0，与原厂 SPI_CONTROLLER_Read_NByte（vmlinux 0x802d7718）相同。每个 RX op 只取它要求的字节数，不另行排空 DFIFO，原厂也不排空；0x3c 在空闲时恒读 0，不能拿来判断 FIFO 里有没有字节。
4. DUMMY（0x80）在两种模式下都写 0：改成 1 时页读数据整体左移 1 字节、每页首字节丢失（与固件备份逐字节比对）。原厂进 DMA 读 BWET08U 时写 0，进 manual 时写 1。

--- a/drivers/spi/spi-airoha-snfi.c
+++ b/drivers/spi/spi-airoha-snfi.c
@@ -201,6 +201,8 @@
 #define SNAND_FIFO_TX_BUSWIDTH_SINGLE		0x08
 #define SNAND_FIFO_TX_BUSWIDTH_DUAL		0x09
 #define SNAND_FIFO_TX_BUSWIDTH_QUAD		0x0a
+/* 0x11 是原厂的 OS2ID：单线发、随后转入双线收（原厂 newspiflash.h:146-148，OS2IS/OS2ID/OS2IQ = 0x10/0x11/0x12，单线发 → 单/双/四线收）。原厂 spi_nand 体系里，单线读缓存的列地址末字节或哑元用 OS2IS、双线读缓存的哑元用 OS2ID（spi_nand_flash.c:1467-1512），只有 get_feature 在单线读之前用 0x11（:746），读 ID 的地址字节用普通单线发送（:876）。本驱动在 1 线地址或哑元段之后紧跟读数据时，段内最后一个字节一律用 0x11：get_feature 与原厂相同；读 ID（命令 + 地址）与原厂不同，读回 bcb2bcb2bc；单线读缓存只在不走 DMA 时用到，本机没跑过 */
+#define SNAND_FIFO_TX_ADDR_TA			0x11
 #define SNAND_FIFO_RX_BUSWIDTH_SINGLE		0x0c
 #define SNAND_FIFO_RX_BUSWIDTH_DUAL		0x0e
 #define SNAND_FIFO_RX_BUSWIDTH_QUAD		0x0f
@@ -306,10 +308,10 @@
 		int err;
 		u32 val;
 
-		/* 1. wait until dfifo is not empty */
+		/* 1. 等 DFIFO 状态寄存器整体读回 0 再取字节，与原厂 SPI_CONTROLLER_Read_NByte 相同（vmlinux 0x802d7718 起的 lw 0x3c / bnez 循环）；11-08 debug 日志里它在空闲时也读 0，不能拿来判断 FIFO 里有没有残留字节 */
 		err = regmap_read_poll_timeout(as_ctrl->regmap_ctrl,
 					       REG_SPI_CTRL_DFIFO_EMPTY, val,
-					       !(val & SPI_CTRL_DFIFO_EMPTY),
+					       !val,
 					       0, 250 * USEC_PER_MSEC);
 		if (err)
 			return err;
@@ -390,6 +392,7 @@
 		break;
 	}
 
+	/* DUMMY 写 0，这一写对 manual 与 DMA 两种模式都生效。曾把它改成 1，页读数据整体左移 1 字节、每页首字节丢失（devices/openwrt/gs2107/docs/14-NAND-READ-PATH-FIX.md §1.4，读出与固件备份逐字节比对），页读走的是 DMA。原厂进 DMA 读 BWET08U（哑元在地址之后）时写 0（spi_nand_flash.c:1675），进 manual 时写 1（spi_controller.c:530）；manual 下写 0 或 1，读 ID 读回的字节相同（11-08 debug 开机日志） */
 	return regmap_write(as_ctrl->regmap_ctrl, REG_SPI_CTRL_DUMMY, 0);
 }
 
@@ -431,6 +434,28 @@
 	return 0;
 }
 
+/* 逐字节发送 1 线的地址或哑元段，最后一个字节用 SNAND_FIFO_TX_ADDR_TA（0x11）发，其后紧跟读数据；原厂各场景的用法见该宏的注释 */
+static int airoha_snand_write_data_ta(struct airoha_snand_ctrl *as_ctrl,
+				      const u8 *data, int len)
+{
+	int i, err;
+
+	for (i = 0; i < len; i++) {
+		u8 op_cmd = (i == len - 1) ? SNAND_FIFO_TX_ADDR_TA
+					   : SNAND_FIFO_TX_BUSWIDTH_SINGLE;
+
+		err = airoha_snand_set_fifo_op(as_ctrl, op_cmd, 1);
+		if (err)
+			return err;
+
+		err = airoha_snand_write_data_to_fifo(as_ctrl, &data[i], 1);
+		if (err < 0)
+			return err;
+	}
+
+	return 0;
+}
+
 static int airoha_snand_read_data(struct airoha_snand_ctrl *as_ctrl,
 				  u8 *data, int len, int buswidth)
 {
@@ -935,6 +960,7 @@
 {
 	struct airoha_snand_ctrl *as_ctrl;
 	int op_len, addr_len, dummy_len;
+	bool rx_after;
 	u8 buf[20], *data;
 	int i, err;
 
@@ -955,38 +981,51 @@
 	for (i = 0; i < dummy_len; i++)
 		*data++ = 0xff;
 
+	/* 按原厂 spi_nand 体系：每个 op 片选拉低、拉高各一次（原厂 SPI_CONTROLLER_Chip_Select_Low/High 各提交一个 op，vmlinux 0x802d7790、0x802d77b4），命令字节单线发送 */
+	rx_after = op->data.nbytes > 0 && op->data.dir == SPI_MEM_DATA_IN;
+
 	/* switch to manual mode */
 	err = airoha_snand_set_mode(as_ctrl, SPI_MODE_MANUAL);
 	if (err < 0)
 		return err;
 
+	/* 片选拉低之后任何一步出错都经 out_cs_high 拉高片选再返回 */
 	err = airoha_snand_set_cs(as_ctrl, SPI_CHIP_SEL_LOW);
 	if (err < 0)
-		return err;
+		goto out_cs_high;
 
 	/* opcode */
 	data = buf;
-	err = airoha_snand_write_data(as_ctrl, data, op_len,
-				      op->cmd.buswidth);
+	err = airoha_snand_write_data(as_ctrl, data, op_len, op->cmd.buswidth);
 	if (err)
-		return err;
+		goto out_cs_high;
 
-	/* addr part */
+	/* addr part：1 线且后面跟读数据时，最后一个字节用 SNAND_FIFO_TX_ADDR_TA */
 	data += op_len;
 	if (addr_len) {
-		err = airoha_snand_write_data(as_ctrl, data, addr_len,
-					      op->addr.buswidth);
+		if (rx_after && !dummy_len && op->addr.buswidth == 1) {
+			err = airoha_snand_write_data_ta(as_ctrl, data,
+							 addr_len);
+		} else {
+			err = airoha_snand_write_data(as_ctrl, data, addr_len,
+						      op->addr.buswidth);
+		}
 		if (err)
-			return err;
+			goto out_cs_high;
 	}
 
-	/* dummy */
+	/* dummy：同上 */
 	data += addr_len;
 	if (dummy_len) {
-		err = airoha_snand_write_data(as_ctrl, data, dummy_len,
-					      op->dummy.buswidth);
+		if (rx_after && op->dummy.buswidth == 1) {
+			err = airoha_snand_write_data_ta(as_ctrl, data,
+							 dummy_len);
+		} else {
+			err = airoha_snand_write_data(as_ctrl, data, dummy_len,
+						      op->dummy.buswidth);
+		}
 		if (err)
-			return err;
+			goto out_cs_high;
 	}
 
 	/* data */
@@ -1000,10 +1039,14 @@
 						      op->data.nbytes,
 						      op->data.buswidth);
 		if (err)
-			return err;
+			goto out_cs_high;
 	}
 
-	return airoha_snand_set_cs(as_ctrl, SPI_CHIP_SEL_HIGH);
+out_cs_high:
+	if (airoha_snand_set_cs(as_ctrl, SPI_CHIP_SEL_HIGH) && !err)
+		err = -EIO;
+
+	return err;
 }
 
 static const struct spi_controller_mem_ops airoha_snand_mem_ops = {
