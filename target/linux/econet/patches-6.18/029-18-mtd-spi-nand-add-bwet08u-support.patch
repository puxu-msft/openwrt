Subject: [PATCH] mtd: spi-nand: 支持 BWET08U（0xBC/0xB2）SPI NAND

中国移动 GS2107（EcoNet EN7528）板载 256 MB 的 SPI NAND，原厂 3.18 内核把它认作 _SPI_NAND_DEVICE_ID_BWET08U（厂商 0xBC、器件 0xB2），即佰维 BIWIN BWET08U。spi-nand 核心没有 0xBC 的厂商表项，读 ID 阶段就会报 “unknown raw ID”。

参数与依据（证据等级见 devices/openwrt/gs2107/docs/11-NAND-ROOTCAUSE.md §12、docs/35-VENDOR-LAYOUT-AUDIT.md N31）：
- 几何：每页 2048 字节、每块 64 页、2048 块，SLC；MTD 的 OOB 取 64 字节（物理备用区 128 字节；原厂 3.18 的 nand_scan_ident 也按页大小 / 32 取 64，vmlinux 0x802e0db4 `srl a0,v0,5`，第 3、4 扇区的备用区没有人用）。
- 片上 ECC：configure_chip 里置 feature 0xB0 bit4；解锁：feature 0xA0 清 bit5..3。以上取自原厂芯片表第 43 项（scan_spi_nand_table@0x802cfa50，表项 0x807ef304）。
- 读 ID 用 OPCODE_ADDR：手册图 5-1 是 9FH 后跟 1 个地址字节；只发 9FH 不发地址时读到的首字节 00 落在地址周期（图中这 8 个时钟 SO 高阻），不是 ID。
- 纠错能力 NAND_ECCREQ(8, 512)：BWET08U 手册 1.1 节“每 512 字节 + 32 字节 8 位 ECC”。
- OOB 布局：每 512 字节扇区配 32 字节备用区，前 18 字节 metadata、后 14 字节 ECC 校验（手册表 1-2，800h–811h / 812h–81Fh 起每 32 字节一段），与原厂芯片表的可用区 ooblayout_type10（0x8098831c：(0,18) (32,18) (64,18) (96,18)）一致。可用区从第 4 字节起：0–1 是坏块标记，2–3 是 EcoNet BMT 记被映射原块号的位置（原厂 LINUX_USE_OOB_START_OFFSET = 4）。在 64 字节里即可用 (4,14) (32,18)、ECC (18,14) (50,14)。
- ECC 状态（状态寄存器 bit5:4）：00 无错；01 已纠正、位数低于上限，报强度减一（7），达到 bitflip_threshold（6），读返回 -EUCLEAN：UBI 管的分区随即 scrub，其余分区只计进 corrected_bits，设备树开了 econet,enable-remap 的分区会把该块永久重映射进保留区；10 不可纠（-EBADMSG，与原厂 ecc_fail_check {0x30, 0x20} 相同）；11 已纠正、位数等于上限，报强度（8）。同家族手册没有列出读纠正位数的寄存器，只能按档报。01 与 11 的含义取自同家族 Etron EM73 手册表 13-1（BWET08U 手册这一节没有取到）；BWET08U 与 Etron EM73 同家族的依据是功能寄存器表、指令集表、存储映射图与原厂芯片表各字段逐项相同。

--- /dev/null
+++ b/drivers/mtd/nand/spi/bwet.c
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * 佰维 BIWIN BWET08U SPI NAND（厂商 0xBC、器件 0xB2）：2 Gbit SLC，每页 2048 + 128 字节、每块 64 页、2048 块，片上 ECC。中国移动 GS2107（EcoNet EN7528）板载，原厂 3.18 内核芯片表第 43 项（scan_spi_nand_table@0x802cfa50，表项 0x807ef304）就是它。
+ *
+ * 参数依据（证据与等级见 devices/openwrt/gs2107/docs/11-NAND-ROOTCAUSE.md §12 与 docs/35-VENDOR-LAYOUT-AUDIT.md N31）：纠错能力与备用区布局取 BWET08U 手册（1.1 节“每 512 字节 + 32 字节 8 位 ECC”、表 1-2 ECC 保护与备用区），与原厂芯片表的可用区 ooblayout_type10（0x8098831c）一致；状态位 ECCS 的取值按同家族 Etron EM73 手册表 13-1（BWET08U 手册这一节没有取到）。
+ */
+
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/mtd/spinand.h>
+
+#define SPINAND_MFR_BWET			0xbc
+
+/* 功能寄存器（BWET08U 手册表 4-1） */
+#define BWET_FR_BLOCK_LOCK			0xa0
+#define BWET_FR_BLOCK_LOCK_UNLOCK_MASK		0x38
+#define BWET_FR_ECC				0xb0
+#define BWET_FR_ECC_ON_DIE			BIT(4)
+
+/* 状态寄存器 C0H 的 ECCS1:ECCS0（bit5:4）：00 无错；01 已纠正、位数低于纠错上限；10 不可纠；11 已纠正、位数等于纠错上限。同家族 Etron 手册没有列出读纠正位数的寄存器（参数页的 Advanced ECC status 字段为 0），只能按档报。原厂驱动只判 10（0x802d2af4：(status & 0x30) == 0x20），01 与 11 照用数据、不上报。 */
+#define BWET_STATUS_ECC_MAX_BITFLIPS		(3 << 4)
+
+static SPINAND_OP_VARIANTS(read_cache_variants,
+		SPINAND_PAGE_READ_FROM_CACHE_1S_1S_1S_OP(0, 1, NULL, 0, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_FAST_1S_1S_1S_OP(0, 1, NULL, 0, 0));
+
+static SPINAND_OP_VARIANTS(write_cache_variants,
+		SPINAND_PROG_LOAD_1S_1S_1S_OP(true, 0, NULL, 0));
+
+static SPINAND_OP_VARIANTS(update_cache_variants,
+		SPINAND_PROG_LOAD_1S_1S_1S_OP(false, 0, NULL, 0));
+
+/* 初始化顺序照原厂芯片表（ecc_en、unlock_block_info）：先置 feature 0xB0 bit4 开片上 ECC，再清 feature 0xA0 的 bit5..3 解锁全部块。ECC 在片上，主机侧不需要 ECC 引擎。 */
+static int bwet08u_cfg(struct spinand_device *spinand,
+		       enum spinand_bus_interface iface)
+{
+	u8 val;
+	int ret;
+
+	if (iface != SSDR)
+		return -EOPNOTSUPP;
+
+	ret = spinand_read_reg_op(spinand, BWET_FR_ECC, &val);
+	if (ret)
+		return ret;
+
+	ret = spinand_write_reg_op(spinand, BWET_FR_ECC,
+				   val | BWET_FR_ECC_ON_DIE);
+	if (ret)
+		return ret;
+
+	ret = spinand_read_reg_op(spinand, BWET_FR_BLOCK_LOCK, &val);
+	if (ret)
+		return ret;
+
+	ret = spinand_write_reg_op(spinand, BWET_FR_BLOCK_LOCK,
+				   val & ~BWET_FR_BLOCK_LOCK_UNLOCK_MASK);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+/*
+ * 备用区按 512 字节扇区分 4 段、每段 32 字节：前 18 字节 metadata（受 ECC 保护），后 14 字节是该扇区的 ECC 校验（手册表 1-2：800h–811h / 812h–81Fh，820h–831h / 832h–83Fh，依此类推）。MTD 只用前 64 字节（原厂 3.18 nand_scan_ident 也按页大小 / 32 取 64，0x802e0db4），所以这里只描述前两段。可用区从第 4 字节起：0–1 是坏块标记，2–3 是 EcoNet BMT（en75_bmt）在备用块上记被映射原块号的位置（原厂 LINUX_USE_OOB_START_OFFSET = 4）。
+ */
+static int bwet_ooblayout_ecc(struct mtd_info *mtd, int section,
+			      struct mtd_oob_region *region)
+{
+	if (section > 1)
+		return -ERANGE;
+
+	region->offset = 32 * section + 18;
+	region->length = 14;
+	return 0;
+}
+
+static int bwet_ooblayout_free(struct mtd_info *mtd, int section,
+			       struct mtd_oob_region *region)
+{
+	switch (section) {
+	case 0:
+		region->offset = 4;
+		region->length = 14;
+		return 0;
+	case 1:
+		region->offset = 32;
+		region->length = 18;
+		return 0;
+	}
+
+	return -ERANGE;
+}
+
+static const struct mtd_ooblayout_ops bwet_ooblayout = {
+	.ecc = bwet_ooblayout_ecc,
+	.free = bwet_ooblayout_free,
+};
+
+static int bwet08u_ecc_get_status(struct spinand_device *spinand, u8 status)
+{
+	struct nand_device *nand = spinand_to_nand(spinand);
+
+	switch (status & STATUS_ECC_MASK) {
+	case STATUS_ECC_NO_BITFLIPS:
+		return 0;
+
+	case STATUS_ECC_UNCOR_ERROR:
+		return -EBADMSG;
+
+	case STATUS_ECC_HAS_BITFLIPS:
+		/* 位数未知、低于上限：报上限减一（与 etron.c、alliancememory.c、gigadevice.c 对同类两位状态的口径相同），达到 bitflip_threshold（强度 8 的 3/4 即 6），读返回 -EUCLEAN：UBI 管的分区随即 scrub 该 PEB，其余分区只计进 corrected_bits；设备树给分区开了 econet,enable-remap 的，EcoNet BMT 会把该块永久重映射进保留区（mtk_bmt_read → en75_bmt pub_remap_block）。 */
+		return nanddev_get_ecc_conf(nand)->strength - 1;
+
+	case BWET_STATUS_ECC_MAX_BITFLIPS:
+		return nanddev_get_ecc_conf(nand)->strength;
+	}
+
+	return -EINVAL;
+}
+
+static const struct spinand_info bwet_spinand_table[] = {
+	SPINAND_INFO("BWET08U",
+		     /*
+		      * 读 ID 用 OPCODE_ADDR：手册图 5-1 是 9FH 后跟 1 个地址字节（00H 出厂商 BCH，01H 出器件 B2H），本板的干净读法即此（调试日志 “read 5B: bcb2bcb2bc”）。只发 9FH 不发地址就读，头一个字节 00 落在地址周期（图 5-1 里这 8 个时钟 SO 是高阻），不是 ID。devid 只写 0xB2，厂商字节 0xBC 由下面的厂商表项给出。
+		      */
+		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_ADDR, 0xb2),
+		     NAND_MEMORG(1, 2048, 64, 64, 2048, 20, 1, 1, 1),
+		     NAND_ECCREQ(8, 512),
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+					      &write_cache_variants,
+					      &update_cache_variants),
+		     0,
+		     SPINAND_CONFIGURE_CHIP(bwet08u_cfg),
+		     SPINAND_ECCINFO(&bwet_ooblayout, bwet08u_ecc_get_status)),
+};
+
+static const struct spinand_manufacturer_ops bwet_spinand_manuf_ops = {
+};
+
+const struct spinand_manufacturer bwet_spinand_manufacturer = {
+	.id = SPINAND_MFR_BWET,
+	.name = "BWET",
+	.chips = bwet_spinand_table,
+	.nchips = ARRAY_SIZE(bwet_spinand_table),
+	.ops = &bwet_spinand_manuf_ops,
+};
--- a/drivers/mtd/nand/spi/core.c
+++ b/drivers/mtd/nand/spi/core.c
@@ -1242,9 +1242,12 @@ static const struct nand_ops spinand_ops
 	.isbad = spinand_isbad,
 };
 
+extern const struct spinand_manufacturer bwet_spinand_manufacturer;
+
 static const struct spinand_manufacturer *spinand_manufacturers[] = {
 	&alliancememory_spinand_manufacturer,
 	&ato_spinand_manufacturer,
+	&bwet_spinand_manufacturer,
 	&esmt_8c_spinand_manufacturer,
 	&esmt_c8_spinand_manufacturer,
 	&etron_spinand_manufacturer,
--- a/drivers/mtd/nand/spi/Makefile
+++ b/drivers/mtd/nand/spi/Makefile
@@ -1,5 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
 spinand-objs := core.o otp.o
-spinand-objs += alliancememory.o ato.o esmt.o etron.o fmsh.o foresee.o gigadevice.o heyangtek.o
+spinand-objs += alliancememory.o ato.o bwet.o esmt.o etron.o fmsh.o foresee.o gigadevice.o heyangtek.o
 spinand-objs += macronix.o micron.o paragon.o skyhigh.o toshiba.o winbond.o xtx.o
 obj-$(CONFIG_MTD_SPI_NAND) += spinand.o
