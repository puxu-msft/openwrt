. /lib/functions.sh
. /lib/functions/gs2107.sh

# 自救模式的配置。自救系统（网络救援时经 TFTP 载入内存的自救 FIT）与主系统共用同一份 rootfs，以 initramfs 方式整个在内存里跑、不挂 overlay，每次启动 /etc 都是镜像原样，这个脚本每次都会执行；主系统（内核命令行没有 gs2107.recovery=1）下直接退出、不改任何配置（随后照常被删掉）。
# LAN（192.168.21.7/24，lan1–lan3）与 WAN（lan4，DHCP）沿用 board.d/02_network 的板级默认，root 口令由 92_gs2107-root-password 按构建时的凭据设置，这里都不改。Wi-Fi AP 由 hotplug.d/ieee80211/90_gs2107-recovery-wifi 配置：无线配置在网卡驱动加载后才由 hotplug 生成，与 uci-defaults 的先后不确定。
case "$(board_name)" in
chinamobile,gs2107)
	gs2107_recovery_mode || exit 0

	uci set system.@system[0].hostname='gs2107-recovery'

	# SSH：自救时不依赖任何钥匙（2026-11-22 用户定）。默认实例 main 口令（root 口令由 92_gs2107-root-password 按构建时的凭据设置）与钥匙都接受，不绑定接口、监听 0.0.0.0:22，LAN 与 WAN 都能连；fw4 另放行 WAN tcp/22。主系统的只认公钥（94_gs2107-ssh-key-only）在自救模式下跳过。
	uci set dropbear.main.PasswordAuth='on'
	uci set dropbear.main.RootPasswordAuth='on'

	uci set firewall.gs2107_recovery_ssh=rule
	uci set firewall.gs2107_recovery_ssh.name='Allow-SSH-WAN-Recovery'
	uci set firewall.gs2107_recovery_ssh.src='wan'
	uci set firewall.gs2107_recovery_ssh.proto='tcp'
	uci set firewall.gs2107_recovery_ssh.dest_port='22'
	uci set firewall.gs2107_recovery_ssh.target='ACCEPT'

	# 主机的钥匙并入 root 的 authorized_keys（OpenWrt dropbear 读 /etc/dropbear/authorized_keys），供主机工具免交互登录；镜像里已有的行保留；dropbear 要求文件权限 600。
	keys=/etc/dropbear/authorized_keys
	mkdir -p /etc/dropbear
	touch "$keys"
	while read -r key; do
		[ -n "$key" ] || continue
		grep -qxF "$key" "$keys" || printf '%s\n' "$key" >> "$keys"
	done < /lib/gs2107/recovery-authorized_keys
	chmod 600 "$keys"

	uci commit system
	uci commit dropbear
	uci commit firewall
	logger -t gs2107-recovery "recovery mode: hostname, SSH (password or key, LAN and WAN) and authorized_keys configured"
	;;
esac

exit 0
