. /lib/functions.sh

# root 口令为空时设为构建时的凭据：空口令时 dropbear 接受无凭据登录、rpcd（LuCI）任何口令都放行。只在 /etc/shadow 里 root 的口令字段为空时写入，用户之后设的口令（包括锁定的 ! 或 *）不改。
# 哈希由 tools/openwrt/build.sh 从凭据真源 var/credentials/gs2107/root.json 算出（openssl passwd -6，固定盐），渲染进 /lib/gs2107/credentials.sh 的 GS2107_ROOT_HASH；gs2107-provision.sh 给运行中的设备推送同一份渲染结果与本脚本。
# 不带版本标记，每次出现都运行（firstboot、保留配置的 sysupgrade、部署新镜像之后），排在 10_migrate-shadow 之后。凭据文件缺失时报错并保留本脚本，下次开机重试。
case "$(board_name)" in
chinamobile,gs2107)
	[ -r /lib/gs2107/credentials.sh ] && . /lib/gs2107/credentials.sh
	hash="${GS2107_ROOT_HASH:-}"
	case "$hash" in
	'$6$'*) ;;
	*)
		logger -s -t gs2107-root "缺 /lib/gs2107/credentials.sh 或其中没有 GS2107_ROOT_HASH（镜像未经 build.sh 渲染凭据），root 口令未设"
		exit 1
		;;
	esac
	cur="$(awk -F: '$1 == "root" { print $2 }' /etc/shadow)"
	if [ -z "$cur" ]; then
		sed -i "s|^root:[^:]*|root:$hash|" /etc/shadow
		sync
		if [ "$(awk -F: '$1 == "root" { print $2 }' /etc/shadow)" = "$hash" ]; then
			logger -s -t gs2107-root "root 口令为空，已按构建时的凭据设置"
		else
			logger -s -t gs2107-root "root 口令为空，写入 /etc/shadow 失败"
			exit 1
		fi
	else
		logger -s -t gs2107-root "root 口令已设置，不改"
	fi
	;;
esac
