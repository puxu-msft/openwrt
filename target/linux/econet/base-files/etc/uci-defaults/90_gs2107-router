. /lib/functions.sh

case "$(board_name)" in
chinamobile,gs2107)
	# 标记记录已经应用到第几版：sysupgrade 保留 /etc/config/system，所以新镜像只补新版本引入的项，不会把用户删掉的选项再加回来（LuCI 关闭 flow offloading 的方式就是删掉选项）。
	# 没有标记时（第一次带这些默认值的镜像，或更早的配置），分不清选项是被删掉的还是从未设过，所以第 1 版把缺的选项都补上。
	applied="$(uci -q get system.@system[0].gs2107_router_defaults)"
	applied="${applied:-0}"

	if [ "$applied" -lt 1 ]; then
		# econet-eth 每个 QDMA 只有一条中断线，后面接 DSA conduit：packet steering 模式 2 按流把 RPS 分到所有 CPU；默认模式在这里看不到 MIPS GIC 中断和 qdma 的 NAPI 线程，会把 eth0 的收包全部压到一个 CPU 上。
		uci -q get network.globals.packet_steering >/dev/null ||
			uci set network.globals.packet_steering='2'
		# 软件 flow offloading：已建立的流跳过转发路径。
		uci -q get firewall.@defaults[0].flow_offloading >/dev/null ||
			uci set firewall.@defaults[0].flow_offloading='1'
	fi

	if [ "$applied" -lt 2 ]; then
		# Wi-Fi AP 在防火墙启动之后才加入 br-lan；"phy*" 前缀让它们一出现就挂进 flowtable（firewall4 包补丁 100）。
		uci -q get firewall.@defaults[0].flow_offloading_devices >/dev/null ||
			uci add_list firewall.@defaults[0].flow_offloading_devices='phy*'
	fi

	if [ "$applied" -lt 3 ]; then
		# 硬件 flow offloading：econet-eth 驱动 EN7528 的 PPE，交换机口之间的流由硬件转发；Wi-Fi AP 留在同一 flowtable 的软件路径上（firewall4 包补丁 101）。只在开了软件 offloading 时才开，与 LuCI 允许的组合一致（在那里选"无"会把两个选项都删掉）。
		[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = 1 ] &&
			! uci -q get firewall.@defaults[0].flow_offloading_hw >/dev/null &&
			uci set firewall.@defaults[0].flow_offloading_hw='1'
	fi

	if [ "$applied" -lt 4 ]; then
		# 控制台是 115200 波特的串口（加 netconsole）：每条不低于控制台日志级别的消息都由调用者同步写出，每行约 5.5 ms，曾让每个触发逐包 dev_info 的收包都被拖住。错误及更严重的消息仍上控制台，所有消息都留在内核日志里（dmesg、logread）。
		uci -q get system.@system[0].conloglevel >/dev/null ||
			uci set system.@system[0].conloglevel='4'
	fi

	# 第 5 版已用过（0028，已撤），标记写 5，下一版从 6 起。
	uci set system.@system[0].gs2107_router_defaults='5'
	uci commit network
	uci commit firewall
	uci commit system
	;;
esac

exit 0
