. /lib/functions.sh

# VPN 按需启用（用户定，2026-11-23：VPN 全面支持、按需启用）：镜像带 WireGuard 与 strongSwan。WireGuard 由 netifd 按接口配置起停，没配置就不运行；strongSwan 的两个启动脚本 swanctl（vici）与 ipsec（stroke，随 strongswan-minimal 的依赖装上）默认都随开机起 charon，这里在没有任何 IPsec 配置时把两个都关掉。
# 判据：/etc/config/ipsec 里没有 remote 段（LuCI 的 swanctl 应用与 ipsec 启动脚本都读这里），/etc/swanctl/conf.d 下没有 *.conf，/etc/ipsec.conf 里没有 %default 之外的 conn 段。有配置时不动，所以用户配过、启用过的不会被关回去。不带版本标记，每次出现都运行（firstboot、保留配置的 sysupgrade、部署新镜像之后）。
case "$(board_name)" in
chinamobile,gs2107)
	[ -x /etc/init.d/swanctl ] || [ -x /etc/init.d/ipsec ] || exit 0
	if uci -q show ipsec 2>/dev/null | grep -q '=remote$'; then
		exit 0
	fi
	for f in /etc/swanctl/conf.d/*.conf; do
		[ -e "$f" ] && exit 0
	done
	grep -qE '^[[:space:]]*conn[[:space:]]+[^%[:space:]]' /etc/ipsec.conf 2>/dev/null && exit 0
	for s in swanctl ipsec; do
		[ -x "/etc/init.d/$s" ] && /etc/init.d/"$s" disable
	done
	logger -s -t gs2107-vpn "没有 IPsec 配置，strongSwan（swanctl、ipsec 两个启动脚本）不随开机启动；配置后按所用方式 enable 并 start 其中一个"
	;;
esac

exit 0
