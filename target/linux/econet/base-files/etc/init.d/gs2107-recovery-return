#!/bin/sh /etc/rc.common
# 自救模式（内核命令行带 gs2107.recovery=1）下空闲时自动回主系统：连续 N 秒（默认 1800，gs2107.recovery_return=<秒> 可改，供测试缩短）既没有 gs2107-recovery hold、也没有登录后的 SSH 会话，就清掉 env 里的 recovery 与 bootcount 并重启；每 15 秒检查一次，看到 hold 或会话就重新计时。计时与判据在 gs2107-recovery auto-return 里。
# 主系统下不起任何进程。
START=99
USE_PROCD=1

start_service() {
	. /lib/functions/gs2107.sh

	gs2107_recovery_mode || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/gs2107-recovery auto-return
	procd_set_param stderr 1
	procd_close_instance
}
