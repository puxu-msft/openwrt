#!/bin/sh /etc/rc.common
# 向 U-Boot 标记本次启动成功：upgrade_available=1 时 U-Boot 的 BOOTCOUNT_ENV 每次启动都把 bootcount 加 1（超过 bootlimit → altbootcmd → recovery），OpenWrt 起来后由这里清零。
# 写 env 走 gs2107_env_set（/lib/functions/gs2107.sh）：只写有变化的值、合成一次 fw_setenv，且只在 env 读回来是 GS2107 的 env 时才写。
START=99

mark_boot_ok() {
	. /lib/functions/gs2107.sh

	# 自救模式（自救镜像在内存里跑）不写 env：bootcount 留着让 U-Boot 继续累加，自救系统若每次撑过这里才崩溃，连续 bootlimit 次后 gs_fallback 就轮到主系统，不会无限循环在自救镜像里；回主系统由 gs2107-recovery-return 或 gs2107-recovery clear 清 recovery 与 bootcount；bootok 表示主系统起来过，自救镜像不写。
	if gs2107_recovery_mode; then
		return 0
	else
		gs2107_env_set gs2107-bootok bootcount=0 recovery=0 bootok=1
	fi
}

boot() {
	# 起来一段时间后才算这次启动成功；放到后台，不拖住排在后面的 init 脚本。
	( sleep 10; mark_boot_ok ) &
}
