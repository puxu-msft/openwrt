. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/econet.sh

econet_setup_interfaces()
{
	local board="$1"

	case "$board" in
	dasan,h660gm-a-airtel|\
	dasan,h660gm-a-generic|\
	econet,en7528-generic|\
	jiofiber,jcow407|\
	jiofiber,jcow414)
		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
		;;
	chinamobile,gs2107)
		# GS2107：mt7530 DSA（lan1-4），原始设备树 &switch 节点存在。不加这一项会落到下方 *) 分支生成 eth0 桥（非 DSA 布局），连带默认 IP 变 192.168.1.1 —— 见 HANDOFF-20261108 §9.3。
		#
		# LAN 网段 = 192.168.21.0/24，设备自身为网关 .7（用户 11-08 定稿）；lan4 留作 WAN（DHCP 客户端，用户定），lan1-3 进 LAN 桥。注意必须直接调 ucidef_set_interface：ucidef_set_interface_lan 的定义只透传 device 与 protocol 两个参数，多余的 ipaddr/netmask 会被静默丢弃（实测确认，别用那个包装函数传 IP）。
		ucidef_set_interface "lan" device "lan1 lan2 lan3" \
			protocol static ipaddr 192.168.21.7 netmask 255.255.255.0
		ucidef_set_interface_wan "lan4"
		;;
	*)
		# The remaining boards have no DSA switch driver yet.
		ucidef_set_interface_lan "eth0"
		;;
	esac
}

econet_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in
	chinamobile,gs2107)
		# Base MAC = gmac0 mac-address in the DTS, read from the device tree because board.d runs in preinit, before the econet-eth module creates eth0; WiFi uses +2/+3. Without its own address the WAN port inherits eth0's, the same as br-lan.
		wan_mac="$(macaddr_add "$(get_mac_binary /sys/firmware/devicetree/base/ethernet@1fb50000/mac@0/mac-address 0)" 1)"
		;;
	chinamobile,gs3101)
		wan_mac="$(get_mac_gs3101)"
		[ -n "$wan_mac" ] && lan_mac="$(macaddr_add $wan_mac 1)"
		;;
	huawei,hg2821t-u)
		local conffile="/tmp/configuration_a/factory.conf"
		lan_mac=$(get_mac_ascii "$conffile" brmac)
		wan_mac=$(get_mac_ascii "$conffile" internetmac)
		label_mac=$wan_mac
		;;
	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
	[ -n "$label_mac" ] && ucidef_set_label_macaddr "$label_mac"
}

board_config_update
board=$(board_name)
econet_setup_interfaces $board
econet_setup_macs $board
board_config_flush

exit 0
