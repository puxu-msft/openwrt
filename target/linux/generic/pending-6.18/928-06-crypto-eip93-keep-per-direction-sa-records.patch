-		if (err != -EINPROGRESS)
+		if (err != -EINPROGRESS) {
+			struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(async->tfm);
+
+			eip93_put_req_sa_record(ctx->eip93, eip93_cipher_async_rctx(async));
 			crypto_request_complete(async, err);
+		}
 	}
