diff --git a/drivers/crypto/inside-secure/eip93/eip93-cipher.h b/drivers/crypto/inside-secure/eip93/eip93-cipher.h
index 845b8f4..d554453 100644
--- a/drivers/crypto/inside-secure/eip93/eip93-cipher.h
+++ b/drivers/crypto/inside-secure/eip93/eip93-cipher.h
@@ -9,22 +9,31 @@
 #define _EIP93_CIPHER_H_
 
 #include "eip93-main.h"
+#include "eip93-regs.h"
 
 struct eip93_crypto_ctx {
 	struct eip93_device		*eip93;
 	u32				flags;
+	/*
+	 * 两份 SA 记录，[0] 加密、[1] 解密，在 cra_init 里整块映射给引擎（sa_record_base），请求的描述符按方向指向其中一份。
+	 * setkey、setauthsize 在 eip93_sa_records_begin_update() 与 eip93_sa_records_end_update() 之间只写 [0]，后者派生 [1] 并同步给设备。
+	 * 请求路径只在一处写：aead 的关联数据偏移也在 SA 里，setkey 之后第一个 aead 请求把它写进两份记录，sa_assoclen 是写进去的关联数据长度（见 eip93_get_req_sa_record()）。
+	 */
 	struct sa_record		*sa_record;
+	dma_addr_t			sa_record_base;
+	int				sa_assoclen;
 	u32				sa_nonce;
 	int				blksize;
-	dma_addr_t			sa_record_base;
 	/* AEAD specific */
 	unsigned int			authsize;
-	unsigned int			assoclen;
-	bool				set_assoc;
 	enum eip93_alg_type		type;
 };
 
 struct eip93_cipher_reqctx {
+	/* aead 请求用不了 tfm 的 SA 记录（关联数据长度不同，或别的请求正在写偏移）时的私有副本（放在最前，取请求上下文的对齐）；引擎只读它 */
+	struct sa_record		sa_record;
+	/* sa_record_base 指向上面的私有副本（单独映射过，完成时要撤销），否则指向 tfm 的记录 */
+	bool				sa_record_private;
 	u16				desc_flags;
 	u16				flags;
 	unsigned int			blksize;
@@ -56,6 +65,13 @@ int check_valid_request(struct eip93_cipher_reqctx *rctx, gfp_t gfp);
 void eip93_free_sg_copies(struct eip93_cipher_reqctx *rctx,
 			  struct scatterlist *reqsrc, struct scatterlist *reqdst);
 
+int eip93_alloc_sa_records(struct eip93_crypto_ctx *ctx);
+void eip93_free_sa_records(struct eip93_crypto_ctx *ctx);
+void eip93_sa_records_begin_update(struct eip93_crypto_ctx *ctx);
+void eip93_sa_records_end_update(struct eip93_crypto_ctx *ctx);
+int eip93_get_req_sa_record(struct eip93_crypto_ctx *ctx, struct eip93_cipher_reqctx *rctx);
+void eip93_put_req_sa_record(struct eip93_device *eip93, struct eip93_cipher_reqctx *rctx);
+
 void eip93_unmap_dma(struct eip93_device *eip93, struct eip93_cipher_reqctx *rctx,
 		     struct scatterlist *reqsrc, struct scatterlist *reqdst);
 
diff --git a/drivers/crypto/inside-secure/eip93/eip93-common.c b/drivers/crypto/inside-secure/eip93/eip93-common.c
index beb7820..0b12e78 100644
--- a/drivers/crypto/inside-secure/eip93/eip93-common.c
+++ b/drivers/crypto/inside-secure/eip93/eip93-common.c
@@ -9,6 +9,8 @@
 #include <crypto/aes.h>
 #include <crypto/ctr.h>
 #include <crypto/hmac.h>
+#include <crypto/internal/aead.h>
+#include <crypto/internal/skcipher.h>
 #include <crypto/sha1.h>
 #include <crypto/sha2.h>
 #include <linux/kernel.h>
@@ -689,6 +691,141 @@ static int eip93_send_cipher_req(struct crypto_async_request *async, gfp_t gfp)
 	return eip93_skcipher_send_req(async, gfp);
 }
 
+/* sa_assoclen 的两个特殊值：记录里还没写关联数据偏移；有个请求正在写 */
+#define EIP93_SA_ASSOCLEN_UNSET		-1
+#define EIP93_SA_ASSOCLEN_WRITING	-2
+
+/* cra_init 用：分配加密、解密两份 SA 记录并整块映射给引擎，tfm 存续期间一直映射着 */
+int eip93_alloc_sa_records(struct eip93_crypto_ctx *ctx)
+{
+	ctx->sa_record = kcalloc(2, sizeof(*ctx->sa_record), GFP_KERNEL);
+	if (!ctx->sa_record)
+		return -ENOMEM;
+
+	ctx->sa_record_base = dma_map_single(ctx->eip93->dev, ctx->sa_record,
+					     2 * sizeof(*ctx->sa_record), DMA_TO_DEVICE);
+	if (dma_mapping_error(ctx->eip93->dev, ctx->sa_record_base)) {
+		kfree(ctx->sa_record);
+		ctx->sa_record = NULL;
+		return -ENOMEM;
+	}
+	ctx->sa_assoclen = EIP93_SA_ASSOCLEN_UNSET;
+
+	return 0;
+}
+
+void eip93_free_sa_records(struct eip93_crypto_ctx *ctx)
+{
+	if (!ctx->sa_record)
+		return;
+
+	dma_unmap_single(ctx->eip93->dev, ctx->sa_record_base,
+			 2 * sizeof(*ctx->sa_record), DMA_TO_DEVICE);
+	kfree(ctx->sa_record);
+}
+
+/*
+ * setkey、setauthsize 改写 tfm 的 SA 记录之前调：按 DMA API 的规程先把记录的所有权从设备收回（非一致的 MIPS 上 TO_DEVICE 的这一步不做 cache 操作）。
+ * 调用方保证 setkey、setauthsize 不与同一 tfm 上的请求并发（crypto API 的惯例，原驱动同样依赖它），这时没有请求在用这些记录。
+ */
+void eip93_sa_records_begin_update(struct eip93_crypto_ctx *ctx)
+{
+	dma_sync_single_for_cpu(ctx->eip93->dev, ctx->sa_record_base,
+				2 * sizeof(*ctx->sa_record), DMA_TO_DEVICE);
+}
+
+/*
+ * setkey、setauthsize 写好加密记录 [0] 之后调：由它派生解密记录 [1]，清掉关联数据偏移（由之后第一个 aead 请求写），再同步给设备。
+ * 方向与 aead 解密不输出 ICV 都是请求的属性；只有一份记录、由请求路径去改时，同一 tfm 上先解密后加密的请求会按解密方向执行，并发的请求会互相改掉对方的设置，所以按方向各备一份。
+ */
+void eip93_sa_records_end_update(struct eip93_crypto_ctx *ctx)
+{
+	struct sa_record *enc = &ctx->sa_record[0], *dec = &ctx->sa_record[1];
+
+	enc->sa_cmd1_word &= ~EIP93_SA_CMD_HASH_CRYPT_OFFSET;
+	memcpy(dec, enc, sizeof(*dec));
+	dec->sa_cmd0_word |= EIP93_SA_CMD_DIRECTION_IN;
+	/* aead 解密由引擎核对 ICV，不把它写进输出 */
+	dec->sa_cmd1_word &= ~(EIP93_SA_CMD_COPY_PAD | EIP93_SA_CMD_COPY_DIGEST);
+	WRITE_ONCE(ctx->sa_assoclen, EIP93_SA_ASSOCLEN_UNSET);
+
+	dma_sync_single_for_device(ctx->eip93->dev, ctx->sa_record_base,
+				   2 * sizeof(*ctx->sa_record), DMA_TO_DEVICE);
+}
+
+/*
+ * 给请求选 SA 记录，结果放进 rctx->sa_record_base；调用方先设好 rctx->flags、desc_flags 与 assoclen。
+ * skcipher 按方向直接用 tfm 的一份。
+ * aead 还要求记录里的关联数据偏移与本请求一致：setkey 之后第一个 aead 请求把自己的长度写进两份记录，之后同长度的请求（ESP 的一个 SA 上关联数据长度固定）直接用；长度不同的、或者碰上别的请求正在写的，用请求上下文里的私有副本并单独映射。
+ * 两份记录写好、同步给设备之后才发布 sa_assoclen，所以读到相同长度的请求看到的一定是写好的记录。
+ */
+int eip93_get_req_sa_record(struct eip93_crypto_ctx *ctx, struct eip93_cipher_reqctx *rctx)
+{
+	unsigned int dir = IS_DECRYPT(rctx->flags) ? 1 : 0;
+	struct device *dev = ctx->eip93->dev;
+	struct sa_record *sa;
+	int cur, i;
+
+	rctx->sa_record_private = false;
+	rctx->sa_record_base = ctx->sa_record_base + dir * sizeof(*sa);
+	if (!(rctx->desc_flags & EIP93_DESC_AEAD))
+		return 0;
+
+	/* 与下面的 smp_store_release() 配对：读到已发布的长度，就一定看得到写好的两份记录 */
+	cur = smp_load_acquire(&ctx->sa_assoclen);
+	if (cur == (int)rctx->assoclen)
+		return 0;
+
+	/* 只有从“未设”抢到“正在写”的那一个请求写记录；其余请求这时都走私有副本，没有人在用这两份记录 */
+	if (cur == EIP93_SA_ASSOCLEN_UNSET &&
+	    cmpxchg(&ctx->sa_assoclen, EIP93_SA_ASSOCLEN_UNSET,
+		    EIP93_SA_ASSOCLEN_WRITING) == EIP93_SA_ASSOCLEN_UNSET) {
+		dma_sync_single_for_cpu(dev, ctx->sa_record_base,
+					2 * sizeof(*sa), DMA_TO_DEVICE);
+		for (i = 0; i < 2; i++)
+			ctx->sa_record[i].sa_cmd1_word |=
+				FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
+					   rctx->assoclen / sizeof(u32));
+		dma_sync_single_for_device(dev, ctx->sa_record_base,
+					   2 * sizeof(*sa), DMA_TO_DEVICE);
+		/* 记录写好、同步给设备之后才发布长度 */
+		smp_store_release(&ctx->sa_assoclen, rctx->assoclen);
+		return 0;
+	}
+
+	/* 复制时别的请求可能正在给 tfm 的记录写偏移：写方对 sa_cmd1_word 整字读改写（结构是 __packed，编译成 lwl/lwr 与 swl/swr），只有 HASH_CRYPT_OFFSET（bits 23:16）变，其余字节写回原值；偏移字段这里随后重写 */
+	sa = &rctx->sa_record;
+	memcpy(sa, &ctx->sa_record[dir], sizeof(*sa));
+	sa->sa_cmd1_word &= ~EIP93_SA_CMD_HASH_CRYPT_OFFSET;
+	sa->sa_cmd1_word |= FIELD_PREP(EIP93_SA_CMD_HASH_CRYPT_OFFSET,
+				       rctx->assoclen / sizeof(u32));
+	rctx->sa_record_base = dma_map_single(dev, sa, sizeof(*sa), DMA_TO_DEVICE);
+	if (dma_mapping_error(dev, rctx->sa_record_base))
+		return -ENOMEM;
+	rctx->sa_record_private = true;
+
+	return 0;
+}
+
+/* 请求完成或没交出去时调：撤销私有副本的映射（用的是 tfm 的记录时什么都不做） */
+void eip93_put_req_sa_record(struct eip93_device *eip93, struct eip93_cipher_reqctx *rctx)
+{
+	if (rctx->sa_record_private)
+		dma_unmap_single(eip93->dev, rctx->sa_record_base,
+				 sizeof(rctx->sa_record), DMA_TO_DEVICE);
+}
+
+/* 积压链表里的请求是 skcipher 还是 aead，各自的请求上下文位置不同 */
+static struct eip93_cipher_reqctx *eip93_cipher_async_rctx(struct crypto_async_request *async)
+{
+	struct eip93_crypto_ctx *ctx = crypto_tfm_ctx(async->tfm);
+
+	if (ctx->type == EIP93_ALG_TYPE_AEAD)
+		return aead_request_ctx(aead_request_cast(async));
+
+	return skcipher_request_ctx(skcipher_request_cast(async));
+}
+
