 		     struct scatterlist *reqsrc, struct scatterlist *reqdst);
@@ -52,7 +62,37 @@ void eip93_unmap_dma(struct eip93_device *eip93, struct eip93_cipher_reqctx *rct
 void eip93_skcipher_handle_result(struct crypto_async_request *async, int err);
 
 int eip93_send_req(struct crypto_async_request *async,
-		   const u8 *reqiv, struct eip93_cipher_reqctx *rctx);
+		   const u8 *reqiv, struct eip93_cipher_reqctx *rctx, gfp_t gfp);
+
+int eip93_skcipher_send_req(struct crypto_async_request *async, gfp_t gfp);
+int eip93_aead_send_req(struct crypto_async_request *async, gfp_t gfp);
+
+int eip93_backlog_req(struct crypto_async_request *async);
+void eip93_dequeue_backlog(struct eip93_device *eip93);
+
+/*
+ * 把 skcipher/aead 请求交给 send()（eip93_skcipher_send_req 或 eip93_aead_send_req），分配标志按请求能否睡眠选。
+ * 环里放不下时：带 CRYPTO_TFM_REQ_MAY_BACKLOG 的进积压链表、返回 -EBUSY，由完成 tasklet 腾出位置后补交；
+ * 不带的返回 -ENOSPC（ESP 在软中断里以标志 0 发请求，按丢包处理）。积压链表非空时，新来的可积压请求直接排到后面，保持先后顺序。
+ * 内联进调用方：每个请求都走这里，send 成为直接调用
+ */
+static __always_inline int
+eip93_queue_req(struct crypto_async_request *async, struct eip93_device *eip93,
+		int (*send)(struct crypto_async_request *async, gfp_t gfp))
+{
+	bool may_backlog = async->flags & CRYPTO_TFM_REQ_MAY_BACKLOG;
+	int err;
+
+	if (unlikely(may_backlog && !list_empty(&eip93->ring->backlog)))
+		return eip93_backlog_req(async);
+
+	err = send(async, async->flags & CRYPTO_TFM_REQ_MAY_SLEEP ?
+		   GFP_KERNEL : GFP_ATOMIC);
+	if (unlikely(err == -ENOSPC) && may_backlog)
+		return eip93_backlog_req(async);
+
+	return err;
+}
 
 void eip93_handle_result(struct eip93_device *eip93, struct eip93_cipher_reqctx *rctx,
 			 u8 *reqiv);
