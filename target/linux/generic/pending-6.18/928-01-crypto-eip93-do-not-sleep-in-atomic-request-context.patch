+/*
+ * 工作队列：在可睡眠的上下文里重做 eip93_hash_defer() 转来的操作。先发 -EINPROGRESS，操作同步结束（没放描述符或出错）
+ * 时在这里补发结果，否则结果由完成 tasklet 发。
+ */
+void eip93_hash_work(struct work_struct *work)
+{
+	struct eip93_ring *ring = container_of(work, struct eip93_ring, hash_work);
+	struct crypto_async_request *async;
+	struct ahash_request *req;
+	int ret;
+	u8 op;
+
+	for (;;) {
+		scoped_guard(spinlock_bh, &ring->backlog_lock) {
+			async = list_first_entry_or_null(&ring->hash_backlog,
+							 struct crypto_async_request,
+							 list);
+			if (async)
+				list_del(&async->list);
+		}
+		if (!async)
+			return;
+
+		req = ahash_request_cast(async);
+		op = ((struct eip93_hash_reqctx *)ahash_request_ctx_dma(req))->deferred_op;
+		/* 回调与完成 tasklet 里的一样在关 BH 的上下文里调 */
+		local_bh_disable();
+		crypto_request_complete(async, -EINPROGRESS);
+		local_bh_enable();
+		ret = eip93_hash_run(req, op, true);
+		if (ret != -EINPROGRESS) {
+			local_bh_disable();
+			crypto_request_complete(async, ret);
+			local_bh_enable();
+		}
+	}
