-int check_valid_request(struct eip93_cipher_reqctx *rctx);
+/*
+ * eip93_scatter_combine() 给一个请求生成的描述符数的上限：每个描述符结束在 src 或 dst 一段的末尾，
+ * 或者结束在数据末尾、CTR 计数器回绕的分界上，后两种各至多一次；原地处理时 src、dst 是同一组段
+ */
+#define EIP93_REQ_MAX_DESC(inplace, src_nents, dst_nents) \
+	((inplace) ? max(src_nents, dst_nents) + 2 : (src_nents) + (dst_nents) + 2)
+
+int check_valid_request(struct eip93_cipher_reqctx *rctx, gfp_t gfp);
+
