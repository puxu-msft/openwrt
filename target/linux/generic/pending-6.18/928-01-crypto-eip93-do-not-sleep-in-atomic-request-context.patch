+static int eip93_hash_run(struct ahash_request *req, u8 op, bool may_sleep)
+{
+	switch (op) {
+	case EIP93_HASH_OP_UPDATE:
+		return eip93_hash_do_update(req, may_sleep);
+	case EIP93_HASH_OP_FINAL:
+		return eip93_hash_do_final(req, may_sleep);
+	default:
+		return eip93_hash_do_finup(req, may_sleep);
+	}
