+{
+	return eip93_hash_run(req, EIP93_HASH_OP_UPDATE,
+			      req->base.flags & CRYPTO_TFM_REQ_MAY_SLEEP);
+}
+
+static int eip93_hash_final(struct ahash_request *req)
+{
+	return eip93_hash_run(req, EIP93_HASH_OP_FINAL,
+			      req->base.flags & CRYPTO_TFM_REQ_MAY_SLEEP);
+}
+
+static int eip93_hash_finup(struct ahash_request *req)
+{
+	return eip93_hash_run(req, EIP93_HASH_OP_FINUP,
+			      req->base.flags & CRYPTO_TFM_REQ_MAY_SLEEP);
