 	return eth->ports[0];
 }
 
+/* For a frame marked CHECKSUM_UNNECESSARY: count what the GDM rule let through (struct en75_rx_csum_stats). The fields read share the cache line that eth_type_trans() reads next. */
+static void en75_rx_csum_audit(struct en75_rx_csum_stats *st,
+			       const struct sk_buff *skb, unsigned int proto_off)
+{
+	const void *l3 = skb->data + proto_off + 2;
+	unsigned int len;
+	u8 proto;
+
+	st->marked++;
+	if (skb_headlen(skb) < proto_off + 2)
+		goto unparsed;
+	len = skb_headlen(skb) - (proto_off + 2);
+	switch (get_unaligned_be16(skb->data + proto_off)) {
+	case ETH_P_IP: {
+		const struct iphdr *iph = l3;
+
+		if (len < sizeof(*iph))
+			goto unparsed;
+		if (ip_is_fragment(iph))
+			st->ipv4_frag++;
+		proto = iph->protocol;
+		break;
+	}
+	case ETH_P_IPV6:
+		if (len < sizeof(struct ipv6hdr))
+			goto unparsed;
+		proto = ((const struct ipv6hdr *)l3)->nexthdr;
+		break;
+	default:
+		goto unparsed;
+	}
+	if (proto != IPPROTO_TCP && proto != IPPROTO_UDP)
+		st->not_tcp_udp++;
+	return;
+unparsed:
+	st->unparsed++;
+}
+
 int en75_rx_before_recv(struct en75_eth *eth, struct sk_buff *skb,
-			enum etx_fport sport, u8 crsn, u16 ppe_entry)
