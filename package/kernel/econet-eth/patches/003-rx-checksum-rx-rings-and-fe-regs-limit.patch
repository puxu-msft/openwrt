 	struct en75_eth_pvt *ep = (struct en75_eth_pvt *) eth;
 	struct net_device *port;
+	unsigned int proto_off;
 
 	ep->crsn_count[crsn & 31]++;
 	port = en75_get_sport_dev(ep, sport);
-
 	/* the EtherType follows the 4-byte MediaTek tag on a DSA conduit */
+	proto_off = netdev_uses_dsa(port) ? 2 * ETH_ALEN + 4 : 2 * ETH_ALEN;
+
+	if (l4_csum_ok && (port->features & NETIF_F_RXCSUM)) {
+		skb->ip_summed = CHECKSUM_UNNECESSARY;
+		en75_rx_csum_audit(&ep->rx_csum, skb, proto_off);
+	}
