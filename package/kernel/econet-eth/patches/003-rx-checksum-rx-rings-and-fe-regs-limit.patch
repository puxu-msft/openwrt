@@ -643,6 +645,17 @@ static int en75_crsn_show(struct seq_file *m, void *v)
 }
 DEFINE_SHOW_ATTRIBUTE(en75_crsn);
 
+static int en75_rx_csum_show(struct seq_file *m, void *v)
+{
+	struct en75_rx_csum_stats *st = m->private;
+
+	seq_printf(m, "marked=%lu not_tcp_udp=%lu ipv4_frag=%lu unparsed=%lu\n",
+		   READ_ONCE(st->marked), READ_ONCE(st->not_tcp_udp),
+		   READ_ONCE(st->ipv4_frag), READ_ONCE(st->unparsed));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(en75_rx_csum);
