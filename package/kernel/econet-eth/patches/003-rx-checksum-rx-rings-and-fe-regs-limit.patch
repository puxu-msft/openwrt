--- a/econet_port.c
+++ b/econet_port.c
@@ -546,11 +546,11 @@ struct net_device *en75_alloc_gdm_port(struct en75_eth *eth,
 
 	/*
 	 * NETIF_F_IP_CSUM | NETIF_F_IPV6_CSUM | NETIF_F_SG | NETIF_F_TSO | NETIF_F_TSO6: TCP/UDP checksums (ICO for the IPv4 header, TCO/UCO) and TSO (MSS in the TCP checksum field) as the vendor qdma_bm_transmit_packet_tso does them for IPv4, one descriptor per buffer; IPv6 has no vendor precedent and was verified on GS2107 like IPv4, behind the MediaTek tag. en75_features_check() leaves other traffic to the stack. They pay off for traffic the router sends itself; forwarded TCP arrives as fraglist GRO and leaves as the original segments.
-	 * NETIF_F_RXCSUM: not offered: the GDM checks TCP/UDP checksums only with stag_en (gdm_regs.h), which is set only with the PPE, and that check is not relied on; received frames are CHECKSUM_NONE.
+	 * NETIF_F_RXCSUM: frames that pass the vendor rule on the GDM checksum bits (en75_erx_l4_csum_ok()) are CHECKSUM_UNNECESSARY, the rest CHECKSUM_NONE. On a DSA conduit the GDM parses received frames only with stag_en, which is set only with the PPE; without it every frame is CHECKSUM_NONE.
 	 * NETIF_F_HW_TC: with the PPE, fixed on, for nf_flowtable hardware offload (TC_SETUP_FT, econet_ppe.c).
