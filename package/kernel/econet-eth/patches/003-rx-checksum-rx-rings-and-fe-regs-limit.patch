 	if (ep->ppe)
-		en75_ppe_check_skb(ep->ppe, skb,
-				   netdev_uses_dsa(port) ? 2 * ETH_ALEN + 4 : 2 * ETH_ALEN,
-				   crsn, ppe_entry);
+		en75_ppe_check_skb(ep->ppe, skb, proto_off, crsn, ppe_entry);
 
 	skb->dev = port;
 	skb->protocol = eth_type_trans(skb, port);
@@ -278,13 +326,34 @@ static int en75_init_port(struct en75_eth_pvt *eth, struct device_node *np)
 	return 0;
 }
 
+/* RX descriptors of a ring that receives nothing in this setup (en75_prepare_qdma_cfg()). It is still filled and polled, so a frame the hardware does steer there is received; it only has less room for a burst. */
+#define EN75_RX_IDLE_DESCS	32
+
+/* Whether a GDM port will receive through QDMA @qdma_id: en75_init_port() gives the port with reg N the QDMA N. */
+static bool en75_qdma_has_port(struct device_node *parent, int qdma_id)
+{
+	struct device_node *np;
+	u32 reg;
+
+	for_each_available_child_of_node(parent, np) {
+		if (of_device_is_compatible(np, "econet,eth-mac") &&
+		    !of_property_read_u32(np, "reg", &reg) && reg == qdma_id) {
+			of_node_put(np);
+			return true;
+		}
+	}
+	return false;
+}
+
 static void en75_prepare_qdma_cfg(struct en75_qdma_cfg *cfg,
-				  const struct en75_soc_data *soc)
+				  const struct en75_soc_data *soc,
+				  bool has_port)
 {
 	memset(cfg, 0, sizeof(*cfg));
-	/* 512 RX descriptors per chain: with 128 the ring ran out (RX NO_DSCP) tens of thousands of times per minute while forwarding at 1 Gb/s, and each drop costs a TCP retransmit. */
-	for (int i = 0; i < QDMA_NUM_CHAINS; i++)
-		cfg->num_rx_descs[i] = 512;
+	/* 512 RX descriptors on ring 0 of a QDMA with a port: with 128 the ring ran out (RX NO_DSCP) tens of thousands of times per minute while forwarding at 1 Gb/s, and each drop costs a TCP retransmit. A QDMA without a port never enables its RX DMA (en75_qdma_use() runs from ndo_open only). Ring 1 gets the frames whose CPU reason CDMA1_CRSN_QSEL (FE+0x410..0x41c, 4 bits per reason) steers to it; the driver leaves those registers at their reset value, and on GS2107 no frame reached ring 1 or QDMA1 under bulk TCP both ways, a 38,700-packet multicast and broadcast flood and PPE flow learning (2026-11-14). The vendor fe_core maps CPU reasons 8 (IPv4 fragment), 21, 22, 24 and 25 to ring 1 (fe_core init 0x1b0..0x228); programming it that way needs ring 1 sized like ring 0. The idle rings would otherwise hold 512 buffers of 2 KiB each. */
+	cfg->num_rx_descs[0] = has_port ? 512 : EN75_RX_IDLE_DESCS;
+	for (int i = 1; i < QDMA_NUM_CHAINS; i++)
+		cfg->num_rx_descs[i] = EN75_RX_IDLE_DESCS;
 	for (int i = 0; i < QDMA_NUM_CHAINS; i++)
 		cfg->num_tx_descs[i] = 128;
 	for (int i = 0; i < QDMA_NUM_TX_DONE; i++)
@@ -402,7 +471,8 @@ static int en75_probe(struct platform_device *pdev)
 	BUILD_BUG_ON(ARRAY_SIZE(eth->qdma) != ARRAY_SIZE(regs->qdma_regs));
 	BUILD_BUG_ON(ARRAY_SIZE(eth->qdma) != ARRAY_SIZE(eth->qdma_irq) * QDMA_NUM_IRQS);
 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
-		en75_prepare_qdma_cfg(&cfg, eth->soc);
+		en75_prepare_qdma_cfg(&cfg, eth->soc,
+				      en75_qdma_has_port(pdev->dev.of_node, i));
 		eth->qdma[i] = en75_qdma_new(&eth->pub, &regs->qdma_regs[i], i,
 					     &eth->qdma_irq[i * QDMA_NUM_IRQS],
 					     QDMA_NUM_IRQS, &cfg,
@@ -440,6 +510,7 @@ static int en75_probe(struct platform_device *pdev)
 	}
 
 	debug_conf.crsn_count = eth->crsn_count;
+	debug_conf.rx_csum = &eth->rx_csum;
 	eth->debug = en75_debugfs_init(&debug_conf);
 
 	/* Configure the MT7530 as a dumb switch, unless it is managed by DSA */
