+/* The CHECKSUM_UNNECESSARY rule of the vendor eth_rx, bit for bit (eth.ko 0x11a4..0x11dc, 0x1410..0x1420): IP4 or IP6 set, L4VLD set, L4F and IP4F clear, source port not 0 or 5 (the CPU ports). Whether the GDM sets L4VLD on frames whose TCP/UDP checksum it cannot have checked (another IP protocol, an IPv4 fragment) is not verified; debugfs rx_csum counts such frames among those marked. Without stag_en the GDM does not report IP4/IP6 for frames behind the MediaTek tag (seen on GS2107), so none is marked. */
+static bool en75_erx_l4_csum_ok(struct qdma_desc_erx *erx)
+{
+	u32 w = erx->bitfield_0;
+	u8 sport = get_erx_sport(erx);
+
+	if (sport == ETX_FPORT_QDMA0_CPU || sport == ETX_FPORT_QDMA1_CPU)
+		return false;
+	return (w & (ERX_IP4 | ERX_IP6)) &&
+	       (w & (ERX_IP4F | ERX_L4VLD | ERX_L4F)) == ERX_L4VLD;
+}
+
 static void en75_qdma_rx_process_one(struct en75_q_rx *q, u32 cpu_i,
 				     enum dma_data_direction dir)
 {
@@ -241,14 +253,14 @@ static void en75_qdma_rx_process_one(struct en75_q_rx *q, u32 cpu_i,
 	skb_reserve(skb, EN75_RX_HEADROOM);
 	__skb_put(skb, len);
 	skb_mark_for_recycle(skb);
-	/* ip_summed stays CHECKSUM_NONE: the GDM only checks TCP/UDP checksums when it parses the MediaTek tag (stag_en, see gdm_regs.h), which is set only with the PPE and not relied on, so the stack verifies everything. */
 
 	/* skb->hash stays unset: the PPE entry index in the descriptor is the same for every frame the engine does not learn (all of them while it is off), and a constant L4 hash sends all flows to one RPS CPU. The flow dissector hashes through the DSA tag. */
 
 	sport = get_erx_sport(&desc.msg.erx);
 	if (en75_rx_before_recv(q->qdma->eth, skb, sport,
 				get_erx_crsn(&desc.msg.erx),
-				get_erx_ppe_entry(&desc.msg.erx)))
+				get_erx_ppe_entry(&desc.msg.erx),
+				en75_erx_l4_csum_ok(&desc.msg.erx)))
 		dev_kfree_skb(skb);
 	else
 		napi_gro_receive(&q->napi, skb);
