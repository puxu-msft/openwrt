 	/**
 	 * See accessors:
@@ -656,42 +648,60 @@ struct gdm {
 };
 
 /**
- * Bitfield accessors for: gdm_vlan bitfield_0
+ * Bitfield accessors for: struct gdm_vlan
+ * TPID 在高半字、标志在低半字（原厂 fe_api_set_ins_vlan_tpid、fe_api_set_vlan_enable、macEN7512STagEnable；复位值 0x81000000）；字段是整字上的掩码，与 CPU 字节序无关。
  */
 
+#define GDM_VLAN_TPID_MASK				GENMASK(31, 16)
 #define GDM_VLAN_URX					BIT(1)
 #define GDM_VLAN_STAG_PARSE				BIT(0)
 
+/** DMA 插入的 VLAN 标签的 TPID（复位值 0x8100） */
+static inline u16 get_gdm_vlan_tpid(struct gdm_vlan *x) {
+	return FIELD_GET(GDM_VLAN_TPID_MASK, x->word);
+}
+static inline void set_gdm_vlan_tpid(struct gdm_vlan *x, u16 v) {
+	x->word = FIELD_SET(x->word, GDM_VLAN_TPID_MASK, v);
+}
 
 /** Vendor fe_api_set_vlan_enable writes this bit; its effect is not verified */
 static inline bool is_gdm_vlan_urx(struct gdm_vlan *x) {
-	return FIELD_GET(GDM_VLAN_URX, x->bitfield_0);
+	return FIELD_GET(GDM_VLAN_URX, x->word);
 }
 static inline void set_gdm_vlan_urx(struct gdm_vlan *x, bool v) {
-	x->bitfield_0 = FIELD_SET(x->bitfield_0, GDM_VLAN_URX, v);
+	x->word = FIELD_SET(x->word, GDM_VLAN_URX, v);
 }
 
 /** The DMA parses the MediaTek special tag that the CPU writes into the frame (vendor CDMA_VLAN_CTRL bit0, set by macEN7512STagEnable). TX checksum offload and TSO of tagged frames need it: on GS2107 the checksums came out wrong without it. */
 static inline bool is_gdm_vlan_stag_parse(struct gdm_vlan *x) {
-	return FIELD_GET(GDM_VLAN_STAG_PARSE, x->bitfield_0);
+	return FIELD_GET(GDM_VLAN_STAG_PARSE, x->word);
 }
 static inline void set_gdm_vlan_stag_parse(struct gdm_vlan *x, bool v) {
-	x->bitfield_0 = FIELD_SET(x->bitfield_0, GDM_VLAN_STAG_PARSE, v);
+	x->word = FIELD_SET(x->word, GDM_VLAN_STAG_PARSE, v);
 }
 
 /**
- * Bitfield accessors for: gdm_pppoe bitfield_0
+ * Bitfield accessors for: struct gdm_pppoe
+ * 位置沿用本驱动原先按大端 EN751221 排布的结构体（标志在高半字、会话号在低半字），未与原厂代码核对、未实测；驱动不用这个寄存器。
  */
 
-#define GDM_PPPOE_TTX					BIT(0)
-
+#define GDM_PPPOE_TTX					BIT(16)
+#define GDM_PPPOE_ID_MASK				GENMASK(15, 0)
 
 /** Insert PPPoE header on transmitted packets */
 static inline bool is_gdm_pppoe_ttx(struct gdm_pppoe *x) {
-	return FIELD_GET(GDM_PPPOE_TTX, x->bitfield_0);
+	return FIELD_GET(GDM_PPPOE_TTX, x->word);
 }
 static inline void set_gdm_pppoe_ttx(struct gdm_pppoe *x, bool v) {
-	x->bitfield_0 = FIELD_SET(x->bitfield_0, GDM_PPPOE_TTX, v);
+	x->word = FIELD_SET(x->word, GDM_PPPOE_TTX, v);
+}
+
+/** PPPoE Session ID to insert on transmitted packets */
+static inline u16 get_gdm_pppoe_id(struct gdm_pppoe *x) {
+	return FIELD_GET(GDM_PPPOE_ID_MASK, x->word);
+}
+static inline void set_gdm_pppoe_id(struct gdm_pppoe *x, u16 v) {
+	x->word = FIELD_SET(x->word, GDM_PPPOE_ID_MASK, v);
 }
 
