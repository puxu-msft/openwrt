+/* 表项的元组：IPv4 打 "a.b.c.d:port"，IPv6 打 "[addr]:port"（每字主机序数值还原成网络序）。 */
+static void en75_seq_tuple4(struct seq_file *m, const char *name, u32 ip, u16 port)
+{
+	__be32 a = cpu_to_be32(ip);
+
+	seq_printf(m, " %s=%pI4:%u", name, &a, port);
+}
+
+static void en75_seq_tuple6(struct seq_file *m, const char *name, const u32 *ip, u16 port)
+{
+	struct in6_addr a;
+	int i;
+
+	for (i = 0; i < 4; i++)
+		a.s6_addr32[i] = cpu_to_be32(ip[i]);
+	seq_printf(m, " %s=[%pI6c]:%u", name, &a, port);
+}
+
+static void en75_seq_entry(struct seq_file *m, struct en75_foe_entry *e, u32 ib1)
+{
+	u32 type = FIELD_GET(FOE_IB1_PACKET_TYPE, ib1);
+	struct en75_foe_mac_info *l2 = en75_foe_l2(e, type);
+	u32 ib2 = READ_ONCE(*en75_foe_ib2(e, type));
+	u8 dmac[ETH_ALEN], smac[ETH_ALEN];
+
+	seq_printf(m, " type=%u udp=%d layer=%lu pppoe=%d vpm=%lu ttl=%d cache=%d",
+		   type, !!(ib1 & FOE_IB1_UDP),
+		   FIELD_GET(FOE_IB1_BIND_VLAN_LAYER, ib1),
+		   !!(ib1 & FOE_IB1_BIND_PPPOE), FIELD_GET(FOE_IB1_BIND_VPM, ib1),
+		   !!(ib1 & FOE_IB1_BIND_TTL), !!(ib1 & FOE_IB1_BIND_CACHE));
+	switch (type) {
+	case FOE_TYPE_IPV4_HNAPT:
+		en75_seq_tuple4(m, "src", READ_ONCE(e->ipv4.orig.src_ip),
+				READ_ONCE(e->ipv4.orig.src_port));
+		en75_seq_tuple4(m, "dst", READ_ONCE(e->ipv4.orig.dest_ip),
+				READ_ONCE(e->ipv4.orig.dest_port));
+		en75_seq_tuple4(m, "new_src", READ_ONCE(e->ipv4.new.src_ip),
+				READ_ONCE(e->ipv4.new.src_port));
+		en75_seq_tuple4(m, "new_dst", READ_ONCE(e->ipv4.new.dest_ip),
+				READ_ONCE(e->ipv4.new.dest_port));
+		break;
+	case FOE_TYPE_IPV6_ROUTE_5T:
+		en75_seq_tuple6(m, "src", e->ipv6.orig.src_ip,
+				READ_ONCE(e->ipv6.orig.src_port));
+		en75_seq_tuple6(m, "dst", e->ipv6.orig.dest_ip,
+				READ_ONCE(e->ipv6.orig.dest_port));
+		break;
+	default:
+		break;
+	}
+	put_unaligned_be32(READ_ONCE(l2->dest_mac_hi), dmac);
+	put_unaligned_be16(READ_ONCE(l2->dest_mac_lo), dmac + 4);
+	put_unaligned_be32(READ_ONCE(l2->src_mac_hi), smac);
+	put_unaligned_be16(READ_ONCE(l2->src_mac_lo), smac + 4);
+	seq_printf(m, " ib2=%08x dport=%lu ds=0x%02lx etype=0x%04x vlan1=0x%04x vlan2=0x%04x sid=%u dmac=%pM smac=%pM",
+		   ib2, FIELD_GET(FOE_IB2_DEST_PORT, ib2), FIELD_GET(FOE_IB2_TOS, ib2),
+		   READ_ONCE(l2->etype), READ_ONCE(l2->vlan1), READ_ONCE(l2->vlan2),
+		   READ_ONCE(l2->pppoe_id), dmac, smac);
+}
+
+/* debugfs ppe_entries：表中所有有效表项逐条解码（状态、类型、ib1 各位、元组、ib2、L2 块），加原始 20 个字。按表项号逐条迭代，seq_file 每次只缓冲一页，表满（16K 条）也不必一次格式化全部输出。 */
+static void *en75_ppe_entries_start(struct seq_file *m, loff_t *pos)
+{
+	return *pos < PPE_ENTRIES ? pos : NULL;
+}
+
+static void *en75_ppe_entries_next(struct seq_file *m, void *v, loff_t *pos)
+{
+	++*pos;
+	return *pos < PPE_ENTRIES ? pos : NULL;
+}
+
+static void en75_ppe_entries_stop(struct seq_file *m, void *v)
+{
+}
+
+static int en75_ppe_entries_show(struct seq_file *m, void *v)
+{
+	static const char * const state_name[] = { "invalid", "unbind", "bind", "fin" };
+	unsigned int i = *(loff_t *)v;
+	struct en75_foe_entry *e = ppe_entry(m->private, i);
+	u32 ib1 = READ_ONCE(e->ib1);
+	int w;
+
+	if (!FIELD_GET(FOE_IB1_STATE, ib1))
+		return 0;
+	seq_printf(m, "idx=%u state=%s", i, state_name[FIELD_GET(FOE_IB1_STATE, ib1)]);
+	en75_seq_entry(m, e, ib1);
+	seq_printf(m, " raw=%08x", ib1);
+	for (w = 0; w < ARRAY_SIZE(e->data); w++)
+		seq_printf(m, ",%08x", READ_ONCE(e->data[w]));
+	seq_putc(m, '\n');
+	return 0;
+}
+
+const struct seq_operations en75_ppe_entries_seq_ops = {
+	.start = en75_ppe_entries_start,
+	.next = en75_ppe_entries_next,
+	.stop = en75_ppe_entries_stop,
+	.show = en75_ppe_entries_show,
+};
+
+/* debugfs ppe_flows：驱动接受的每条流一行——cookie、入向口与规则里的入向 VLAN、出向口，期望的表项（类型、出向封装、元组），是否已绑定、表项号、空闲秒数、绑定次数与最近一次触发帧的封装。锁按桶取放，读这个文件不会长时间挡住 NAPI 里的绑定请求。 */
+int en75_ppe_flows_show(struct seq_file *m, struct en75_ppe *ppe)
+{
+	unsigned int b;
+
+	for (b = 0; b < PPE_FLOW_BUCKETS; b++) {
+		struct en75_flow *flow;
+
+		spin_lock_bh(&ppe->lock);
+		hlist_for_each_entry(flow, &ppe->buckets[b], list) {
+			u32 ib1 = 0;
+			bool bound = ppe_flow_bound(ppe, flow, &ib1);
+
+			seq_printf(m, "cookie=%lx in_port=%d in_vlan=%u", flow->cookie,
+				   flow->in_port, flow->in_nvlan);
+			if (flow->in_nvlan)
+				seq_printf(m, ":%u", flow->in_vid[0]);
+			if (flow->in_nvlan > 1)
+				seq_printf(m, ",%u", flow->in_vid[1]);
+			seq_printf(m, " out_port=%d bound=%d index=%d binds=%lu last_req=%s",
+				   flow->out_port, bound, bound ? flow->index : -1,
+				   flow->binds,
+				   flow->binds ? en75_encap_name[flow->req_kind] : "-");
+			if (bound)
+				seq_printf(m, " idle=%lu",
+					   (ppe_timestamp(ppe) - FIELD_GET(FOE_IB1_BIND_TS, ib1)) &
+					   FOE_IB1_BIND_TS);
+			en75_seq_entry(m, &flow->data, flow->data.ib1);
+			seq_putc(m, '\n');
+		}
+		spin_unlock_bh(&ppe->lock);
+	}
+	return 0;
+}
