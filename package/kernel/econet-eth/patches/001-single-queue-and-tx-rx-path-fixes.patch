-		cfg->num_rx_descs[i] = 128;
+		cfg->num_rx_descs[i] = 512;
 	for (int i = 0; i < QDMA_NUM_CHAINS; i++)
 		cfg->num_tx_descs[i] = 128;
 	for (int i = 0; i < QDMA_NUM_TX_DONE; i++)
diff --git a/econet_eth.h b/econet_eth.h
index 187371b..f3b5eaa 100644
--- a/econet_eth.h
+++ b/econet_eth.h
@@ -30,15 +30,20 @@ struct en75_soc_data {
  * boundary. */
 #define EN75_MAX_PACKET_SIZE	2048
 
+/* RX buffers start with NET_SKB_PAD of headroom and the QDMA writes each frame 2 more bytes in (RX_2B_OFFSET), so the IP header behind a 14-byte Ethernet header or an 18-byte MediaTek-tagged one is 4-byte aligned (MIPS traps on unaligned loads and emulates them) and forwarding pushes its headers without reallocating the skb. */
+#define EN75_RX_HW_OFFSET	2
+#define EN75_RX_HEADROOM	(NET_SKB_PAD + EN75_RX_HW_OFFSET)
+/* Largest frame (with FCS) one RX buffer holds. The MTU is capped so that the GDM, which drops frames longer than ETH_HLEN + mtu + ETH_FCS_LEN, never passes a frame that would need a second descriptor. */
+#define EN75_RX_MAX_FRAME	(SKB_WITH_OVERHEAD(EN75_MAX_PACKET_SIZE) - EN75_RX_HEADROOM)
+
+/* TX descriptors one skb can take: the linear part plus every page fragment. */
+#define EN75_TX_MAX_DESCS	(MAX_SKB_FRAGS + 1)
+
 /* Internally these are properties of the QDMA engine, but they are important
  * to the GDM port driver because they define how QoS can be done. */
 #define EN75_NUM_QUEUES		8
 #define EN75_NUM_CHANNELS	32
 
-/* Number of queues reported to the kernel.
- * Currently every chan/queue is made available. */
-#define EN75_NUM_SOFT_QUEUES	(EN75_NUM_CHANNELS * EN75_NUM_QUEUES)
-
 /* A chain is 1 TX ring + 1 RX ring, each QDMA has 2 chains. */
 #define QDMA_NUM_CHAINS		2
 /* Each QDMA has one queue of TX-complete notifications. */
@@ -199,7 +204,9 @@ int en75_qdma_use(struct en75_qdma *qdma);
 int en75_qdma_unuse(struct en75_qdma *qdma);
 int en75_qdma_destroy(struct en75_qdma *qdma);
 int en75_qdma_xmit(struct en75_qdma *qdma, struct sk_buff *skb,
-		   union desc_msg *msg, int qid);
+		   union desc_msg *msg, int qid, struct netdev_queue *txq);
+bool en75_qdma_tx_has_room(struct en75_qdma *qdma, int qid);
+void en75_qdma_tx_flush(struct en75_qdma *qdma, int qid);
 
 
 struct net_device *en75_alloc_gdm_port(struct en75_eth *eth,
