-	ndev = devm_alloc_etherdev_mqs(eth->dev, sizeof(*port),
-				       EN75_NUM_SOFT_QUEUES,
-				       EN75_NUM_SOFT_QUEUES);
+	/* One TX queue per port: every packet goes to the same hardware TX ring (en75_qdma_xmit() qid 0), so one queue lets BQL bound the ring and lets the qdisc (fq_codel) do flow fairness. Exposing the 256 channel/queue pairs as netdev queues only multiplied qdiscs and per-queue state without changing what reaches the hardware. */
+	ndev = devm_alloc_etherdev_mqs(eth->dev, sizeof(*port), 1, 1);
 	if (!ndev) {
 		dev_err(eth->dev, "alloc_etherdev failed\n");
 		return ERR_PTR(-ENOMEM);
@@ -428,24 +501,18 @@ struct net_device *en75_alloc_gdm_port(struct en75_eth *eth,
 
 	ndev->netdev_ops = &en75_netdev_ops;
 	ndev->ethtool_ops = &en75_ethtool_ops;
-	ndev->max_mtu = EN75_MAX_PACKET_SIZE;
+	ndev->max_mtu = EN75_RX_MAX_FRAME - ETH_HLEN - ETH_FCS_LEN;
 	ndev->watchdog_timeo = 5 * HZ;
 
 	/*
-	 * This driver is meant to forward packets, not send/receive them.
-	 * Therefore most features are not that useful.
-	 *
-	 * NETIF_F_TSO | NETIF_F_TSO6:
-	 *   - Supported in EN751627, not in EN751221, not used in forwarding.
-	 *
-	 * NETIF_F_IP_CSUM | NETIF_F_RXCSUM | NETIF_F_IPV6_CSUM:
-	 *   - Supported but disabled for simplicity.
-	 *
-	 * NETIF_F_HW_TC:
-	 *   - TODO: When we get the PPE working, we will enable this for
-	 *           TC_SETUP_BLOCK / TC_SETUP_FT for NAT flow-table offloading.
+	 * NETIF_F_IP_CSUM | NETIF_F_IPV6_CSUM | NETIF_F_SG | NETIF_F_TSO | NETIF_F_TSO6: TCP/UDP checksums (ICO for the IPv4 header, TCO/UCO) and TSO (MSS in the TCP checksum field) as the vendor qdma_bm_transmit_packet_tso does them for IPv4, one descriptor per buffer; IPv6 has no vendor precedent and was verified on GS2107 like IPv4, behind the MediaTek tag. en75_features_check() leaves other traffic to the stack. They pay off for traffic the router sends itself; forwarded TCP arrives as fraglist GRO and leaves as the original segments.
+	 * NETIF_F_RXCSUM: not offered, the GDM does not check checksums without stag_en (gdm_regs.h); received frames are CHECKSUM_NONE.
+	 * NETIF_F_HW_TC: TODO: When we get the PPE working, we will enable this for TC_SETUP_BLOCK / TC_SETUP_FT for NAT flow-table offloading.
 	 */
-	ndev->hw_features = 0;
+	ndev->hw_features = NETIF_F_IP_CSUM | NETIF_F_IPV6_CSUM | NETIF_F_SG |
+			    NETIF_F_TSO | NETIF_F_TSO6;
+	/* A frame on the ring stays below 64 KiB (the vendor driver refuses longer ones); on this device skb->len already counts the Ethernet header and the MediaTek tag. */
+	netif_set_tso_max_size(ndev, 0xffff);
 
 	ndev->features |= ndev->hw_features;
 	ndev->vlan_features = ndev->hw_features;
diff --git a/econet_qdma.c b/econet_qdma.c
index 555d0d6..63090d6 100644
--- a/econet_qdma.c
+++ b/econet_qdma.c
@@ -7,6 +7,8 @@
 #include <net/dsa.h>
 #include <linux/platform_device.h>
