+/* Have the DMA parse the MediaTek special tag that DSA writes after the source MAC of the frames we send (vendor macEN7512STagEnable, GDM_VLAN_STAG_PARSE). TX checksum offload and TSO are requested only while it does, because without it the hardware gets the header offsets wrong (seen on GS2107: wrong checksums, and a TSO frame stalled the TX DMA). The receive side (stag_en) stays off, see gdm_regs.h. */
+static void en75_set_dsa_tag_parse(struct en75_gdm_port *port, bool on)
+{
+	struct gdm_vlan vlan;
+
+	guard(spinlock_bh)(&port->reg_lock);
+	vlan = en75_rreg(&port->regs->vlan);
+	set_gdm_vlan_stag_parse(&vlan, on);
+	en75_wreg(vlan, &port->regs->vlan);
+	/* read back so the write has landed before a frame relies on it */
+	en75_rreg(&port->regs->vlan);
+	WRITE_ONCE(port->stag_parse, on);
+}
