+/* Stop the queue, then re-check the ring under its lock: a completion that ran between "ring full" and the stop saw the queue awake and did not wake it, so without the re-check the queue could stay stopped forever. */
+static void en75_stop_queue_if_full(struct en75_gdm_port *port,
+				    struct netdev_queue *txq)
+{
+	netif_tx_stop_queue(txq);
+	smp_mb__after_atomic();
+	if (en75_qdma_tx_has_room(port->qdma, 0))
+		netif_tx_wake_queue(txq);
+}
+
+/* Checksum offload and TSO are verified for IPv4/IPv6 TCP/UDP behind the MediaTek tag only, with the DMA parsing that tag; the stack does the rest in software. DSA passes these features on to VLAN uppers of the user ports, whose frames carry an 802.1Q header. */
+static netdev_features_t en75_features_check(struct sk_buff *skb,
+					     struct net_device *dev,
+					     netdev_features_t features)
+{
+	struct en75_gdm_port *port = netdev_priv(dev);
