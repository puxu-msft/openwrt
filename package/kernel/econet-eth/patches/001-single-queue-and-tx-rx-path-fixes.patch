+/*
+ * fe_regs: raw access to the frame engine register window, for bringing up blocks the driver does not drive yet (the PPE). The file offset is the register offset; every transfer is whole, aligned 32-bit words in CPU byte order. Reads have the side effects of the registers read (clear-on-read counters).
+ */
+static ssize_t en75_fe_regs_xfer(struct file *file, char __user *ubuf,
+				 const char __user *wbuf, size_t len, loff_t *ppos)
+{
+	struct en75_debug *debug = file->private_data;
+	loff_t pos = *ppos;
+	size_t done;
+
+	if ((pos | len) & 3)
+		return -EINVAL;
+	if (pos >= debug->config.fe_regs_len)
+		return 0;
+	len = min_t(size_t, len, debug->config.fe_regs_len - pos);
+
+	for (done = 0; done < len; done += 4) {
+		void __iomem *reg = debug->config.fe_regs + pos + done;
+		u32 val;
+
+		if (wbuf) {
+			if (copy_from_user(&val, wbuf + done, 4))
+				break;
+			writel(val, reg);
+		} else {
+			val = readl(reg);
+			if (copy_to_user(ubuf + done, &val, 4))
+				break;
+		}
+	}
+	if (!done)
+		return -EFAULT;
+	*ppos = pos + done;
+	return done;
+}
+
+static ssize_t en75_fe_regs_read(struct file *file, char __user *buf,
+				 size_t len, loff_t *ppos)
+{
+	return en75_fe_regs_xfer(file, buf, NULL, len, ppos);
+}
+
+static ssize_t en75_fe_regs_write(struct file *file, const char __user *buf,
+				  size_t len, loff_t *ppos)
+{
+	return en75_fe_regs_xfer(file, NULL, buf, len, ppos);
+}
+
+static const struct file_operations en75_fe_regs_fops = {
+	.owner   = THIS_MODULE,
+	.open    = simple_open,
+	.read    = en75_fe_regs_read,
+	.write   = en75_fe_regs_write,
+	.llseek  = default_llseek,
+};
