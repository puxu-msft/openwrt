 				  const struct en75_soc_data *soc)
 {
 	memset(cfg, 0, sizeof(*cfg));
+	/* 512 RX descriptors per chain: with 128 the ring ran out (RX NO_DSCP) tens of thousands of times per minute while forwarding at 1 Gb/s, and each drop costs a TCP retransmit. */
