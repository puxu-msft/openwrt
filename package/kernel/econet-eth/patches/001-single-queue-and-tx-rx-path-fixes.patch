+/* Stop the queue, then re-check the ring under its lock: a completion that ran between "ring full" and the stop saw the queue awake and did not wake it, so without the re-check the queue could stay stopped forever. */
+static void en75_stop_queue_if_full(struct en75_gdm_port *port,
+				    struct netdev_queue *txq)
+{
+	netif_tx_stop_queue(txq);
+	smp_mb__after_atomic();
+	if (en75_qdma_tx_has_room(port->qdma, 0))
+		netif_tx_wake_queue(txq);
+}
+
+/* Checksum offload and TSO are verified for IPv4/IPv6 TCP/UDP behind the MediaTek tag only, with the DMA parsing that tag; the stack does the rest in software. DSA passes these features on to VLAN uppers of the user ports, whose frames carry an 802.1Q header. */
+static netdev_features_t en75_features_check(struct sk_buff *skb,
+					     struct net_device *dev,
+					     netdev_features_t features)
+{
+	struct en75_gdm_port *port = netdev_priv(dev);
+
+	bool dsa = netdev_uses_dsa(dev);
+
+	if (unlikely(!READ_ONCE(port->stag_parse)) && dsa) {
+		en75_set_dsa_tag_parse(port, true);
+		netdev_info(dev, "DSA conduit: TX checksum offload and TSO in use\n");
+	}
+	if (!dsa || !READ_ONCE(port->stag_parse) ||
+	    (skb->protocol != htons(ETH_P_IP) && skb->protocol != htons(ETH_P_IPV6)) ||
+	    skb->encapsulation || skb_vlan_tag_present(skb))
+		features &= ~(NETIF_F_CSUM_MASK | NETIF_F_GSO_MASK);
+	return features;
+}
+
 static netdev_tx_t en75_dev_xmit(struct sk_buff *skb, struct net_device *dev)
 {
 	struct en75_gdm_port *port = netdev_priv(dev);
-	int qid, ret = 0, len = skb->len;
-	struct netdev_queue *txq;
+	struct netdev_queue *txq = netdev_get_tx_queue(dev, 0);
 	union desc_msg msg = {0};
+	int ret;
 
-	qid = skb_get_queue_mapping(skb);
-	set_etx_channel(&msg.etx, qid / EN75_NUM_QUEUES);
-	set_etx_queue(&msg.etx, qid % EN75_NUM_QUEUES);
+	set_etx_channel(&msg.etx, 0);
+	set_etx_queue(&msg.etx, 0);
 	set_etx_fport(&msg.etx, port->fport);
 
-	txq = netdev_get_tx_queue(dev, qid);
-
-	/* Non-linear skbs are unsupported, we shouldn't get them but
-	 * if we do, we'll attempt to linearize. */
-	if (skb_linearize(skb))
-		goto error;
-
-	netdev_tx_sent_queue(txq, len);
+	/* en75_features_check() lets only IPv4/IPv6 reach here with CHECKSUM_PARTIAL or GSO, and the core only hands over TCP/UDP checksums right behind the IP header; the hardware parses the headers itself. IPv6 UDP is checksummed in software: a computed zero must go out as 0xffff there (RFC 8200 8.1), which the hardware was not verified to do. */
+	if (skb->ip_summed == CHECKSUM_PARTIAL) {
+		bool v4 = skb->protocol == htons(ETH_P_IP);
+		u8 proto = v4 ? ip_hdr(skb)->protocol : ipv6_hdr(skb)->nexthdr;
+
+		if (proto == IPPROTO_TCP) {
+			set_etx_tco(&msg.etx, true);
+			set_etx_ico(&msg.etx, v4);
+		} else if (proto == IPPROTO_UDP && v4) {
+			set_etx_uco(&msg.etx, true);
+			set_etx_ico(&msg.etx, true);
+		} else if (skb_checksum_help(skb)) {
+			goto drop;
+		}
+	}
+	if (skb_is_gso(skb)) {
+		if (skb_cow_head(skb, 0))
+			goto drop;
+		tcp_hdr(skb)->check = (__force __sum16)htons(skb_shinfo(skb)->gso_size);
+		/* as the vendor driver does: TSO with IP and TCP checksums, whatever ip_summed says */
+		if (skb->protocol == htons(ETH_P_IP))
+			set_etx_ico(&msg.etx, true);
+		set_etx_tco(&msg.etx, true);
+		set_etx_tso(&msg.etx, true);
+	}
 
-	ret = en75_qdma_xmit(port->qdma, skb, &msg, 0);
+	/* Each buffer goes out as its own descriptor, and an empty linear part cannot. */
+	if (unlikely(!skb_headlen(skb)) && skb_linearize(skb))
+		goto drop;
 
-	if (ret < 0) {
-		netdev_tx_completed_queue(txq, 1, len);
-		goto error;
+	ret = en75_qdma_xmit(port->qdma, skb, &msg, 0, txq);
+	if (ret == -EBUSY) {
+		/* Ring full, nothing queued: the stack requeues this skb, so it must not be freed. Not expected, since the queue is stopped as soon as the ring has no room left. */
+		en75_stop_queue_if_full(port, txq);
+		return NETDEV_TX_BUSY;
 	}
+	if (ret < 0)
+		goto drop;
 
 	if (ret == EBUSY)
-		netif_tx_stop_queue(txq);
+		en75_stop_queue_if_full(port, txq);
 
 	return NETDEV_TX_OK;
 
-error:
+drop:
+	/* the frames queued before this one with xmit_more set still need their doorbell */
+	if (!netdev_xmit_more())
+		en75_qdma_tx_flush(port->qdma, 0);
 	dev_kfree_skb_any(skb);
 	dev->stats.tx_dropped++;
-
-	if (ret == -EBUSY) {
-		netif_tx_stop_queue(txq);
-		return NETDEV_TX_BUSY;
-	}
-
 	return NETDEV_TX_OK;
 }
 
