+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef ECONET_PPE_H
+#define ECONET_PPE_H
+
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <linux/types.h>
+
+struct device;
+struct seq_file;
+struct en75_ppe;
+
+/* PPE register block, relative to the frame engine base (the MT7621-generation layout: block at FE+0xc00, registers from +0x200). */
+#define EN75_PPE_REGS		0xe00
+
+struct en75_ppe *en75_ppe_init(struct device *dev, void __iomem *fe);
+void en75_ppe_deinit(struct en75_ppe *ppe);
+/* RX: CPU reason and table index from the descriptor of a frame that came through the engine, the frame and the offset of its EtherType (behind the MediaTek tag); binds the matching offloaded flow. Called in NAPI context. */
+void en75_ppe_check_skb(struct en75_ppe *ppe, struct sk_buff *skb,
+			unsigned int proto_off, u8 crsn, u16 index);
+/* ndo_setup_tc of the netdev whose GDM forwards to the engine (TC_SETUP_FT, also reached through DSA user ports). */
+int en75_ppe_setup_tc(struct en75_ppe *ppe, struct net_device *dev,
+		      enum tc_setup_type type, void *type_data);
+int en75_ppe_debugfs_show(struct seq_file *m, struct en75_ppe *ppe);
+
+#endif
