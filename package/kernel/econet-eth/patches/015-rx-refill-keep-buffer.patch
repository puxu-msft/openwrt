+/* 申请一块收包缓冲填进 @e（收包 NAPI 里 GFP_ATOMIC；建环时可以睡着申请）；失败时不改 @e。 */
+static bool en75_rx_ent_alloc(struct en75_q_rx *q, struct en75_q_rx_ent *e,
+			      gfp_t gfp)
 {
-	u32 ndesc = q->ndesc;
-	u32 cpu_i = (q->cpu_i + 1) % ndesc;
+	struct page *page;
+	unsigned int offset;
 
-	for (; cpu_i != end_i; cpu_i = (cpu_i + 1) % ndesc) {
-		struct en75_q_rx_ent *e = &q->entry[cpu_i];
-		struct desc *pdesc = &q->desc[cpu_i];
-		struct page *page;
-		int offset;
