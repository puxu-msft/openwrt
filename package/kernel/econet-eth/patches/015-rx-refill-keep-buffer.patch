+/*
+ * 建环（probe 时）给每一项申请缓冲并挂进描述符。此后每一项在收包处理时当场换上新缓冲或挂回原缓冲
+ * （en75_qdma_rx_process_one），环里任何时候都没有空项，处理到哪一项就交还到哪一项。
+ */
+static int en75_fill_rx_queue(struct en75_q_rx *q)
+{
+	for (u32 i = 0; i < q->ndesc; i++) {
+		if (!en75_rx_ent_alloc(q, &q->entry[i], GFP_KERNEL))
+			return -ENOMEM;
+		en75_rx_desc_arm(q, i);
 	}
-
-	cpu_i = (cpu_i - 1) % ndesc;
-
-	q->cpu_i = cpu_i;
-	en75_wreg(cpu_i, &q->qchain_regs->rx_cpui);
+	return 0;
 }
 
 /* The CHECKSUM_UNNECESSARY rule of the vendor eth_rx, bit for bit (eth.ko 0x11a4..0x11dc, 0x1410..0x1420): IP4 or IP6 set, L4VLD set, L4F and IP4F clear, source port not 0 or 5 (the CPU ports). Whether the GDM sets L4VLD on frames whose TCP/UDP checksum it cannot have checked (another IP protocol, an IPv4 fragment) is not verified; debugfs rx_csum counts such frames among those marked. Without stag_en the GDM does not report IP4/IP6 for frames behind the MediaTek tag (seen on GS2107), so none is marked. */
@@ -221,42 +233,53 @@ static bool en75_erx_l4_csum_ok(struct qdma_desc_erx *erx)
 	       (w & (ERX_IP4F | ERX_L4VLD | ERX_L4F)) == ERX_L4VLD;
 }
 
+/*
+ * 处理第 cpu_i 项收到的帧，并当场给这一项换好缓冲（交还硬件由 en75_qdma_rx_process 统一写 rx_cpui）。
+ * 照原厂 qdma_bm_receive_packets：先拿新缓冲，拿不到就丢这一帧、把原缓冲挂回去，记 rxAllocFailDropErrs（GPL
+ * qdma_bmgr.i:61237-61242，“Revert received packet as new skb”）；带 drop 位的帧原厂同样丢掉并复用原缓冲
+ * （:61226-61234）。长度为 0（原厂记 rxDscpIncorrect 后就停止处理，:61217-61221）、超出缓冲、NLS 的帧原厂没有
+ * 对应的复用，这里一样丢掉并复用原缓冲。这样一项处理完总是带着缓冲交还，不会出现“处理过、却没换上缓冲”的项。
+ */
 static void en75_qdma_rx_process_one(struct en75_q_rx *q, u32 cpu_i,
 				     enum dma_data_direction dir)
 {
 	struct en75_q_rx_ent *e = &q->entry[cpu_i];
+	void *buf = e->buf;
+	dma_addr_t dma_addr = e->dma_addr;
+	u16 dma_len = e->dma_len;
+	struct en75_q_rx_ent fresh;
 	struct sk_buff *skb;
-	struct page *page;
 	struct desc desc;
-	u16 dma_len = e->dma_len;
 	u8 sport;
 	int len;
 
