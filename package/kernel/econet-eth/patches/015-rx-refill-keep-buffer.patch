+/* 把收包项 @i 的缓冲交给硬件：描述符写成空的、长度为缓冲长度。交还由调用方写 rx_cpui。 */
+static void en75_rx_desc_arm(struct en75_q_rx *q, u32 i)
+{
+	struct en75_q_rx_ent *e = &q->entry[i];
+	struct desc *pdesc = &q->desc[i];
+	int j;
+
