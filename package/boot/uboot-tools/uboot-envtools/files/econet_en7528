[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
chinamobile,gs2107)
	ubootenv_add_mtd "uboot_env" "0x0" "0x20000" "0x20000"
	ubootenv_add_mtd "uboot_env" "0x20000" "0x20000" "0x20000"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0
